<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Taadol.Controls">

    <!-- ═══ استایل متن ستون‌های گرید (مشترک در همه فرم‌های لیست) ═══ -->
    <Style x:Key="BaseTextColumnStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource IRANSans}" />
        <Setter Property="controls:NumberFontBehavior.Apply"
                Value="True" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="#374151" />
    </Style>

    <Style x:Key="LtrTextColumnStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextColumnStyle}">
        <Setter Property="FlowDirection"
                Value="LeftToRight" />
    </Style>

    <!-- استایل ستون‌های عددی: اعداد با وزیر -->
    <Style x:Key="NumberColumnStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextColumnStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Vazir}" />
    </Style>

    <Style x:Key="LtrNumberColumnStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource NumberColumnStyle}">
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <Style x:Key="RowNumberColumnStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextColumnStyle}">
        <Setter Property="Foreground"
                Value="#9CA3AF" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style x:Key="FullNameColumnStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextColumnStyle}">
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="FontWeight"
                Value="Medium" />
        <Setter Property="Foreground"
                Value="#1F2937" />
    </Style>

    <!-- ═══ استایل‌های هدر/سلول/ردیف گرید مشترک (UnifiedListView) ═══ -->

    <Style x:Key="UnifiedGridColumnHeaderStyle"
           TargetType="DataGridColumnHeader">
        <Setter Property="Background"
                Value="#FFFFFF" />
        <Setter Property="Foreground"
                Value="#1F2937" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="FontFamily"
                Value="{StaticResource IRANSans}" />
        <Setter Property="Padding"
                Value="8,0" />
        <Setter Property="BorderBrush"
                Value="#E5E7EB" />
        <Setter Property="BorderThickness"
                Value="0,0,1,2" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Height"
                Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UnifiedGridCellStyle"
           TargetType="DataGridCell">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="#374151" />
        <Setter Property="FontSize"
                Value="13" />
        <!-- جداکننده عمودی ستون‌ها: فقط روی ردیف‌های پر (ردیف‌های خالی خط ندارند) -->
        <Setter Property="BorderBrush"
                Value="#E5E7EB" />
        <Setter Property="BorderThickness"
                Value="0,0,1,0" />
        <Setter Property="Padding"
                Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected"
                     Value="True">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Foreground"
                        Value="#1F2937" />
            </Trigger>

            <!-- ردیف‌های خالی (پرکننده صفحه) خط عمودی ندارند -->
            <DataTrigger Binding="{Binding IsEmpty}"
                         Value="True">
                <Setter Property="BorderThickness"
                        Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UnifiedGridRowStyle"
           TargetType="DataGridRow">
        <Setter Property="Background"
                Value="White" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex"
                     Value="1">
                <Setter Property="Background"
                        Value="#F8F8F8" />
            </Trigger>

            <Trigger Property="IsMouseOver"
                     Value="True">
                <Setter Property="Background"
                        Value="#EFF6FF" />
            </Trigger>

            <DataTrigger Binding="{Binding IsEmpty}"
                         Value="True">
                <Setter Property="Height"
                        Value="0" />
                <Setter Property="Visibility"
                        Value="Collapsed" />
            </DataTrigger>

            <DataTrigger Binding="{Binding RowBackground}"
                         Value="#FCEBEC">
                <Setter Property="Background"
                        Value="#FCEBEC" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
