<UserControl x:Class="Taadol.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="Transparent">

    <Border x:Name="RootBorder"
            Background="#FFFFFF"
            CornerRadius="8"
            BorderBrush="#E5E7EB"
            BorderThickness="0"
            ClipToBounds="True"
            Margin="8"
            Padding="0">

        <Grid    Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="20,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="16"
                                            Height="16"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>
                        <TextBlock Text="لیست کالاها"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Click="BtnDelete_Click" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnRefresh_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:UnifiedListView x:Name="ProductsGrid"
                                       Grid.Row="1"
                                       Padding="0,0,10,0"
                                       ItemsSource="{Binding FilteredProducts}"
                                       PagesSource="{Binding Pages}"
                                       PageInfoContent="{Binding PageInfoText}"
                                       IsLoading="{Binding IsLoading}"
                                       LoadErrorText="{Binding LoadErrorText}"
                                       ShowCheckBox="True"
                                       ShowRowNumber="True"
                                       ShowEmptyState="True"
                                       EmptyStateText="کالایی یافت نشد"
                                       EmptyStateHintText="برای افزودن کالا روی دکمه افزودن کلیک کنید">

                <controls:UnifiedListView.Columns>

                    <DataGridTextColumn Header="کد کالا"
                                        Width="100"
                                        Binding="{Binding ProductCode}"
                                        ElementStyle="{StaticResource BaseTextColumnStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="نام کالا"
                                        Width="*"
                                        Binding="{Binding ProductName}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource BaseTextColumnStyle}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="دسته‌بندی"
                                        Width="110"
                                        Binding="{Binding Category}"
                                        ElementStyle="{StaticResource BaseTextColumnStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="برند"
                                        Width="100"
                                        Binding="{Binding Brand}"
                                        ElementStyle="{StaticResource BaseTextColumnStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="بارکد"
                                        Width="120"
                                        Binding="{Binding Barcode}"
                                        ElementStyle="{StaticResource LtrTextColumnStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="قیمت فروش"
                                        Width="130"
                                        Binding="{Binding SalePriceDisplay}"
                                        ElementStyle="{StaticResource LtrTextColumnStyle}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="80"
                                            MinWidth="65">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="وضعیت"
                                           FontFamily="{StaticResource IRANSans}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,4"
                                        CornerRadius="6"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding StatusVisibility}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                    <Setter Property="Background" Value="#E5E7EC" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               FontFamily="{StaticResource IRANSans}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                        <Setter Property="Foreground" Value="#66718E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                        <Setter Property="Foreground" Value="#166534" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </controls:UnifiedListView.Columns>
            </controls:UnifiedListView>
        </Grid>
    </Border>
</UserControl>
