<UserControl x:Class="Taadol.Views.NewProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="Transparent"
             PreviewKeyDown="View_PreviewKeyDown"
             Unloaded="View_Unloaded">

    <UserControl.Resources>

        <Style x:Key="FormLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource FormLabel}">
            <Setter Property="FontSize"
                    Value="16" />
        </Style>

        <Style x:Key="DeleteRowButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="36" />
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{StaticResource DangerLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="White" CornerRadius="4" MinWidth="900"
        SizeChanged="RootBorder_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Cursor="Hand"
                            Background="Transparent"
                            Margin="10,0,10,0"
                            MouseLeftButtonDown="CloseButton_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="14"
                                        Height="14"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="کالای جدید"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="#0D2159"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" Margin="7,0,7,2" VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile" Viewport="0,0,10,1" ViewportUnits="Absolute" Viewbox="0,0,10,1" ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10" Height="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="5" /></Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#D4E0FF" /><Rectangle Grid.Column="1" Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0" Margin="0,0,24,0" HorizontalAlignment="Stretch">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,0,8"
                                           Style="{StaticResource FormLabel}">
                                    <Run Text="کد کالا (SKU)" /><Run Text=" *" Foreground="{DynamicResource DangerBrush}" />
                                </TextBlock>
                                <controls:ToggleSwitch2Control x:Name="CodeModeToggle"
                                                               Grid.Column="1"
                                                               HorizontalAlignment="Right"
                                                               Margin="16,0,0,5"
                                                               FirstLabel="خودکار"
                                                               SecondLabel="دستی"
                                                               IsFirstSelected="True"
                                                               SelectionChanged="CodeModeToggle_SelectionChanged" />
                            </Grid>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Margin="0,0,0,8"
                                       Style="{StaticResource FormLabel}">
                                <Run Text="نام کالا" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>

                            <controls:ModernPersianTextBox Grid.Row="1" Grid.Column="0"
                                                           x:Name="TxtSku"
                                                           VerticalAlignment="Top"
                                                           Text="{Binding Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="PRD-0001" FlowDirection="LeftToRight"
                                                           MaxLength="20"
                                                           />
                            <controls:ModernPersianTextBox Grid.Row="1" Grid.Column="2"
                                                           VerticalAlignment="Top"
                                                           Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           MaxLength="200"
                                                           Placeholder="نام کالا را وارد کنید"
                                                           />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Margin="0,0,0,8"
                                       Style="{StaticResource FormLabel}">
                                <Run Text="دسته کالا" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <ComboBox x:Name="CategoryComboBox"
                                      Grid.Row="1" Grid.Column="0"
                                      Style="{StaticResource SearchableComboBox}"
                                      ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding CategoryId, Mode=TwoWay}"
                                      SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                      Tag="انتخاب دسته‌بندی..."
                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                      />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Margin="0,0,0,8"
                                       Style="{StaticResource FormLabel}">
                                <Run Text="برند" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <ComboBox x:Name="BrandComboBox"
                                      Grid.Row="1" Grid.Column="2"
                                      Style="{StaticResource SearchableComboBox}"
                                      ItemsSource="{Binding Brands}"
                                      SelectedValue="{Binding BrandId, Mode=TwoWay}"
                                      SelectedValuePath="Id" DisplayMemberPath="Name"
                                      Tag="انتخاب برند..."
                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                      />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="وضعیت کالا"
                                       Style="{StaticResource FormLabel}"
                                       Margin="0,8,0,0" />
                            <Rectangle Width="0.6" Height="27" Fill="#BED1FF" Margin="0,0,9,0"
                                       VerticalAlignment="Center" />
                            <controls:ActiveToggleControl x:Name="IsActiveToggle"
                                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                          Label="کالا فعال است"
                                                          Margin="9,0,0,0"
                                                          />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                        <controls:ImagePickerControl x:Name="ProductImagePicker"
                                                     FlowDirection="LeftToRight"
                                                     PlaceholderIconSource="/Assets/Icons/box-add.svg"
                                                     AddLabel="انتخاب"
                                                     RemoveLabel="حذف"
                                                     ImagePath="{Binding ProductImage, Mode=TwoWay}"
                                                     ImageSelected="OnImageSelected"
                                                     ImageRemoved="OnImageRemoved" />
                        <TextBlock Text="برای بارگذاری کلیک کنید"
                                   FontSize="11"
                                   Foreground="#AFAFAF"
                                   FontFamily="{StaticResource IRANSans}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,2,0,2">
                <Border Height="3" Margin="12,0,12,2">
                    <Border.Background>
                        <VisualBrush TileMode="Tile" Viewport="0,0,10,1" ViewportUnits="Absolute" Viewbox="0,0,10,1" ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10" Height="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="5" /></Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1" Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>

                <Ellipse x:Name="DividerEllipseLeft"
                         Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#66000000"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse x:Name="DividerEllipseRight"
                         Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#66000000"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <StackPanel Grid.Row="3" Margin="12,0,0,0" HorizontalAlignment="Left">
                <Border CornerRadius="0" BorderThickness="0,0,0,2" BorderBrush="#E5E7EB"
                        Background="#ffffff" Padding="0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="مشخصات تکمیلی"
                                     Style="{StaticResource ModernTabButton}" Margin="10,0,6,0"
                                     IsChecked="True" x:Name="TabInfo"
                                     GroupName="ProductTabs"
                                     Checked="TabInfo_Checked" />
                        <RadioButton Content="تنوع‌ها"
                                     Style="{StaticResource ModernTabButton}" Margin="10,0,6,0"
                                     x:Name="TabVariants"
                                     GroupName="ProductTabs"
                                     Checked="TabVariants_Checked" />
                        <RadioButton Content="قیمت‌گذاری"
                                     Style="{StaticResource ModernTabButton}" Margin="10,0,6,0"
                                     x:Name="TabPricing"
                                     GroupName="ProductTabs"
                                     Checked="TabPricing_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="4"
                          IsEnabled="{Binding IsFormInteractive}"
                          Style="{StaticResource MinimalScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardPanel}" Margin="12,0,12,0">
                    <StackPanel>

                        <StackPanel x:Name="InfoContent" Visibility="Visible">

                            <Grid Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="جنس" Style="{StaticResource FormLabel}" />
                                    <ComboBox Style="{StaticResource SearchableComboBox}"
                                              ItemsSource="{Binding Materials}"
                                              SelectedValue="{Binding MaterialId, Mode=TwoWay}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name"
                                              Tag="انتخاب جنس..."
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="جنسیت" Style="{StaticResource FormLabel}" />
                                    <ComboBox Style="{StaticResource SearchableComboBox}"
                                              ItemsSource="{Binding GenderOptions}"
                                              SelectedItem="{Binding Gender, Mode=TwoWay}"
                                              Tag="انتخاب جنسیت..."
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabel}">
                                        <Run Text="واحد شمارش" /><Run Text=" *" Foreground="#DC2626" />
                                    </TextBlock>
                                    <ComboBox Style="{StaticResource SearchableComboBox}"
                                              ItemsSource="{Binding Units}"
                                              SelectedValue="{Binding UnitId, Mode=TwoWay}"
                                              SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                              Tag="انتخاب واحد..."
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="فصل" Style="{StaticResource FormLabel}" />
                                    <ComboBox Style="{StaticResource SearchableComboBox}"
                                              ItemsSource="{Binding SeasonOptions}"
                                              SelectedItem="{Binding Season, Mode=TwoWay}"
                                              Tag="انتخاب فصل..."
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="توضیحات" Style="{StaticResource FormLabel}" />
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="90" MaxHeight="120"
                                                 Padding="8"
                                                 BorderThickness="0"
                                                 FontFamily="{StaticResource IRANSans}" FontSize="14"
                                                 />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="VariantsContent" Visibility="Collapsed">
                            <TextBlock Text="تنوع = ترکیب رنگ و سایز یک محصول. هر تنوع کد داخلی، بارکد و قیمت خودش را دارد."
                                       FontSize="13" Foreground="#6B7280" Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="رنگ" Style="{StaticResource FormLabel}" Margin="0,8,0,0" />
                                <TextBlock Grid.Column="1" Text="سایز" Style="{StaticResource FormLabel}" Margin="0,8,0,0" />
                                <TextBlock Grid.Column="2" Text="کد داخلی" Style="{StaticResource FormLabel}" Margin="0,8,0,0" />
                                <TextBlock Grid.Column="3" Text="بارکد" Style="{StaticResource FormLabel}" Margin="0,8,0,0" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Variants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Style="{StaticResource SearchableComboBox}"
                                                      ItemsSource="{Binding DataContext.Colors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding ColorId, Mode=TwoWay}"
                                                      SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      Tag="رنگ..."
                                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                                      Margin="0,0,8,0"
                                                      />
                                            <ComboBox Grid.Column="1" Style="{StaticResource SearchableComboBox}"
                                                      ItemsSource="{Binding DataContext.Sizes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding SizeId, Mode=TwoWay}"
                                                      SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      Tag="سایز..."
                                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                                      Margin="0,0,8,0"
                                                      />
                                            <controls:ModernPersianTextBox Grid.Column="2"
                                               Text="{Binding Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Placeholder="کد داخلی" FlowDirection="LeftToRight"
                                               Margin="0,0,8,0"
                                               />
                                            <controls:ModernPersianTextBox Grid.Column="3"
                                                                           Text="{Binding Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           Placeholder="بارکد" FlowDirection="LeftToRight"
                                                                           Margin="0,0,8,0"
                                                                           />
                                            <Button Grid.Column="4"
                                                    Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DeleteRowButton}"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="حذف تنوع">
                                                <svg:SvgViewbox Width="14" Height="14" Source="/Assets/Icons/trash.svg" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:IconButton Grid.Column="0"
                                                     ButtonText="افزودن تنوع"
                                                     IconSource="/Assets/Icons/plus_LINE.svg"
                                                     ButtonCommand="{Binding AddVariantCommand}"
                                                     ButtonHeight="40" ButtonWidth="140"
                                                     CornerRadius="4" TextSize="14"
                                                     Margin="0,0,8,0" />
                                <controls:IconButton Grid.Column="1"
                                                     ButtonText="تولید خودکار کدها"
                                                     IconSource="/Assets/Icons/CHECK_w.svg"
                                                     ButtonCommand="{Binding GenerateAllVariantCodesCommand}"
                                                     ButtonHeight="40" ButtonWidth="140"
                                                     CornerRadius="4" TextSize="14"
                                                     Margin="0,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="PricingContent" Visibility="Collapsed">
                            <TextBlock Text="قیمت‌ها به هر تنوع وصل است نه به محصول. هر تنوع می‌تواند چند قیمت با تاریخ اعتبار متفاوت داشته باشد."
                                       FontSize="13" Foreground="#6B7280" Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

<ItemsControl ItemsSource="{Binding PriceRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="16" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="تنوع" Style="{StaticResource FormLabel}" />
                                                        <ComboBox Style="{StaticResource SearchableComboBox}"
                                                                  ItemsSource="{Binding DataContext.Variants, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                                                                  SelectedValuePath="Id"
                                                                  DisplayMemberPath="DisplayText"
                                                                  Tag="انتخاب تنوع..."
                                                                  ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                                                  />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                        <TextBlock Text="قیمت خرید (ریال)" Style="{StaticResource FormLabel}" />

                                                        <Grid FlowDirection="RightToLeft">
                                                            <controls:ModernPersianTextBox
                                                                Text="{Binding PurchasePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Placeholder="0"
                                                                InputType="Number"
                                                                />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="قیمت فروش (ریال)" Style="{StaticResource FormLabel}" />
                                                        <Grid FlowDirection="LeftToRight">
                                                            <controls:ModernPersianTextBox
                                                                Text="{Binding SalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Placeholder="0"
                                                                InputType="Number"
                                                                />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                               Text="از تاریخ"
                                                               Style="{StaticResource FormLabel}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                               Text="تا تاریخ"
                                                               Style="{StaticResource FormLabel}" />

                                                    <controls:PersianDatePickerControl Grid.Row="1" Grid.Column="0"
                                                        VerticalAlignment="Top"
                                                        Margin="0,0,8,0"
                                                        PersianDateString="{Binding FromDate, Mode=TwoWay}"
                                                        />
                                                    <controls:PersianDatePickerControl Grid.Row="1" Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        Margin="0,0,8,0"
                                                        PersianDateString="{Binding ToDate, Mode=TwoWay}"
                                                        />
                                                    <Button Grid.Row="1" Grid.Column="4"
                                                            Command="{Binding DataContext.RemovePriceRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DeleteRowButton}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            ToolTip="حذف ردیف قیمت">
                                                        <svg:SvgViewbox Width="14" Height="14" Source="/Assets/Icons/trash.svg" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:IconButton ButtonText="افزودن قیمت"
                                                 IconSource="/Assets/Icons/plus_LINE.svg"
                                                 ButtonCommand="{Binding AddPriceRowCommand}"
                                                 ButtonHeight="40" ButtonWidth="140"
                                                 CornerRadius="4" TextSize="14"
                                                 Margin="0,16,0,0"
                                                 HorizontalAlignment="Left" />
                        </StackPanel>

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="5"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".40*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".30*" />
                    </Grid.ColumnDefinitions>

                    <controls:IconButton Grid.Column="0"
                                         x:Name="SaveButton"
                                         ButtonText="ذخیره کالا"
                                         IconSource="/Assets/Icons/save.svg"
                                         ButtonCommand="{Binding SaveCommand}"
                                         ButtonBackground="#2667FF"
                                         CornerRadius="4" />

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                            Width="14"
                                            Height="14"
                                            FlowDirection="LeftToRight"
                                            Margin="6,0,15,0" />
                            <TextBlock Text="انصراف"
                                       FontFamily="{StaticResource IRANSans}"
                                       FontSize="14"
                                       Foreground="#2667FF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <controls:CustomOutlinedButton Grid.Column="2"
                                                   Text="ذخیره موقت"
                                                   HorizontalAlignment="Stretch"
                                                   BorderBrush="#2667FF"
                                                   Foreground="#2667FF">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/Black.svg"
                                            Width="16"
                                            Height="16" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="20"
                    Background="#66FFFFFF">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="6" IsIndeterminate="True" Foreground="#2667FF" />
                    <TextBlock Text="در حال ذخیره..." Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="#0D2159" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>