<UserControl x:Class="Taadol.Views.ProductListView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              xmlns:controls="clr-namespace:Taadol.Controls"
              d:DesignHeight="650"
              d:DesignWidth="1440"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              FlowDirection="RightToLeft"
              FontFamily="{StaticResource IRANSans}"
              Background="#FFFFFF">

<UserControl.Resources>
    </UserControl.Resources>

    <Border Background="White"
            CornerRadius="12"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="20,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="16"
                                            Height="16"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>
                        <TextBlock x:Name="HeaderTitle"
                                   Text="کالاها و خدمات"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Click="BtnDelete_Click" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click"
                                               Loaded="ActionButton_Loaded" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"
                                               
                                               Click="BtnRefresh_Click"
                                               Loaded="ActionButton_Loaded_1" />

                        <!-- X بستن -->
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="6"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                           
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Border Grid.Row="1"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,0"
                    Background="#ffffff"
                    Padding="15,6,10,6"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"
                                          MinWidth="120" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                    </Grid.ColumnDefinitions>

                    <!-- جستجو -->
                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,4,0"
                            Height="40"
                            Padding="5,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Height="30">
                                <TextBlock Text="جستجو در نام ، کد"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontFamily="{StaticResource IRANSans}"
                                           FlowDirection="RightToLeft"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Panel.ZIndex="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ProductSearchBox}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="ProductSearchBox"
                                         Height="30"
                                         FontSize="12"
                                         Foreground="#1F2937"
                                         CaretBrush="#3B82F6"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0,2"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         FlowDirection="RightToLeft"
                                         FontFamily="{StaticResource IRANSans}"
                                         TextAlignment="Left">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="1"
                                        Height="14"
                                        Background="#BED1FF"
                                        VerticalAlignment="Center" />
                                <svg:SvgViewbox Width="14"
                                                Height="14"
                                                FlowDirection="LeftToRight"
                                                Source="/Assets/Icons/search.svg"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- تب‌های نوع -->
                    <ToggleButton x:Name="tabAllTypes"
                                  Grid.Column="1"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="همه"
                                  Tag="۹۰"
                                  IsChecked="True"
                                  HorizontalAlignment="Stretch"
                                  Click="TypeTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabProducts"
                                  Grid.Column="2"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="کالاها"
                                  Tag="۶۸"
                                  HorizontalAlignment="Stretch"
                                  Click="TypeTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabServices"
                                  Grid.Column="3"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="خدمات"
                                  Tag="۲۲"
                                  HorizontalAlignment="Stretch"
                                  Click="TypeTab_Click"
                                  Margin="4,0,0,0" />
                </Grid>
            </Border>

            
            <Border Grid.Row="2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Background="#FAFCFF"
                    Padding="15,8">
                <StackPanel Orientation="Horizontal"
                            FlowDirection="RightToLeft"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="tabAll"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="همه"
                                  IsChecked="True"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,8,0" />

                    <ToggleButton x:Name="tabActive"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="فعال"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,8,0" />

                    <ToggleButton x:Name="tabInactive"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="غیرفعال"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,8,0" />
                </StackPanel>
            </Border>

            
            <Border Grid.Row="3"
                    Background="Transparent"
                    ClipToBounds="False"
                    Padding="15,0">

                <Grid x:Name="DataGridContainer">
                    <Grid.Resources>
                        <Style x:Key="BaseTextColumnStyle"
                               TargetType="TextBlock">
                            <Setter Property="FontFamily"
                                    Value="{StaticResource IRANSans}" />
                            <Setter Property="HorizontalAlignment"
                                    Value="Center" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                            <Setter Property="Foreground"
                                    Value="#5C5C5C" />
                        </Style>

                        <Style x:Key="LtrTextColumnStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource BaseTextColumnStyle}">
                            <Setter Property="FlowDirection"
                                    Value="LeftToRight" />
                        </Style>

                        <Style x:Key="RowNumberColumnStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource BaseTextColumnStyle}">
                            <Setter Property="Foreground"
                                    Value="#94A3B8" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Style>

                        <Style x:Key="ProductNameColumnStyle"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource BaseTextColumnStyle}">
                            <Setter Property="Foreground"
                                    Value="#5C5C5C" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Style>
                    </Grid.Resources>

                    <DataGrid x:Name="ProductsDataGrid"
                               Padding="0,0,10,0"
                               CanUserSortColumns="False"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              VerticalGridLinesBrush="#CCD0D9"
                              HorizontalGridLinesBrush="#CCD0D9"
                              RowHeight="30"
                              Background="White"
                              BorderBrush="#CCD0D9"
                              BorderThickness="1"
                              SnapsToDevicePixels="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              AlternationCount="2"
                              IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              FontFamily="{StaticResource IRANSans}"
                              SelectionChanged="ProductsDataGrid_SelectionChanged">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Tag"
                                        Value="True" />
                                <Setter Property="Background"
                                        Value="#E9F0FF" />
                                <Setter Property="Foreground"
                                        Value="#0D2159" />
                                <Setter Property="FontSize"
                                        Value="12.5" />
                                <Setter Property="FontWeight"
                                        Value="Bold" />
                                <Setter Property="FontFamily"
                                        Value="{StaticResource IRANSans}" />
                                <Setter Property="Padding"
                                        Value="10,0" />
                                <Setter Property="BorderBrush"
                                        Value="#BED1FF" />
                                <Setter Property="BorderThickness"
                                        Value="1,2,1,2" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center" />
                                <Setter Property="Height"
                                        Value="46" />

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ContentPresenter Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center" />

                                                    <svg:SvgViewbox x:Name="FilterIcon"
                                                                    Width="13"
                                                                    Height="13"
                                                                    Grid.Column="1"
                                                                    Source="/Assets/Icons/filter-search.svg"
                                                                    VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Tag"
                                                         Value="False">
                                                    <Setter TargetName="FilterIcon"
                                                            Property="Visibility"
                                                            Value="Collapsed" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Foreground"
                                        Value="#5C5C5C" />
                                <Setter Property="FontSize"
                                        Value="12.5" />
                                <Setter Property="BorderThickness"
                                        Value="0" />
                                <Setter Property="Padding"
                                        Value="8,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E8F2FF" />
                                        <Setter Property="Foreground"
                                                Value="#2667FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="#FFFFFF" />
                                <Setter Property="Cursor"
                                        Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex"
                                             Value="1">
                                        <Setter Property="Background"
                                                Value="#E5E7EC" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#F0F5FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#E8F2FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Width="50"
                                                Binding="{Binding RowNumberDisplay}"
                                                ElementStyle="{StaticResource RowNumberColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Tag"
                                                Value="False" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="کد"
                                                Width="85"
                                                Binding="{Binding Code}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}" />

                            <DataGridTextColumn Header="دسته بندی"
                                                Width="110"
                                                Binding="{Binding Category}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}" />

                            <DataGridTextColumn Header="نام"
                                                Width="140"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ProductNameColumnStyle}" />

                            <DataGridTextColumn Header="بارکد"
                                                Width="100"
                                                Binding="{Binding Barcode}"
                                                ElementStyle="{StaticResource LtrTextColumnStyle}" />

                            <DataGridTextColumn Header="کد محصول"
                                                Width="120"
                                                Binding="{Binding Code}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}" />

                            <DataGridTextColumn Header="واحد"
                                                Width="80"
                                                Binding="{Binding Unit}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}" />

                            <DataGridTextColumn Header="تعداد"
                                                Width="80"
                                                Binding="{Binding Quantity}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}" />

                            <DataGridTemplateColumn Header="وضعیت"
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3"
                                                CornerRadius="5"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding StatusVisibility}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="غیرفعال">
                                                            <Setter Property="Background"
                                                                    Value="#FEE2E2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                     Value="فعال">
                                                            <Setter Property="Background"
                                                                    Value="#DCFCE7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       FontFamily="{StaticResource IRANSans}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="غیرفعال">
                                                                <Setter Property="Foreground"
                                                                        Value="#991B1B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="فعال">
                                                                <Setter Property="Foreground"
                                                                        Value="#166534" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="توضیحات"
                                                Width="250"
                                                Binding="{Binding Description}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}" />

                            <DataGridTextColumn Header="قیمت خرید"
                                                Width="140"
                                                Binding="{Binding PurchasePriceFormatted}"
                                                ElementStyle="{StaticResource LtrTextColumnStyle}" />

                            <DataGridTextColumn Header="قیمت فروش"
                                                Width="140"
                                                Binding="{Binding SalePriceFormatted}"
                                                ElementStyle="{StaticResource LtrTextColumnStyle}" />

                            <DataGridTextColumn Header="مالیات"
                                                Width="120"
                                                Binding="{Binding TaxFormatted}"
                                                ElementStyle="{StaticResource LtrTextColumnStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            
            <Border Grid.Row="4"
                    Padding="5,14"
                    Background="White"
                    BorderBrush="#E9F0FF"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <Button Width="34"
                                Height="34"
                                Margin="0,0,2,0"
                                Cursor="Hand"
                                Click="BtnPrevPage_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Width="30"
                                            Height="30"
                                            Background="Transparent">
                                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                                        Width="30"
                                                        Height="30"
                                                        Source="/Assets/Icons/Leftsquare.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F0F5FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="BtnPage_Click"
                                Tag="10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <TextBlock Text="۱۰"
                                                   FontSize="13"
                                                   Foreground="#94A3B8"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="28"
                                Height="32">
                            <TextBlock Text="..."
                                       FontSize="14"
                                       Foreground="#94A3B8"
                                       FontFamily="{StaticResource IRANSans}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Button Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="BtnPage_Click"
                                Tag="5">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <TextBlock Text="۵"
                                                   FontSize="13"
                                                   Foreground="#94A3B8"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="BtnPage_Click"
                                Tag="4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <TextBlock Text="۴"
                                                   FontSize="13"
                                                   Foreground="#94A3B8"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="BtnPage_Click"
                                Tag="3">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <TextBlock Text="۳"
                                                   FontSize="13"
                                                   Foreground="#94A3B8"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="BtnPage_Click"
                                Tag="2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <TextBlock Text="۲"
                                                   FontSize="13"
                                                   Foreground="#94A3B8"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="BtnPage_Click"
                                Tag="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <TextBlock Text="۱"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#001242"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="34"
                                Height="34"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="BtnNextPage_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Width="30"
                                            Height="30"
                                            Background="Transparent">
                                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                                        Width="30"
                                                        Height="30"
                                                        Source="/Assets/Icons/Rightsquare.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F0F5FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
