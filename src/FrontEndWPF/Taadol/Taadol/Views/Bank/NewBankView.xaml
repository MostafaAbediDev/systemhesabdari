<UserControl x:Class="Taadol.Views.Bank.NewBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="Transparent"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">
    <Border Background="White" CornerRadius="4" ClipToBounds="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Cursor="Hand" Background="Transparent" Margin="10,0,10,0" MouseLeftButtonDown="HeaderClose_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight" Width="14" Height="14" Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="مشخصات بانک جدید" FontSize="20" FontWeight="Bold" Foreground="#0D2159" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" Margin="7,0,7,2" VerticalAlignment="Bottom" Background="#D4E0FF" />

            <ScrollViewer Grid.Row="2" Style="{StaticResource MinimalScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardPanel}" Margin="15,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <controls:ImagePickerControl PlaceholderIconSource="/Assets/Icons/dollar-circle_u.svg" AddLabel="افزودن" RemoveLabel="حذف" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="نام بانک" Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Placeholder="نام بانک" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="شناسه یکتا" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <controls:ToggleSwitch2Control FirstLabel="اتوماتیک" SecondLabel="دستی" IsFirstSelected="True" />
                                <controls:ModernPersianTextBox Width="150" Margin="12,0,0,0" InputType="Number" FlowDirection="LeftToRight" Placeholder="۱۲۳۴" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="نوع بانک" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Content="دولتی" Command="{Binding SelectBankTypeCommand}" CommandParameter="{Binding BankTypes[0]}" Style="{StaticResource FilterTabStyle2}" Margin="0,0,8,0" />
                                <Button Content="خصوصی" Command="{Binding SelectBankTypeCommand}" CommandParameter="{Binding BankTypes[1]}" Style="{StaticResource FilterTabStyle2}" Margin="0,0,8,0" />
                                <Button Content="خارجی" Command="{Binding SelectBankTypeCommand}" CommandParameter="{Binding BankTypes[2]}" Style="{StaticResource FilterTabStyle2}" Margin="0,0,8,0" />
                                <CheckBox Content="بانک فعال است" IsChecked="True" Foreground="#16A34A" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="کشور" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource SearchableComboBox}" ItemsSource="{Binding Countries}" SelectedItem="{Binding Country, Mode=TwoWay}" Tag="انتخاب کشور" ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="توضیحات" Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Placeholder="بنویسید" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="White">
                <Grid Margin="16,10" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".3*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconButton Grid.Column="0" ButtonText="ثبت" IconSource="/Assets/Icons/save.svg" ButtonCommand="{Binding SaveCommand}" ButtonBackground="#2667FF" CornerRadius="4" />
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0,0,20,0" Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgViewbox Source="/Assets/Icons/redo.svg" Width="14" Height="14" FlowDirection="LeftToRight" Margin="6,0,15,0" />
                            <TextBlock Text="انصراف" FontSize="14" Foreground="#2667FF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <controls:CustomOutlinedButton Grid.Column="2" Text="ثبت موقت" BorderBrush="#2667FF" Foreground="#2667FF" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
