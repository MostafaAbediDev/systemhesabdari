<UserControl x:Class="Taadol.Views.Bank.BankListView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              xmlns:controls="clr-namespace:Taadol.Controls"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              FlowDirection="RightToLeft"
              Loaded="UserControl_Loaded"
              Padding="0"
              FontFamily="{StaticResource IRANSans}"
              Background="White">

    <Border Background="White"
            CornerRadius="4"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12,15,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="20,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="14"
                                            Height="14"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>
                        <TextBlock Text="لیست بانک‌ها"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Command="{Binding DeleteBankCommand}" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"
                                               Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="#E5E7EB"
                    Background="White"
                    Padding="15,6,25,6"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" MinWidth="120" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                        <ColumnDefinition Width="*" MinWidth="70" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBoxControl x:Name="BankSearchBox"
                                               Grid.Column="0"
                                               Margin="0,0,4,0"
                                               Placeholder="جستجو در نام بانک ، کشور ، نوع بانک" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="Transparent"
                    ClipToBounds="False"
                    Padding="15,0">
                <controls:UnifiedListView x:Name="BanksGrid"
                                          Padding="0,0,10,0"
                                          ItemsSource="{Binding FilteredBanks}"
                                          PagesSource="{Binding Pages}"
                                          PageInfoContent="{Binding PageInfoText}"
                                          IsLoading="{Binding IsLoading}"
                                          LoadErrorText="{Binding LoadErrorText}"
                                          EmptyStateText="بانکی یافت نشد"
                                          EmptyStateHintText="برای ثبت اولین بانک، از دکمه «بانک جدید» استفاده کنید.">
                    <controls:UnifiedListView.Columns>
                        <!-- نام بانک -->
                        <DataGridTextColumn Header="نام بانک" Width="1.6*" MinWidth="160"
                                            Binding="{Binding Title}"
                                            ElementStyle="{StaticResource FullNameColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- کشور با فیلتر ستونی -->
                        <DataGridTemplateColumn Width="1*" MinWidth="100">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="کشور" FontFamily="{StaticResource IRANSans}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" />
                                        <Button Click="CountryFilter_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="8,0,0,0">
                                            <svg:SvgViewbox Width="12" Height="12" Source="/Assets/Icons/Filter.svg" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Country}" Style="{StaticResource BaseTextColumnStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- نوع بانک با فیلتر ستونی و متن ساده -->
                        <DataGridTemplateColumn Width="110" MinWidth="100">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="نوع بانک" FontFamily="{StaticResource IRANSans}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" />
                                        <Button Click="BankTypeFilter_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="8,0,0,0">
                                            <svg:SvgViewbox Width="12" Height="12" Source="/Assets/Icons/Filter.svg" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BankType}" Style="{StaticResource BaseTextColumnStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- تاریخ ثبت -->
                        <DataGridTextColumn Header="تاریخ ثبت" Width="120" MinWidth="110"
                                            Binding="{Binding RegisterDate}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </controls:UnifiedListView.Columns>
                </controls:UnifiedListView>
            </Border>

            <controls:ListSummaryBar x:Name="BankSummaryBar"
                                     Grid.Row="3"
                                     Margin="0,0"
                                     SelectedSummaryText="{Binding SelectedSummaryText}"
                                     TotalCountText="{Binding TotalCountText}" />
        </Grid>
    </Border>
</UserControl>
