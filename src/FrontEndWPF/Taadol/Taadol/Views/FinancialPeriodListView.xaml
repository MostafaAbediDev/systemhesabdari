<UserControl x:Class="Taadol.Views.FinancialPeriodListView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              xmlns:controls="clr-namespace:Taadol.Controls"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              FlowDirection="RightToLeft"
              Padding="0"
              FontFamily="{StaticResource IRANSans}"
              Background="#FFFFFF">

    <Border Background="White"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12,15,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="20,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="14"
                                            Height="14"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>
                        <TextBlock Text="دوره‌های مالی"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Click="BtnDelete_Click" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click"
                                               Loaded="ActionButton_Loaded" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"
                                               
                                               Click="BtnRefresh_Click"
                                               Loaded="ActionButton_Loaded_1" />

                        <!-- X بستن -->
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="6"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                           
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

<Border Grid.Row="1"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,0"
                    Background="#ffffff"
                    Padding="15,6,25,6"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"
                                          MinWidth="120" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                    </Grid.ColumnDefinitions>

<!-- جستجو -->
                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,4,0"
                            Height="40"
                            Padding="5,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Height="30">
                                <TextBlock Text="جستجو در عنوان دوره"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontFamily="{StaticResource IRANSans}"
                                           FlowDirection="RightToLeft"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Panel.ZIndex="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PeriodSearchBox}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="PeriodSearchBox"
                                         Height="30"
                                         FontSize="12"
                                         Foreground="#1F2937"
                                         CaretBrush="#3B82F6"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0,2"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         FlowDirection="RightToLeft"
                                         FontFamily="{StaticResource IRANSans}"
                                         TextAlignment="Left">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="1"
                                        Height="14"
                                        Background="#BED1FF"
                                        VerticalAlignment="Center" />
                                <svg:SvgViewbox Width="14"
                                                Height="14"
                                                FlowDirection="LeftToRight"
                                                Source="/Assets/Icons/search.svg"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- تب‌ها -->
                    <ToggleButton x:Name="tabAll"
                                  Grid.Column="1"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="همه دوره‌ها"
                                  IsChecked="True"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabActive"
                                  Grid.Column="2"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="فعال"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabInactive"
                                  Grid.Column="3"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="غیرفعال"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="Transparent"
                    ClipToBounds="False"
                    Padding="15,0">
                <controls:UnifiedListView x:Name="PeriodsGrid"
                                           Padding="0,0,10,0">
                    <controls:UnifiedListView.Columns>
                        <!-- عنوان دوره -->
                        <DataGridTextColumn Header="عنوان دوره" Width="170" MinWidth="140"
                                            Binding="{Binding Title}"
                                            ElementStyle="{StaticResource FullNameColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="عنوان دوره"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="TitleFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>

                        <!-- سال -->
                        <DataGridTextColumn Header="سال" Width="90" MinWidth="80"
                                            Binding="{Binding Year}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شعبه -->
                        <DataGridTextColumn Header="شعبه" Width="150" MinWidth="130"
                                            Binding="{Binding BranchTitle}"
                                            ElementStyle="{StaticResource FullNameColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شروع -->
                        <DataGridTextColumn Header="تاریخ شروع" Width="110" MinWidth="100"
                                            Binding="{Binding StartDate}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- پایان -->
                        <DataGridTextColumn Header="تاریخ پایان" Width="110" MinWidth="100"
                                            Binding="{Binding EndDate}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- وضعیت -->
                        <DataGridTemplateColumn Header="وضعیت" Width="90" MinWidth="80">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="وضعیت"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="StatusFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="5" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{StaticResource IRANSans}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                            <Setter Property="Foreground" Value="#166534" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </controls:UnifiedListView.Columns>
                </controls:UnifiedListView>
            </Border>

            <controls:ListSummaryBar x:Name="PeriodSummaryBar"
                                     Grid.Row="3"
                                     Margin="15,0" />
        </Grid>
    </Border>
</UserControl>