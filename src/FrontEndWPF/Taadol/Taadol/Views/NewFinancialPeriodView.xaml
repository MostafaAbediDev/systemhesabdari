<UserControl x:Class="Taadol.Views.NewFinancialPeriodView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:Taadol.Controls"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              FlowDirection="RightToLeft"
              VerticalAlignment="Stretch"
              FontFamily="{StaticResource IRANSans}"
              Background="Transparent">

    <Border CornerRadius="12"
            ClipToBounds="False"
            Background="#ffffff"
            VerticalAlignment="Stretch">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ ردیف 0: هدر ═══ -->
            <Grid Grid.Row="0"
                  Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Cursor="Hand"
                            Background="Transparent"
                            Margin="10,0,10,0"
                            MouseLeftButtonDown="HeaderClose_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="14"
                                        Height="14"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="دوره مالی جدید"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="#0D2159"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- خط جداکننده دش‌دار -->
            <Border Grid.Row="0"
                    Height="1"
                    Margin="7,0,7,2"
                    VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,10,1"
                                 ViewportUnits="Absolute"
                                 Viewbox="0,0,10,1"
                                 ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10"
                                  Height="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="5" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="#D4E0FF" />
                                <Rectangle Grid.Column="1"
                                           Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <!-- ═══ ردیف 1: بدنه (اسکرول‌شونده) ═══ -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource MinimalScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>

                        <TextBlock Text="عنوان دوره مالی"
                                   Style="{StaticResource FormLabel}" />
                        <controls:ModernPersianTextBox Text="{Binding PeriodTitle, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="دوره اول"
                                                       Width="330"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,0,0,16" />

                        <TextBlock Text="انتخاب شعبه"
                                   Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="BranchComboBox"
                                  Style="{StaticResource SearchableComboBox}"
                                  Tag="جستجوی شعبه"
                                  Width="330"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding Branches}"
                                  DisplayMemberPath="Title"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedBranchId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                  Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تاریخ شروع دوره"
                                           Style="{StaticResource FormLabel}" />
                                <controls:PersianDatePickerControl x:Name="StartDatePicker"
                                                                   SelectedDate="{Binding StartDate}"
                                                                   DateChanged="DatePicker_DateChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاریخ پایان دوره"
                                           Style="{StaticResource FormLabel}" />
                                <controls:PersianDatePickerControl x:Name="EndDatePicker"
                                                                   SelectedDate="{Binding EndDate}"
                                                                   DateChanged="DatePicker_DateChanged" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0">
                            <controls:ActiveToggleControl x:Name="FinancialPeriodActiveToggle"
                                                          Label="دوره مالی جاری است"
                                                          IsChecked="{Binding IsCurrentPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="10,0,18,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ═══ ردیف 2: جداکننده دکمه‌ای ═══ -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,2">
                <Border Height="3">
                    <Border.Background>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,10,1"
                                     ViewportUnits="Absolute"
                                     Viewbox="0,0,10,1"
                                     ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10"
                                      Height="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0"
                                               Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1"
                                               Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#FFF8ED"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#FFF8ED"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <!-- ═══ ردیف 3: فوتر (دکمه‌ها) ═══ -->
            <Border Grid.Row="3"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".40*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".30*" />
                    </Grid.ColumnDefinitions>

                    <controls:IconButton Grid.Column="0"
                                         x:Name="SaveButton"
                                         ButtonText="ثبت دوره"
                                         IconSource="/Assets/Icons/save.svg"
                                         ButtonCommand="{Binding SaveCommand}"
                                         ButtonBackground="#2667FF"
                                         CornerRadius="4" />

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                            Width="14"
                                            Height="14"
                                            FlowDirection="LeftToRight"
                                            Margin="6,0,15,0" />
                            <TextBlock Text="انصراف"
                                       FontFamily="{StaticResource IRANSans}"
                                       FontSize="14"
                                       Foreground="#2667FF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <controls:CustomOutlinedButton Grid.Column="2"
                                                   Text="ثبت موقت"
                                                   HorizontalAlignment="Stretch"
                                                   BorderBrush="#2667FF"
                                                   Foreground="#2667FF">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/Black.svg"
                                            Width="16"
                                            Height="16" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
