<UserControl x:Class="Taadol.Views.EditBranchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <!-- ═══════════════════════════════════════════════════
         ساختار اصلی: Grid با 5 ردیف (مثل EditFinancialPeriodView)
         ردیف 0: هدر (ثابت)
         ردیف 1: CardPanel اصلی (فیلدهای اصلی)
         ردیف 2: جداکننده دکمه‌ای (ثابت)
         ردیف 3: محتوای اسکرول‌پذیر (تماس / آدرس)
         ردیف 4: فوتر (دکمه‌ها)
    ════════════════════════════════════════════════════ -->
    <Border x:Name="RootBorder"
            CornerRadius="4"
            ClipToBounds="True"
            Background="#ffffff"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Margin="0">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ ردیف 0: هدر ═══ -->
            <Grid Grid.Row="0"
                  Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Cursor="Hand"
                            Background="Transparent"
                            Margin="10,0,10,0"
                            MouseLeftButtonDown="CloseButton_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="14"
                                        Height="14"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="ویرایش شعبه"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="#0D2159"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    Margin="7,0,7,2"
                    VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,10,1"
                                 ViewportUnits="Absolute"
                                 Viewbox="0,0,10,1"
                                 ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10"
                                  Height="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="5" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="#D4E0FF" />
                                <Rectangle Grid.Column="1"
                                           Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <!-- ═══ ردیف 1: CardPanel اصلی ═══ -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanel}">
                <StackPanel>

                    <!-- ردیف ۱: شناسه یکتا (خودکار/دستی) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="شناسه یکتا"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ToggleSwitch2Control x:Name="CodeModeToggle"
                                                               FirstLabel="اتوماتیک"
                                                               SecondLabel="دستی"
                                                               IsFirstSelected="False"
                                                               Margin="12,0,0,5"
                                                               SelectionChanged="CodeModeToggle_SelectionChanged" />
                            </StackPanel>
                            <controls:ModernPersianTextBox x:Name="UniqueCodeInput"
                                                           Width="240"
                                                           InputType="Number"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding UniqueCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           IsEnabled="{Binding IsUniqueCodeManual}"
                                                           Placeholder="1234" />
                        </StackPanel>
                    </Grid>

                    <!-- ردیف ۲: نام شرکت -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="نام شرکت" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <ComboBox x:Name="CompanyComboBox"
                                      Style="{StaticResource SearchableComboBox}"
                                      Tag="جستجوی شرکت"
                                      Width="350"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding Companies}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCompanyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                        </StackPanel>
                    </Grid>

                    <!-- ردیف ۳: نوع شعبه + فعال -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="نوع شعبه"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ToggleSwitch2Control x:Name="BranchTypeToggle"
                                                           FirstLabel="اصلی"
                                                           SecondLabel="فرعی"
                                                           IsFirstSelected="True"
                                                           SelectionChanged="BranchTypeToggle_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Bottom">
                            <controls:ActiveToggleControl x:Name="BranchActiveToggle"
                                                          Label="شعبه فعال است"
                                                          IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- ردیف ۴: نام شعبه -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="نام شعبه" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <controls:ModernPersianTextBox Width="350"
                                                           Text="{Binding BranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="شعبه مرکزی" />
                        </StackPanel>
                    </Grid>

                    <!-- ردیف ۵: کد اقتصادی + شماره ثبت + کد شعبه -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="کد اقتصادی"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox Width="170"
                                                           InputType="Number"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding EconomicCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="247000" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="شماره ثبت"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox Width="170"
                                                           InputType="Number"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding RegisterNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="2480" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="کد شعبه"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox Width="170"
                                                           InputType="Number"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding NationalId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="کد شعبه را وارد کنید" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ ردیف 2: جداکننده دکمه‌ای ═══ -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,2">
                <Border Height="3"
                        Margin="12,0,12,2">
                    <Border.Background>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,10,1"
                                     ViewportUnits="Absolute"
                                     Viewbox="0,0,10,1"
                                     ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10"
                                      Height="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0"
                                               Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1"
                                               Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#66000000"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#66000000"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <!-- ═══ ردیف 3: محتوای اسکرول‌پذیر (تماس / آدرس) ═══ -->
            <ScrollViewer Grid.Row="3"
                          Style="{StaticResource MinimalScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>                    <!-- ═══ بخش آدرس (اول طبق فیگما — بدون بردر) ═══ -->
                    <StackPanel Margin="4,0,4,16">
                        <TextBlock Text="آدرس"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource IRANSans}"
                                   Foreground="#0D2159"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="استان"
                                               Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="ProvinceComboBox"
                                              Width="170"
                                              ItemsSource="{Binding Provinces}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedProvinceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="ProvinceComboBox_SelectionChanged"
                                              Style="{StaticResource SearchableComboBox}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="کد پستی"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="170"
                                                                   Text="{Binding PostCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   InputType="Number"
                                                                   MaxLength="11"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="74100" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="آدرس"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   HorizontalAlignment="Stretch"
                                                                   Placeholder="آدرس کامل شعبه" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="شهرستان"
                                               Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="CityComboBox"
                                              Width="170"
                                              ItemsSource="{Binding Cities}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedCityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SearchableComboBox}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="مختصات مکان X"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="170"
                                                                   Text="{Binding LatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   InputType="Text"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="35.6892" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="مختصات مکان Y"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="170"
                                                                   Text="{Binding LongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   InputType="Text"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="51.3890" />
                                </StackPanel>
                            </Grid>
                    </StackPanel>

                    <!-- ═══ بخش تماس (دوم) ═══ -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16,14,16,14"
                            Margin="4,0,4,12">
                        <StackPanel>
                            <TextBlock Text="تماس"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource IRANSans}"
                                       Foreground="#0D2159"
                                       Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="شماره تلفن"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="200"
                                                                   InputType="Number"
                                                                   MaxLength="11"
                                                                   FlowDirection="LeftToRight"
                                                                   Text="{Binding TelePhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="071" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="موبایل"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="200"
                                                                   InputType="Number"
                                                                   MaxLength="11"
                                                                   FlowDirection="LeftToRight"
                                                                   Text="{Binding MobilePhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="091" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="ایمیل"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="200"
                                                                   InputType="Email"
                                                                   FlowDirection="LeftToRight"
                                                                   Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="example@mail.com" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ ردیف 4: فوتر (دکمه‌ها) ═══ -->
            <Border Grid.Row="4"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- سمت راست: ویرایش شعبه -->
                    <controls:CustomOutlinedButton Grid.Column="0"
                                                   x:Name="SaveButton"
                                                   Text="ویرایش"
                                                   Width="150"
                                                   Margin="0,0,5,0"
                                                   Height="44"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding SaveCommand}">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/editblue.svg"
                                            Width="18"
                                            Margin="0,0,5,0"
                                            FlowDirection="LeftToRight"
                                            Height="18" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>

                    <!-- سمت چپ: انصراف -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Background="Transparent"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                MouseLeftButtonUp="Cancel_Click">
                        <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                        Width="14"
                                        Height="14"
                                        FlowDirection="LeftToRight"
                                        Margin="6,0,15,0" />
                        <TextBlock Text="انصراف"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   Foreground="#2667FF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
