<UserControl x:Class="Taadol.Views.BranchArchiveListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FlowDirection="RightToLeft"
             Loaded="BranchArchiveListView_Loaded"
             FontFamily="{StaticResource IRANSans}"
             Background="#FFFFFF">

    <UserControl.Resources>
        <Style x:Key="EllipseLeft" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-31,0,0,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>
        <Style x:Key="EllipseRight" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-31,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

        <Style x:Key="BankTableCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource UnifiedGridCellStyle}">
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="#FFFFFF"
            CornerRadius="4"
            BorderBrush="#E5E7EB"
            BorderThickness="0"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="20,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="14"
                                            Height="14"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>
                        <TextBlock Text="آرشیو شعبه"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#ffffff"
                        CornerRadius="8"
                        Padding="0"
                        Margin="12,0,0,0"
                        BorderBrush="#ffffff"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Text="نام شرکت" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="CompanyComboBox"
                                              Style="{StaticResource SearchableComboBox}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              Width="300"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedCompany}"
                                              SelectionChanged="CompanyComboBox_SelectionChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                    <TextBlock Text="نام شعبه" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="BranchComboBox"
                                              Style="{StaticResource SearchableComboBox}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              Width="300"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedBranch}"
                                              SelectionChanged="BranchComboBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Text="عنوان فایل" Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox x:Name="SearchBox"
                                                                   Width="300"
                                                                   Placeholder="جستجو کنید" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                    <TextBlock Text="توضیحات" Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox x:Name="DescriptionSearchBox"
                                                                   Width="550"
                                                                   Placeholder="جستجو کنید" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <controls:FilePickerControl Grid.Column="2"
                                                    Margin="0,0,12,0"
                                                    FlowDirection="LeftToRight"
                                                     x:Name="FilePicker"
                                                     VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,5,0,5">
                    <Border Height="3">
                        <Border.Background>
                            <VisualBrush TileMode="Tile"
                                         Viewport="0,0,10,1"
                                         ViewportUnits="Absolute"
                                         Viewbox="0,0,10,1"
                                         ViewboxUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Grid Width="10" Height="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="5" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#BED1FF" />
                                        <Rectangle Grid.Column="1" Fill="Transparent" />
                                    </Grid>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse Width="17" Margin="-9,0,0,0" Height="25" Fill="#FFF8ED"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="2" />
                    <Ellipse Width="17" Height="25" Margin="0,0,-9,0" Fill="#FFF8ED"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="2" />
                </Grid>

                <Border Grid.Row="2"
                        Background="#ffffff"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,4,0"
                                Height="40"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Width="280">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Height="30">
                                    <TextBlock Text="جستجو در عنوان ، شرکت ، شعبه"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               FontFamily="{StaticResource IRANSans}"
                                               FlowDirection="RightToLeft"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"
                                               Panel.ZIndex="1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=HeaderSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="HeaderSearchBox"
                                             Height="30"
                                             FontSize="12"
                                             Foreground="#1F2937"
                                             CaretBrush="#3B82F6"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0,2"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FlowDirection="RightToLeft"
                                             FontFamily="{StaticResource IRANSans}"
                                             TextAlignment="Left">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4">
                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                              Focusable="False"
                                                                              HorizontalScrollBarVisibility="Hidden"
                                                                              VerticalScrollBarVisibility="Hidden" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="1"
                                            Height="14"
                                            Background="#BED1FF"
                                            VerticalAlignment="Center" />
                                    <svg:SvgViewbox Width="14"
                                                    Height="14"
                                                    FlowDirection="LeftToRight"
                                                    Source="/Assets/Icons/search.svg"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">

                            <controls:ActionButton Text="حذف"
                                                   TextColor="#DC2626"
                                                   BorderColor="#E9F0FF"
                                                   IconPath="/Assets/Icons/trash.svg"
                                                   Margin="10,0,0,0"
                                                   Click="BtnDelete_Click" />

                            <controls:ActionButton Text="چاپ"
                                                   TextColor="#2563EB"
                                                   BorderColor="#E9F0FF"
                                                   IconPath="/Assets/Icons/printer.svg"
                                                   Margin="6,0,0,0"
                                                   Click="BtnPrint_Click" />

                            <controls:ActionButton Text="Excel"
                                                   TextColor="#374151"
                                                   BorderColor="#E5E7EB"
                                                   Margin="6,0,0,0" />

                            <controls:ActionButton Text="PDF"
                                                   TextColor="#374151"
                                                   BorderColor="#E5E7EB"
                                                   Margin="6,0,0,0" />

                            <controls:ActionButton Text="بروزرسانی"
                                                   TextColor="#2563EB"
                                                   IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                                   Margin="6,0,0,0"
                                                   Click="BtnRefresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:UnifiedListView x:Name="ArchivesGrid"
                                           Grid.Row="3"
                                           Padding="0,0,10,0"
                                           Margin="12,6,12,5"
                                          ItemsSource="{Binding FilteredArchives}"
                                          PagesSource="{Binding Pages}"
                                          PageInfoContent="{Binding PageInfoText}"
                                          IsLoading="{Binding IsLoading}"
                                          LoadErrorText="{Binding LoadErrorText}">
                    <controls:UnifiedListView.Columns>

                            <DataGridTextColumn Header="تاریخ بارگذاری" Width="200" MinWidth="160"
                                                Binding="{Binding CreationDate}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BankTableCellStyle}" />
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="شرکت" Width="180" MinWidth="140"
                                                Binding="{Binding CompanyName}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BankTableCellStyle}" />
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="شعبه" Width="180" MinWidth="140"
                                                Binding="{Binding BranchTitle}"
                                                ElementStyle="{StaticResource FullNameColumnStyle}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BankTableCellStyle}" />
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="عنوان فایل" Width="200" MinWidth="160"
                                                Binding="{Binding Title}"
                                                ElementStyle="{StaticResource FullNameColumnStyle}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BankTableCellStyle}" />
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="فایل" Width="80" MinWidth="60">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BankTableCellStyle}" />
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <svg:SvgViewbox Width="20" Height="20"
                                                        Source="{Binding FileIconSource}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="توضیحات" Width="2.5*" MinWidth="200"
                                                Binding="{Binding Description}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource BankTableCellStyle}" />
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </controls:UnifiedListView.Columns>
                </controls:UnifiedListView>

                <Border Grid.Row="4"
                        Background="#ffffff"
                        BorderBrush="#E5E7EB"
                        x:Name="SummaryBorder"
                        BorderThickness="1"
                        Height="53"
                        CornerRadius="4"
                        Margin="0,2,0,2"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedSummaryText"
                                       Text="آرشیو انتخاب شده (۰)"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                            <Border Width="1" Height="14" Background="#E5E7EB" Margin="8,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="تعداد کل"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalCountText"
                                       Text="۰ مورد"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="#2563EB"
                                       Margin="8,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    Background="White"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">

                <Grid Margin="16,10" FlowDirection="RightToLeft">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                MouseLeftButtonUp="CancelButton_Click">
                        <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                        Width="14" Height="14"
                                        FlowDirection="LeftToRight"
                                        Margin="6,0,15,0" />
                        <TextBlock Text="انصراف"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   Foreground="#2667FF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Ellipse Style="{StaticResource EllipseLeft}" Grid.Row="1" Grid.ColumnSpan="3" Margin="-18,0,0,0" />
            <Ellipse Style="{StaticResource EllipseRight}" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,-18,0" />
        </Grid>
    </Border>
</UserControl>
