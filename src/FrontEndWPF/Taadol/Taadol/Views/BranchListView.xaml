<UserControl x:Class="Taadol.Views.BranchListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Taadol.Views"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Margin="24"
             Padding="0"
             FontFamily="{StaticResource IRANSans}"      
             Background="#FFFFFF"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibili tyConverter" />

        <Style x:Key="FilterTabStyle2"
               TargetType="RadioButton">
            <Setter Property="FontFamily"
                    Value="{StaticResource IRANSans}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Width"
                    Value="215" />
            <Setter Property="Foreground"
                    Value="#2563EB" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="16,10" />
            <Setter Property="Margin"
                    Value="0,0,4,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Border x:Name="CheckBoxBorder"
                                            Width="20"
                                            Height="20"
                                            BorderThickness="2"
                                            BorderBrush="#2ECC71"
                                            CornerRadius="4"
                                            Background="White"
                                            Padding="2"
                                            Margin="0,0,6,0"
                                            Visibility="Collapsed">
                                        <svg:SvgViewbox x:Name="CheckMark"
                                                        Width="8"
                                                        Height="8"
                                                        Source="/Assets/Icons/Line.svg"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock x:Name="TitleText"
                                               Text="{TemplateBinding Content}"
                                               Foreground="#2563EB"
                                               FontWeight="Medium" />
                                </StackPanel>

                                
                                <TextBlock Grid.Column="2"
                                           x:Name="CountText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#94A3B8"
                                           FontWeight="Normal"
                                           HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#2563EB" />
                                <Setter TargetName="Root"
                                        Property="BorderThickness"
                                        Value="1" />

                                <Setter TargetName="TitleText"
                                        Property="Foreground"
                                        Value="#2563EB" />
                                <Setter TargetName="TitleText"
                                        Property="FontWeight"
                                        Value="Bold" />
                                <Setter TargetName="CountText"
                                        Property="Foreground"
                                        Value="#64748B" />

                                
                                <Setter TargetName="CheckBoxBorder"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="#E9F0FF" />
                                <Setter TargetName="Root"
                                        Property="BorderThickness"
                                        Value="1" />

                                <Setter TargetName="TitleText"
                                        Property="Foreground"
                                        Value="#2563EB" />
                                <Setter TargetName="TitleText"
                                        Property="FontWeight"
                                        Value="Bold" />
                                <Setter TargetName="CountText"
                                        Property="Foreground"
                                        Value="#64748B" />
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#F4F7FF" />
                            </Trigger>

                            
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="TitleText"
                                        Property="Foreground"
                                        Value="#CBD5E1" />
                                <Setter TargetName="CountText"
                                        Property="Foreground"
                                        Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="0,16"
            Background="White"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="16"
                                        Height="16"
                                        Source="/Assets/Icons/arrow-right_BLUE.svg"
                                        Margin="5,0,10,0" />
                        <TextBlock Text="لیست شعبه‌ها"
                                   FontSize="19"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft">
                        <Button Width="36"
                                Height="36"
                                Margin="4,0,0,0"
                                Cursor="Hand"
                                Click="BtnMore_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Width="36"
                                            Height="36">
                                        <svg:SvgViewbox Width="18"
                                                        Height="18"
                                                        Source="/Assets/Icons/MORE.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="36"
                                Height="36"
                                Margin="4,0,0,0"
                                Cursor="Hand"
                                Click="BtnDelete_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Width="36"
                                            Height="36">
                                        <svg:SvgViewbox Width="18"
                                                        Height="18"
                                                        Source="/Assets/Icons/trash.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#FEF2F2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="36"
                                Height="36"
                                Margin="4,0,0,0"
                                Cursor="Hand"
                                Click="BtnEdit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Width="36"
                                            Height="36">
                                        <svg:SvgViewbox Width="18"
                                                        Height="18"
                                                        Source="/Assets/Icons/EDIT.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F0F5FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="36"
                                Height="36"
                                Margin="4,0,0,0"
                                Cursor="Hand"
                                Click="BtnNew_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Width="36"
                                            Height="36">
                                        <svg:SvgViewbox Width="18"
                                                        Height="18"
                                                        Source="/Assets/Icons/newdoc21.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#F0FFF4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Border Grid.Row="1"
                    BorderBrush="#D4E0FF"
                    BorderThickness="0,2,0,0"
                    Background="#FAFCFF"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal"
                            FlowDirection="RightToLeft"
                            VerticalAlignment="Center">
                    <RadioButton x:Name="tabAll"
                                 Style="{StaticResource FilterTabStyle2}"
                                 GroupName="BranchFilter"
                                 Content="همه شعبه‌ها"
                                 Tag="۱۲ شعبه"
                                 IsChecked="True"
                                 Checked="FilterTab_Checked" />
                    <RadioButton x:Name="tabActive"
                                 Style="{StaticResource FilterTabStyle2}"
                                 GroupName="BranchFilter"
                                 Content="فعال"
                                 Tag="۱۰ شعبه"
                                 Checked="FilterTab_Checked" />
                    <RadioButton x:Name="tabInactive"
                                 Style="{StaticResource FilterTabStyle2}"
                                 GroupName="BranchFilter"
                                 Content="غیرفعال"
                                 Tag="۲ شعبه"
                                 Checked="FilterTab_Checked" />
                </StackPanel>
            </Border>

            
                        <Border Grid.Row="2"
                    Background="Transparent"
                    ClipToBounds="False"
                    Padding="15,0">
                <controls:UnifiedListView x:Name="BranchesGrid">
                    <controls:UnifiedListView.Columns>
                        <!-- تاریخ ثبت -->
                        <DataGridTextColumn Header="تاریخ ثبت" Width="90" MinWidth="80"
                                            Binding="{Binding RegisterDate}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شناسه یکتا -->
                        <DataGridTextColumn Header="شناسه یکتا" Width="100" MinWidth="90"
                                            Binding="{Binding UniqueId}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- نوع شعبه -->
                        <DataGridTemplateColumn Header="نوع شعبه" Width="100" MinWidth="90">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="5" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BranchType}" Value="اصلی">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BranchType}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{StaticResource IRANSans}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BranchType}" Value="اصلی">
                                                            <Setter Property="Foreground" Value="#166534" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- نام شرکت -->
                        <DataGridTextColumn Header="نام شرکت" Width="140" MinWidth="120"
                                            Binding="{Binding CompanyName}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- نام شعبه -->
                        <DataGridTextColumn Header="نام شعبه" Width="130" MinWidth="110"
                                            Binding="{Binding BranchName}"
                                            ElementStyle="{StaticResource FullNameColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شماره ثبت -->
                        <DataGridTextColumn Header="شماره ثبت" Width="100" MinWidth="90"
                                            Binding="{Binding RegistrationNumber}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- کد شعبه -->
                        <DataGridTextColumn Header="کد شعبه" Width="85" MinWidth="75"
                                            Binding="{Binding BranchCode}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- استان -->
                        <DataGridTextColumn Header="استان" Width="100" MinWidth="90"
                                            Binding="{Binding Province}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شهر -->
                        <DataGridTextColumn Header="شهر" Width="85" MinWidth="75"
                                            Binding="{Binding City}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- تلفن -->
                        <DataGridTextColumn Header="تلفن" Width="110" MinWidth="100"
                                            Binding="{Binding Phone}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- موبایل -->
                        <DataGridTextColumn Header="موبایل" Width="120" MinWidth="110"
                                            Binding="{Binding Mobile}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- آدرس -->
                        <DataGridTextColumn Header="آدرس" Width="200" MinWidth="170"
                                            Binding="{Binding Address}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource UnifiedGridCellStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <!-- وضعیت -->
                        <DataGridTemplateColumn Header="وضعیت" Width="80" MinWidth="70">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="5" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{StaticResource IRANSans}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                            <Setter Property="Foreground" Value="#166534" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </controls:UnifiedListView.Columns>
                </controls:UnifiedListView>
            </Border>

            <controls:ListSummaryBar x:Name="BranchSummaryBar"
                                     Grid.Row="3"
                                     Margin="15,0" />
        </Grid>
    </Border>
</UserControl>