<UserControl x:Class="Taadol.Views.BranchListView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              xmlns:controls="clr-namespace:Taadol.Controls"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:local="clr-namespace:Taadol.Views"
              mc:Ignorable="d"
              FlowDirection="RightToLeft"
              Padding="0"
              FontFamily="{StaticResource IRANSans}"      
              Background="#FFFFFF">

    <Border Background="White"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="5,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="16"
                                            Height="16"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>
                        <TextBlock Text="لیست شعبه‌ها"
                                   FontSize="19"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft">
                        <Button Width="36"
                                Height="36"
                                Margin="4,0,0,0"
                                Cursor="Hand"
                                Click="BtnDelete_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Width="36"
                                            Height="36">
                                        <svg:SvgViewbox Width="18"
                                                        Height="18"
                                                        Source="/Assets/Icons/trash.svg" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="#FEF2F2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Border Grid.Row="1"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,0"
                    Background="#ffffff"
                    Padding="15,6,10,6"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"
                                          MinWidth="120" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                    </Grid.ColumnDefinitions>

                    <!-- جستجو -->
                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,4,0"
                            Height="40"
                            Padding="5,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Height="30">
                                <TextBlock Text="جستجو در نام شعبه"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontFamily="{StaticResource IRANSans}"
                                           FlowDirection="RightToLeft"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Panel.ZIndex="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=BranchSearchBox}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="BranchSearchBox"
                                         Height="30"
                                         FontSize="12"
                                         Foreground="#1F2937"
                                         CaretBrush="#3B82F6"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0,2"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         FlowDirection="RightToLeft"
                                         FontFamily="{StaticResource IRANSans}"
                                         TextAlignment="Left">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                CornerRadius="4">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Focusable="False"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="1"
                                        Height="14"
                                        Background="#BED1FF"
                                        VerticalAlignment="Center" />
                                <svg:SvgViewbox Width="14"
                                                Height="14"
                                                FlowDirection="LeftToRight"
                                                Source="/Assets/Icons/search.svg"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- تب‌ها -->
                    <ToggleButton x:Name="tabAll"
                                  Grid.Column="1"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="همه شعبه‌ها"
                                  Tag="۱۲ شعبه"
                                  IsChecked="True"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabActive"
                                  Grid.Column="2"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="فعال"
                                  Tag="۱۰ شعبه"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabInactive"
                                  Grid.Column="3"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="غیرفعال"
                                  Tag="۲ شعبه"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />
                </Grid>
            </Border>

            
                        <Border Grid.Row="2"
                    Background="Transparent"
                    ClipToBounds="False"
                    Padding="15,0">
                <controls:UnifiedListView x:Name="BranchesGrid"
                                           Padding="0,0,10,0">
                    <controls:UnifiedListView.Columns>
                        <!-- تاریخ ثبت -->
                        <DataGridTextColumn Header="تاریخ ثبت" Width="90" MinWidth="80"
                                            Binding="{Binding RegisterDate}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شناسه یکتا -->
                        <DataGridTextColumn Header="شناسه یکتا" Width="100" MinWidth="90"
                                            Binding="{Binding UniqueId}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- نوع شعبه -->
                        <DataGridTemplateColumn Header="نوع شعبه" Width="100" MinWidth="90">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="5" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BranchType}" Value="اصلی">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding BranchType}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{StaticResource IRANSans}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BranchType}" Value="اصلی">
                                                            <Setter Property="Foreground" Value="#166534" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- نام شرکت -->
                        <DataGridTextColumn Header="نام شرکت" Width="140" MinWidth="120"
                                            Binding="{Binding CompanyName}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="نام شرکت"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="CompanyNameFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>

                        <!-- نام شعبه -->
                        <DataGridTextColumn Header="نام شعبه" Width="130" MinWidth="110"
                                            Binding="{Binding BranchName}"
                                            ElementStyle="{StaticResource FullNameColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- شماره ثبت -->
                        <DataGridTextColumn Header="شماره ثبت" Width="100" MinWidth="90"
                                            Binding="{Binding RegistrationNumber}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- کد شعبه -->
                        <DataGridTextColumn Header="کد شعبه" Width="85" MinWidth="75"
                                            Binding="{Binding BranchCode}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- استان -->
                        <DataGridTextColumn Header="استان" Width="100" MinWidth="90"
                                            Binding="{Binding Province}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="استان"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="ProvinceFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>

                        <!-- شهر -->
                        <DataGridTextColumn Header="شهر" Width="85" MinWidth="75"
                                            Binding="{Binding City}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="شهر"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="CityFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>

                        <!-- تلفن -->
                        <DataGridTextColumn Header="تلفن" Width="110" MinWidth="100"
                                            Binding="{Binding Phone}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- موبایل -->
                        <DataGridTextColumn Header="موبایل" Width="120" MinWidth="110"
                                            Binding="{Binding Mobile}"
                                            ElementStyle="{StaticResource LtrTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <!-- آدرس -->
                        <DataGridTextColumn Header="آدرس" Width="200" MinWidth="170"
                                            Binding="{Binding Address}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource UnifiedGridCellStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <!-- وضعیت -->
                        <DataGridTemplateColumn Header="وضعیت" Width="80" MinWidth="70">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    <Setter Property="BorderBrush" Value="#E0E7FF" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="وضعیت"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="StatusFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="5" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                        <Setter Property="Background" Value="#DCFCE7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{StaticResource IRANSans}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                            <Setter Property="Foreground" Value="#166534" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </controls:UnifiedListView.Columns>
                </controls:UnifiedListView>
            </Border>

            <controls:ListSummaryBar x:Name="BranchSummaryBar"
                                     Grid.Row="3"
                                     Margin="15,0" />
        </Grid>
    </Border>
</UserControl>