                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="نام شعبه"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6"
                                                   Text="شماره کارت"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="8"
                                                   Text="شماره شبا"
