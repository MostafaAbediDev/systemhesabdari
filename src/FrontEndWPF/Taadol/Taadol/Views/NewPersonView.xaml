                                                               FlowDirection="LeftToRight"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />

                                                    <Border Grid.Column="7" Background="#E5E7EB" />

                                                    <!-- شماره شبا -->
                                                    <TextBlock Grid.Column="8"
                                                               Text="{Binding Shaba}"
