                                <StackPanel Grid.Row="0"
                                            Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره کارت" /><Run Text=" *"
                                                                                                                Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="CardNumberInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Margin="0,0,0,0"
                                                                   Placeholder="**** **** **** ****" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="6"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,20">
                                    <ToggleButton x:Name="DefaultAccountToggle"
                                                  Content="حساب پیش فرض"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource StatusToggleButton}"
                                                  IsChecked="True" />
                                </StackPanel>

                                <!-- ردیف دوم: شماره حساب + شماره شبا + دکمه افزودن -->
                                <StackPanel Grid.Row="1"
                                            Margin="0,0,0,0"
                                            Grid.Column="0">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره حساب" /><Run Text=" *"
                                                                                                                Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="AccountNumberInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="456" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره شبا" /><Run Text=" *"
                                                                                                               Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="ShabaInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   MaxLength="24"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="IR" />
                                </StackPanel>

                                <!-- دکمه افزودن، داخل خود گرید، چسبیده به چپ -->
