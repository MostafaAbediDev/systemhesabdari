                                                                <svg:SvgViewbox Width="14"
                                                                                Height="14"
                                                                                Source="/Assets/Icons/trash.svg" />
                                                            </Button>
                                                            <Button Tag="{Binding}"
                                                                Click="EditBankAccount_Click"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                ToolTip="ویرایش"
                                                                Padding="4">
                                                            <svg:SvgViewbox Width="14" Height="14"
                                                                            FlowDirection="LeftToRight"
                                                                                Source="/Assets/Icons/editblue.svg" />
                                                        </Button>
                                                       
                                                    </StackPanel>
                                                </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
