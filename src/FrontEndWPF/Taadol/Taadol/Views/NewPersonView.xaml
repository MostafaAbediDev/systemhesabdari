                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"       
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".40*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".30*" />
                    </Grid.ColumnDefinitions>

                    <!-- سمت راست: ذخیره شخص -->
                    <controls:IconButton Grid.Column="0"
                                         x:Name="SaveButton"
                                         ButtonText="ذخیره شخص"
                                         IconSource="/Assets/Icons/save.svg"
                                         ButtonCommand="{Binding SavePersonCommand}"
                                         ButtonBackground="#2667FF"
                                         CornerRadius="4" />

                  

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                            Width="14"
                                            Height="14"
                                            FlowDirection="LeftToRight"
                                            Margin="6,0,15,0" />
                            <TextBlock Text="انصراف"
                                       FontFamily="{StaticResource IRANSans}"
                                       FontSize="14"
                                       Foreground="#2667FF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- سمت چپ: ذخیره موقت -->
                    <controls:CustomOutlinedButton Grid.Column="2"
                                                   Text="ذخیره موقت"
                                                   HorizontalAlignment="Stretch"
                                                 
                                                   BorderBrush="#2667FF"
                                                   Foreground="#2667FF">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/Black.svg"
                                            Width="16"
                                            Height="16" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>
                </Grid>
            </Border>

        </Grid>
    </Border>

</UserControl>