                                    <!-- ============ ردیف‌های داده ============ -->
                                    <ItemsControl Grid.Row="1"
                                                  ItemsSource="{Binding BankAccounts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB"
