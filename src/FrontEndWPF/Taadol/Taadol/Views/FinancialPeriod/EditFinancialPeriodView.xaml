<UserControl x:Class="Taadol.Views.EditFinancialPeriodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <!-- ═══════════════════════════════════════════════════
         ساختار اصلی: Grid با 5 ردیف (مثل EditCompanyView)
         ردیف 0: هدر (ثابت)
         ردیف 1: CardPanel اصلی (فیلدها)
         ردیف 2: جداکننده دکمه‌ای (ثابت)
         ردیف 3: فضای محتوا (اسکرول‌پذیر)
         ردیف 4: فوتر (دکمه‌ها)
    ════════════════════════════════════════════════════ -->
    <Border x:Name="RootBorder"
            CornerRadius="4"
            ClipToBounds="True"
            Background="#ffffff"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Margin="0">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ ردیف 0: هدر ═══ -->
            <Grid Grid.Row="0"
                  Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Cursor="Hand"
                            Background="Transparent"
                            Margin="10,0,10,0"
                            MouseLeftButtonDown="CloseButton_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="14"
                                        Height="14"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="ویرایش دوره مالی"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="#0D2159"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    Margin="7,0,7,2"
                    VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,10,1"
                                 ViewportUnits="Absolute"
                                 Viewbox="0,0,10,1"
                                 ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10"
                                  Height="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="5" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="#D4E0FF" />
                                <Rectangle Grid.Column="1"
                                           Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <!-- ═══ ردیف 1: CardPanel اصلی ═══ -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanel}">
                <StackPanel>

                    <!-- ردیف اول: عنوان دوره مالی + دوره جاری -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="عنوان دوره مالی" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <controls:ModernPersianTextBox Width="350"
                                                           Text="{Binding PeriodTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="دوره اول" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="40,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="وضعیت"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ActiveToggleControl x:Name="FinancialPeriodActiveToggle"
                                                          Label="دوره مالی جاری است"
                                                          IsChecked="{Binding IsCurrentPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- ردیف دوم: انتخاب شعبه -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="انتخاب شعبه" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <ComboBox x:Name="BranchComboBox"
                                      Style="{StaticResource SearchableComboBox}"
                                      Tag="جستجوی شعبه"
                                      Width="350"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding Branches}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedBranchId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                        </StackPanel>
                    </Grid>

                    <!-- ردیف سوم: تاریخ شروع و پایان -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="تاریخ شروع دوره" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <controls:PersianDatePickerControl x:Name="StartDatePicker"
                                                               DateChanged="StartDatePicker_DateChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="تاریخ پایان دوره" /><Run Text=" *" Foreground="#DC2626" />
                            </TextBlock>
                            <controls:PersianDatePickerControl x:Name="EndDatePicker"
                                                               DateChanged="EndDatePicker_DateChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ ردیف 2: جداکننده دکمه‌ای ═══ -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,2">
                <Border Height="3"
                        Margin="12,0,12,2">
                    <Border.Background>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,10,1"
                                     ViewportUnits="Absolute"
                                     Viewbox="0,0,10,1"
                                     ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10"
                                      Height="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0"
                                               Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1"
                                               Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#66000000"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#66000000"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <!-- ═══ ردیف 3: فضای محتوا ═══ -->
            <Grid Grid.Row="3" />

            <!-- ═══ ردیف 4: فوتر (دکمه‌ها) ═══ -->
            <Border Grid.Row="4"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- سمت راست: ویرایش دوره مالی -->
                    <controls:CustomOutlinedButton Grid.Column="0"
                                                   x:Name="SaveButton"
                                                   Text="ویرایش"
                                                   Width="150"
                                                   Margin="0,0,5,0"
                                                   Height="44"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding SaveCommand}">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/editblue.svg"
                                            Width="18"
                                            Margin="0,0,5,0"
                                            FlowDirection="LeftToRight"
                                            Height="18" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>

                    <!-- سمت چپ: انصراف -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Background="Transparent"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                MouseLeftButtonUp="Cancel_Click">
                        <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                        Width="14"
                                        Height="14"
                                        FlowDirection="LeftToRight"
                                        Margin="6,0,15,0" />
                        <TextBlock Text="انصراف"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   Foreground="#2667FF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
