                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- دکمه‌های شماره صفحه -->
                                    <ItemsControl x:Name="PageButtonsItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="26"
                                                        Height="26"
                                                        Margin="0,0,2,0"
                                                        Cursor="Hand"
                                                        Click="BtnPage_Click"
                                                        Tag="{Binding PageNumber}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd"
                                                                    Width="26"
                                                                    Height="26"
                                                                    Background="White"
                                                                    BorderBrush="#E5E7EB"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="4">
                                                                <TextBlock Text="{Binding PageNumberDisplay}"
                                                                           FontSize="12"
                                                                           FontFamily="{StaticResource IRANSans}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground"
                                                                                    Value="#94A3B8" />
                                                                            <Setter Property="FontWeight"
                                                                                    Value="Normal" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                                                             Value="True">
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#2563EB" />
                                                                                    <Setter Property="FontWeight"
                                                                                            Value="Bold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <!-- «...» بدون قاب و بدون هاور -->
                                                                <DataTrigger Binding="{Binding PageNumberDisplay}"
                                                                             Value="...">
                                                                    <Setter TargetName="bd"
                                                                            Property="BorderBrush"
                                                                            Value="Transparent" />
                                                                    <Setter TargetName="bd"
                                                                            Property="Background"
                                                                            Value="Transparent" />
                                                                </DataTrigger>

                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="bd"
                                                                            Property="Background"
                                                                            Value="#F5F7FA" />
                                                                </Trigger>

                                                                <!-- صفحه‌ی فعلی: بردر و پس‌زمینه‌ی آبی روشن -->
                                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                                             Value="True">
                                                                    <Setter TargetName="bd"
                                                                            Property="BorderBrush"
                                                                            Value="#2563EB" />
                                                                    <Setter TargetName="bd"
                                                                            Property="Background"
                                                                            Value="White" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- دکمه‌ی بعدی (فلش) -->
                                    <Button Width="26"
                                            Height="26"
                                            Margin="0,0,0,0"
                                            Cursor="Hand"
                                            Click="BtnNextPage_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Width="26"
                                                        Height="26"
                                                        Background="White"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1.5"
                                                        CornerRadius="4">
                                                    <svg:SvgViewbox x:Name="ToggleArrowIcon"
                                                                    Width="7"
                                                                    Height="11"
                                                                    Source="/Assets/Icons/ArrowLeft.svg"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                        <svg:SvgViewbox.RenderTransform>
                                                            <RotateTransform x:Name="ArrowRotation"
                                                                             Angle="180" />
                                                        </svg:SvgViewbox.RenderTransform>
                                                    </svg:SvgViewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="bd"
                                                                Property="Background"
                                                                Value="#F5F7FA" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- ═══ نمایش X از Y مورد + انتخاب تعداد ردیف ═══ -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                   

                                    <controls:PageSizeSelector x:Name="PageSizeSelector"
                                                                SelectionChanged="PageSizeSelector_SelectionChanged" />

                                    <TextBlock x:Name="PageInfoText"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"
                                               Margin="24,0,8,0" />
                                </StackPanel>

                            </Grid>
                        </Border>
                    </Grid>
            </Border>

            <!-- ═══ Decorative Ellipses ═══ -->
            <Ellipse Style="{StaticResource EllipseLeft}" Grid.Row="1" Grid.ColumnSpan="3" Margin="-18,0,0,0" />
            <Ellipse Style="{StaticResource EllipseRight}" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,-18,0" />

        </Grid>
            <Border Grid.Row="2"
                    Background="#FAFCFF"
                    BorderBrush="#E5E7EB"
                    x:Name="FooterBorder"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
<Run Text="راهنما"
                        FontWeight="Regular"
                        Foreground="#0D2159" />
<Run Text=" F1"
                        Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="بروزرسانی"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F5"
                            Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="انتخاب ردیف"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F8"
                            Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="تمام صفحه"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F11"
                            Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="ذخیره نام جدید"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F12"
                            Foreground="#2667FF" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>