<UserControl x:Class="Taadol.Views.PersonListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:System="http://schemas.microsoft.com/winfx/2009/xaml"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Loaded="UserControl_Loaded"
             Margin="5"
             Padding="0"
             FontFamily="{StaticResource IRANSans}"
             Background="#FFFFFF">

    <UserControl.Resources>
        <Style x:Key="MinimalScrollBarH"
               TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root"
                              Background="Transparent"
                              Height="8">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False"
                                   Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{StaticResource AccentBrush}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{StaticResource AccentBrush}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb"
                                           MinWidth="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#9CA3AF"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch">
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation To="#2667FF"
                                                                                    Duration="0:0:0.2"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    Storyboard.TargetName="ThumbBorder" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation To="#9CA3AF"
                                                                                    Duration="0:0:0.2"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    Storyboard.TargetName="ThumbBorder" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EllipseLeft" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-31,0,0,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

        <Style x:Key="EllipseRight" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-31,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Margin="0"
            Background="#FFFFFF"
            CornerRadius="4"
            BorderBrush="#E5E7EB"
            BorderThickness="0"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="16"
                                        Height="16"
                                        Source="/Assets/Icons/closeTHIN.svg"
                                        Margin="20,0,10,0" />
                        <TextBlock Text="لیست اشخاص"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Click="BtnDelete_Click" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click"
                                               Loaded="ActionButton_Loaded" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"
                                               
                                               Click="BtnRefresh_Click"
                                               Loaded="ActionButton_Loaded_1" />

                        <!-- X بستن -->
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="6"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                           
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DetailPanelColumn"
                                      Width="340"
                                      MinWidth="64"
                                      MaxWidth="340" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*"
                                      MinWidth="500" />
                </Grid.ColumnDefinitions>

                <!-- ═══ پنل سمت راست — اطلاعات اشخاص انتخاب شده ═══ -->
                <Grid Grid.Column="0"
                      MinWidth="64"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- عنوان پنل -->
                    <Border Grid.Row="0"
                            x:Name="PanelHeaderBorder"
                            Background="#ffffff"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,0"
                            Padding="4,6">
                        <Grid x:Name="PanelHeaderStack"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Height="32" VerticalAlignment="Top">
                                    <svg:SvgViewbox x:Name="MainIcon"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,6,6,0"
                                                    Source="/Assets/Icons/user_blue.svg"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />
                                </Border>
                                <Border x:Name="SelectedCountBadge"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="#ffffff"
                                        BorderBrush="#ffffff"
                                        BorderThickness="1">
                                    <TextBlock x:Name="PanelHeaderText"
                                               Text="اشخاص انتخاب شده"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#0D2159"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="SelectedCountText"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="13"
                                       FontWeight="DemiBold"
                                       Foreground="#0D2159"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,0" />

                            <StackPanel Grid.Column="2"
                                        x:Name="HeaderTextStack"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- پنل اطلاعات -->
                    <Border x:Name="DetailPanelContainer"
                            Grid.Row="1"
                            Width="340"
                            Padding="10,5,2,5"
                            Visibility="Visible"
                            PreviewMouseWheel="DetailPanelContainer_PreviewMouseWheel">
                        <ScrollViewer x:Name="DetailPanelScroll"
                                      Style="{StaticResource MinimalScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailPanelsStack" />
                        </ScrollViewer>
                    </Border>

                    <!-- دکمه + شخص جدید -->
                    <Border Grid.Row="2"
                            x:Name="BtnNewBorder"
                            Margin="10,8,10,8"
                            Cursor="Hand"
                            Background="#2563EB"
                            CornerRadius="6"
                            Padding="0,10"
                            HorizontalAlignment="Stretch"
                            MouseLeftButtonDown="BtnNew_Click">
                        <StackPanel x:Name="BtnNewStack"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <svg:SvgViewbox x:Name="BtnNewIcon"
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,10,0"
                                            Source="/Assets/Icons/plus_LINE.svg"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            <TextBlock x:Name="BtnNewText"
                                       Text="شخص جدید"
                                       FontSize="13"
                                       FontWeight="Regular"
                                       Foreground="White"
                                       FontFamily="{StaticResource IRANSans}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- دکمه باز/بسته پنل -->
              

            <!-- ═══ DataGrid Container ═══ -->
            <Border Grid.Column="2"
                    Background="Transparent"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        ClipToBounds="True">

                <Grid x:Name="DataGridInnerGrid"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="*" />
                         <RowDefinition Height="Auto" />
                     </Grid.RowDefinitions>

                    <!-- ═══ Filter Tabs + Search ═══ -->
                         <Border Grid.Row="0"
                                 x:Name="FilterBarBorder"
                                 BorderBrush="#E5E7EB"
                                 BorderThickness="0,0,0,0"
                                 Background="#ffffff"
                                 Padding="0,6,10,6"
                                 Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"
                                                      MinWidth="120" />
                                    <ColumnDefinition Width="*"
                                                      MinWidth="70" />
                                    <ColumnDefinition Width="*"
                                                      MinWidth="70" />
                                    <ColumnDefinition Width="*"
                                                      MinWidth="70" />
                                    <ColumnDefinition Width="*"
                                                      MinWidth="70" />
                                </Grid.ColumnDefinitions>

                                <!-- جستجو -->
                                <Border Grid.Column="0"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Height="40"
                                        Padding="5,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Height="30">
                                            <TextBlock Text="جستجو در نام ، شماره موبایل"
                                                       FontSize="12"
                                                       Foreground="#94A3B8"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FlowDirection="RightToLeft"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"
                                                       Panel.ZIndex="1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="SearchBox"
                                                     Height="30"
                                                     FontSize="12"
                                                     Foreground="#1F2937"
                                                     CaretBrush="#3B82F6"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0,2"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     FlowDirection="RightToLeft"
                                                     FontFamily="{StaticResource IRANSans}"
                                                     TextAlignment="Left">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderThickness="0"
                                                                            CornerRadius="4">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                                      Focusable="False"
                                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                                      VerticalScrollBarVisibility="Hidden" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Width="1"
                                                    Height="14"
                                                    Background="#BED1FF"
                                                    VerticalAlignment="Center" />
                                            <svg:SvgViewbox Width="14"
                                                            Height="14"
                                                            FlowDirection="LeftToRight"
                                                            Source="/Assets/Icons/search.svg"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- تب‌ها -->
                                <ToggleButton x:Name="tabAll"
                                              Grid.Column="1"
                                              Style="{StaticResource FilterTabStyle2}"
                                              Content="همه اشخاص"
                                              IsChecked="True"
                                              HorizontalAlignment="Stretch"
                                              Click="FilterTab_Click"
                                              Margin="4,0,0,0" />

                                <ToggleButton x:Name="tabCustomers"
                                              Grid.Column="2"
                                              Style="{StaticResource FilterTabStyle2}"
                                              Content="مشتری"
                                              HorizontalAlignment="Stretch"
                                              Click="FilterTab_Click"
                                              Margin="4,0,0,0" />

                                <ToggleButton x:Name="tabSuppliers"
                                              Grid.Column="3"
                                              Style="{StaticResource FilterTabStyle2}"
                                              Content="تامین کننده"
                                              HorizontalAlignment="Stretch"
                                              Click="FilterTab_Click"
                                              Margin="4,0,0,0" />

                                <ToggleButton x:Name="tabPersonnel"
                                              Grid.Column="4"
                                              Style="{StaticResource FilterTabStyle2}"
                                              Content="پرسنل"
                                              HorizontalAlignment="Stretch"
                                              Click="FilterTab_Click"
                                              Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                         <!-- ═══ DataGrid (کنترل مشترک) ═══ -->
                         <controls:UnifiedListView x:Name="PersonsGrid"
                                                   Grid.Row="1"
                                                   Padding="0,0,10,0"
                                                   ItemsSource="{Binding FilteredPersons}"
                                                   PagesSource="{Binding Pages}"
                                                   PageInfoContent="{Binding PageInfoText}"
                                                   IsLoading="{Binding IsLoading}"
                                                  Loaded="PersonsGrid_Loaded">
                             <controls:UnifiedListView.Columns>



                                 <!-- 3️⃣ کد یکتا -->
                                 <DataGridTextColumn Header="کد یکتا"
                                                     Width="100"
                                                     MinWidth="90"
                                                    Binding="{Binding Code}"
                                                    ElementStyle="{StaticResource BaseTextColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                 <!-- 4️⃣ نام کامل / شرکت -->
                                 <DataGridTextColumn Header="نام کامل / شرکت"
                                                     Width="180"
                                                     MinWidth="160"
                                                    Binding="{Binding FullName}"
                                                    ElementStyle="{StaticResource FullNameColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                 <!-- 5️⃣ وضعیت (با فیلتر) -->
                                 <DataGridTemplateColumn Width="100"
                                                         MinWidth="90">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="ویژگی"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           VerticalAlignment="Center" />
                                                <Button Click="StatusFilter_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="2">
                                                                <svg:SvgViewbox Width="12"
                                                                                Height="12"
                                                                                Source="/Assets/Icons/Filter.svg"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter
                                                                            Property="Background"
                                                                            Value="#F3F4F6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding StatusVisibility}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="غیرفعال">
                                                                <Setter Property="Background"
                                                                        Value="#E5E7EC" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}"
                                                                         Value="فعال">
                                                                <Setter Property="Background"
                                                                        Value="#1A00D86F" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11.5"
                                                           FontWeight="Medium"
                                                           FontFamily="{StaticResource IRANSans}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="غیرفعال">
                                                                    <Setter Property="Foreground"
                                                                            Value="#66718E" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}"
                                                                             Value="فعال">
                                                                    <Setter Property="Foreground"
                                                                            Value="#22C55E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                 <!-- 6️⃣ نوع (حقیقی/حقوقی) با فیلتر -->
                                 <DataGridTemplateColumn Width="90"
                                                         MinWidth="80">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="نوع"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           VerticalAlignment="Center" />
                                                <Button Click="LegalStatusFilter_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="2">
                                                                <svg:SvgViewbox Width="12"
                                                                                Height="12"
                                                                                Source="/Assets/Icons/Filter.svg"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter
                                                                            Property="Background"
                                                                            Value="#F3F4F6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LegalStatus}"
                                                       Style="{StaticResource BaseTextColumnStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                 <!-- 7️⃣ موبایل -->
                                 <DataGridTextColumn Header="موبایل"
                                                     Width="130"
                                                     MinWidth="120"
                                                    Binding="{Binding Mobile}"
                                                    ElementStyle="{StaticResource LtrTextColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                 <!-- 8️⃣ شهر (با فیلتر) -->
                                 <DataGridTemplateColumn Width="120"
                                                         MinWidth="110">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="شهر"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           VerticalAlignment="Center" />
                                                <Button Click="CityFilter_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="2">
                                                                <svg:SvgViewbox Width="12"
                                                                                Height="12"
                                                                                Source="/Assets/Icons/Filter.svg"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter
                                                                            Property="Background"
                                                                            Value="#F3F4F6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding City}"
                                                       Style="{StaticResource BaseTextColumnStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                 <!-- 9️⃣ آخرین تراکنش -->
                                 <DataGridTemplateColumn Header="آخرین تراکنش"
                                                         Width="130"
                                                         MinWidth="120">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding AccountStatusVisibility}">
                                                <TextBlock Text="{Binding TransactionDate}"
                                                           FontSize="12"
                                                           FontWeight="Regular"
                                                           Foreground="#374151"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           FlowDirection="LeftToRight"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                <svg:SvgViewbox Width="14"
                                                                Height="14"
                                                                Source="{Binding TransactionIconPath}"
                                                                FlowDirection="LeftToRight"
                                                                VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 🔟 وضعیت حساب با فیلتر -->
                                <DataGridTemplateColumn Width="*"
                                                        MinWidth="180">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="مانده / وضعیت حساب"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"
                                                           VerticalAlignment="Center" />
                                                <Button Click="AccountStatusFilter_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="2"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="2">
                                                                <svg:SvgViewbox Width="12"
                                                                                Height="12"
                                                                                Source="/Assets/Icons/Filter.svg"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter
                                                                            Property="Background"
                                                                            Value="#F3F4F6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding AccountStatusVisibility}">

                                                <TextBlock FontSize="13"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AccountStatus}" Value="بدهکار">
                                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AccountStatus}" Value="بستانکار">
                                                                     <Setter Property="Foreground" Value="#DC2626" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AccountStatus}" Value="بی حساب">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding BalanceDisplay, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text="{Binding AccountStatus, Mode=OneWay}" FontWeight="Regular" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </controls:UnifiedListView.Columns>
                        </controls:UnifiedListView>

                <!-- ═══ نوار خلاصه زیر گرید ═══ -->
                <Border Grid.Row="2"
                        Background="#ffffff"
                        BorderBrush="#E5E7EB"
                        x:Name="SummaryBorder"
                        BorderThickness="1"
                        Height="42"
                        CornerRadius="4"
                        Margin="0,2,10,8"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- جمع بدهکار -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="جمع بدهکار"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                           
                            <TextBlock x:Name="TotalDebitText"
                                               FontSize="14" FontWeight="Medium"
                                       Foreground="#22C55E"
                                               Margin="8,0"
                                               VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- جمع بستانکار -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="30,0">
                            <TextBlock Text="جمع بستانکار"
                                               FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalCreditText"
                                               FontSize="14" FontWeight="Medium"
                                               Margin="8,0"
                                               Foreground="#C1121F"
                                        VerticalAlignment="Center" />
                                    <Border Width="1"
                                            Height="14"
                                            Background="#E5E7EB"
                                            Margin="8,0"
                                            VerticalAlignment="Center" />

                                </StackPanel>

                        <!-- جمع اشخاص انتخاب شده -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedSummaryText"
                                               FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                                  
                            <TextBlock x:Name="SelectedTotalText"
                                               FontSize="14" FontWeight="Medium"
                                       Foreground="#2563EB"
                                       Margin="8,0"
                                       VerticalAlignment="Center" />
                                    <Border Width="1"
                                            Height="14"
                                            Background="#E5E7EB"
                                            Margin="8,0"
                                            VerticalAlignment="Center" />
                                </StackPanel>
                    </Grid>
                </Border>

                    </Grid>
            </Border>
              


                <!-- ═══ Decorative Ellipses ═══ -->
            <Ellipse Style="{StaticResource EllipseLeft}" Grid.Row="1" Grid.ColumnSpan="3" Margin="-18,0,0,0" />
            <Ellipse Style="{StaticResource EllipseRight}" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,-18,0" />

            <!-- ═══ Toggle Button — direct grid child, last = on top ═══ -->
            <Button x:Name="BtnToggleSidebar"
                    Grid.Row="1" Grid.ColumnSpan="3"
                    Click="BtnToggleSidebar_Click"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="332,40,0,0"
                    Width="24"
                    Height="24"
                    Cursor="Hand"
                    Panel.ZIndex="9999"
                    FlowDirection="LeftToRight">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="toggleBorder"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Width="24"
                                    Height="24">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1"
                                                      BlurRadius="12"
                                                      ShadowDepth="3"
                                                      Opacity="0.22"
                                                      Direction="315" />
                                </Border.Effect>
                                <svg:SvgViewbox x:Name="ToggleArrowIcon"
                                                Width="7"
                                                Height="10"
                                                Source="/Assets/Icons/ArrowLeft.svg"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                    <svg:SvgViewbox.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotation"
                                                         Angle="0" />
                                    </svg:SvgViewbox.RenderTransform>
                                </svg:SvgViewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="toggleBorder"
                                            Property="BorderBrush"
                                            Value="#7DA4FF" />
                                    <Setter TargetName="toggleBorder"
                                            Property="BorderThickness"
                                            Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="toggleBorder"
                                            Property="Background"
                                            Value="#D4E1FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

        </Grid>
            <Border Grid.Row="2"
                    Background="#FAFCFF"
                    BorderBrush="#E5E7EB"
                    x:Name="FooterBorder"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
<Run Text="راهنما"
                        FontWeight="Regular"
                        Foreground="#0D2159" />
<Run Text=" F1"
                        Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="بروزرسانی"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F5"
                            Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="انتخاب ردیف"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F8"
                            Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="تمام صفحه"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F11"
                            Foreground="#2667FF" />
                    </TextBlock>
                    <Border Width="1"
                            Height="12"
                            Background="#D1D5DB"
                            Margin="16,0"
                            VerticalAlignment="Center" />
                    <TextBlock FontSize="14"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource IRANSans}"
                               VerticalAlignment="Center">
                       <Run Text="ذخیره نام جدید"
                            FontWeight="Regular"
                            Foreground="#0D2159" />
                       <Run Text=" F12"
                            Foreground="#2667FF" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
