<UserControl x:Class="Taadol.Views.PersonListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:System="http://schemas.microsoft.com/winfx/2009/xaml"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Loaded="UserControl_Loaded"
             Margin="5"
             Padding="0"
             FontFamily="{StaticResource IRANSans}"
             Background="#FFFFFF">

    <UserControl.Resources>

        <Style x:Key="EllipseLeft" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-31,0,0,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

        <Style x:Key="EllipseRight" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-31,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Margin="0,4"
            SizeChanged="RootBorder_SizeChanged"
            Background="White"
            CornerRadius="4"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="16"
                                        Height="16"
                                        Source="/Assets/Icons/closeTHIN.svg"
                                        Margin="20,0,10,0" />
                        <TextBlock Text="لیست اشخاص"
                                   FontSize="19"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Click="BtnDelete_Click" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click"
                                               Loaded="ActionButton_Loaded" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"
                                               
                                               Click="BtnRefresh_Click"
                                               Loaded="ActionButton_Loaded_1" />

                        <!-- X بستن -->
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="6"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                           
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══ پنل سمت راست — اطلاعات اشخاص انتخاب شده ═══ -->
                <Grid Grid.Column="0" Width="340">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- عنوان پنل -->
                    <Border Grid.Row="0"
                            Background="#FAFCFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,0"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <svg:SvgViewbox x:Name="MainIcon"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,6,0"
                                            Source="/Assets/Icons/user_blue.svg"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="اشخاص انتخاب شده"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0D2159"
                                       VerticalAlignment="Center" />
                            <Border x:Name="SelectedCountBadge"
                                  
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedCountText"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#0D2159"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- پنل اطلاعات -->
                    <Border x:Name="DetailPanelContainer"
                            Grid.Row="1"
                            Width="340"
                            Padding="10,5"
                            Visibility="Visible"
                            PreviewMouseWheel="DetailPanelContainer_PreviewMouseWheel">
                        <ScrollViewer x:Name="DetailPanelScroll"
                                      Style="{StaticResource MinimalScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailPanelsStack" />
                        </ScrollViewer>
                    </Border>

                    <!-- دکمه + شخص جدید -->
                    <Border Grid.Row="2"
                            Margin="10,8,10,8"
                            Cursor="Hand"
                            Background="#2563EB"
                            CornerRadius="6"
                            Padding="0,10"
                            HorizontalAlignment="Stretch"
                            MouseLeftButtonDown="BtnNew_Click">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <svg:SvgViewbox 
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,12,0"
                                            Source="/Assets/Icons/plus_LINE.svg"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="شخص جدید"
                                       FontSize="13"
                                       FontWeight="Regular"
                                       Foreground="White"
                                       FontFamily="{StaticResource IRANSans}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- دیوایدر عمودی -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="#E5E7EB"
                        Margin="1,0,5,0"
                        VerticalAlignment="Stretch" />

            <!-- ═══ DataGrid Container ═══ -->
            <Border Grid.Column="2"
                    Background="Transparent"
                        VerticalAlignment="Top"
                        ClipToBounds="False">

                <Grid x:Name="DataGridInnerGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ═══ Filter Tabs + Search ═══ -->
                    <Border Grid.Row="0"
                                x:Name="FilterBarBorder"
                                BorderBrush="Red"
                            BorderThickness="0,0,0,0"
                            Background="#FAFCFF"
                            Padding="8,6">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterTab" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterTab" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterTab" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FilterTab" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="tabAll"
                                          Grid.Column="1"
                                          Style="{StaticResource FilterTabStyle2}"
                                          Content="همه اشخاص"
                                          Tag=""
                                          
                                          IsChecked="True"
                                          HorizontalAlignment="Stretch"
                                          Click="FilterTab_Click" />

                            <ToggleButton x:Name="tabCustomers"
                                          Grid.Column="2"
                                          Style="{StaticResource FilterTabStyle2}"
                                          Content="مشتریان"
                                          Tag=""
                                          HorizontalAlignment="Stretch"
                                          Click="FilterTab_Click" />

                            <ToggleButton x:Name="tabSuppliers"
                                          Grid.Column="3"
                                          Style="{StaticResource FilterTabStyle2}"
                                          Content="تامین کنندگان"
                                          Tag=""
                                          HorizontalAlignment="Stretch"
                                          Click="FilterTab_Click" />

                            <ToggleButton x:Name="tabPersonnel"
                                          Grid.Column="4"
                                          Style="{StaticResource FilterTabStyle2}"
                                          Content="پرسنل و کارکنان"
                                          Tag=""
                                          HorizontalAlignment="Stretch"
                                          Click="FilterTab_Click" />

                                <Border Grid.Column="0"
                                        Background="#FFFFFF"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,4,0"
                                        Height="40"
                                        Padding="5,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch">

                                    <!-- استفاده از Grid با دو ستون -->
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <!-- ستون جعبه متن -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- ستون آیکون و خط -->
                                        </Grid.ColumnDefinitions>

                                        <!-- ❶ جعبه متن (سمت چپ) -->
                                        <Grid Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Height="30">
                                            <!-- Placeholder -->
                                            <TextBlock Text="جستجو در نام ، شماره موبایل"
                                                       FontSize="12"
                                                       Foreground="#94A3B8"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FlowDirection="RightToLeft"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Panel.ZIndex="1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- TextBox -->
                                            <TextBox x:Name="SearchBox"
                                                     Height="30"
                                                     FontSize="12"
                                                     Foreground="#1F2937"
                                                     CaretBrush="#3B82F6"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0,2"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     FlowDirection="RightToLeft"
                                                     FontFamily="{StaticResource IRANSans}"
                                                     TextAlignment="Left">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderThickness="0"
                                                                            CornerRadius="4">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                                      Focusable="False"
                                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                                      VerticalScrollBarVisibility="Hidden" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <!-- ❷ آیکون و خط جداکننده (سمت راست) -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                 >
                                            <Border Width="1"
                                                    Height="14"
                                                    Background="#BED1FF"
                                                    VerticalAlignment="Center" />
                                            <svg:SvgViewbox Width="14"
                                                            Height="14"
                                                            FlowDirection="LeftToRight"
                                                            Source="/Assets/Icons/search.svg"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                    </Border>
                </Grid>
                    </Border>

                    <!-- ═══ DataGrid ═══ -->
                        <Grid x:Name="DataGridContainer"
                              Grid.Row="1">
                            <Border x:Name="DataGridBorder"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    Margin="5,0,10,8"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Clip>
                                    <RectangleGeometry x:Name="DataGridClipGeometry"
                                                       RadiusX="4"
                                                       RadiusY="4" />
                                </Border.Clip>
                                <DataGrid x:Name="PersonsDataGrid"
                                          VerticalAlignment="Top"
                                          MaxHeight="{Binding ActualHeight, ElementName=DataGridBorder}"
                                          CanUserSortColumns="False"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          VerticalGridLinesBrush="#E5E7EB"
                                          HorizontalGridLinesBrush="Transparent"
                                          RowHeight="36"
                                          Background="White"
                                          BorderBrush="Transparent"
                                          BorderThickness="0,0,0,0"
                                          Margin="0,0,-1,0"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          SelectionMode="Extended"
                                          AlternationCount="2"
                                          IsReadOnly="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                  FontFamily="{StaticResource IRANSans}"
                  SelectionChanged="PersonsDataGrid_SelectionChanged"
                  MouseDoubleClick="PersonsDataGrid_MouseDoubleClick">


                                    <DataGrid.Resources>
                                        <Style TargetType="ScrollBar"
                                               BasedOn="{StaticResource MinimalScrollBar}" />

                                <!-- استایل متن ستون‌ها -->
                                <Style x:Key="BaseTextColumnStyle"
                                       TargetType="TextBlock">
                                    <Setter Property="FontFamily"
                                            Value="{StaticResource IRANSans}" />
                                    <Setter Property="FontSize"
                                            Value="13" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                    <Setter Property="Foreground"
                                            Value="#374151" />
                                </Style>

                                <Style x:Key="LtrTextColumnStyle"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource BaseTextColumnStyle}">
                                    <Setter Property="FlowDirection"
                                            Value="LeftToRight" />
                                </Style>

                                <Style x:Key="RowNumberColumnStyle"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource BaseTextColumnStyle}">
                                    <Setter Property="Foreground"
                                            Value="#9CA3AF" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                </Style>

                                <Style x:Key="FullNameColumnStyle"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource BaseTextColumnStyle}">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right" />
                                    <Setter Property="FontWeight"
                                            Value="Medium" />
                                    <Setter Property="Foreground"
                                            Value="#1F2937" />
                                </Style>

                                <!-- ═══ استایل هدر (سرستون) ═══ -->
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"
                                            Value="#FFFFFF" />
                                    <Setter Property="Foreground"
                                            Value="#1F2937" />
                                    <Setter Property="FontSize"
                                            Value="13" />
                                    <Setter Property="FontWeight"
                                            Value="SemiBold" />
                                    <Setter Property="FontFamily"
                                            Value="{StaticResource IRANSans}" />
                                    <Setter Property="Padding"
                                            Value="10,0" />
                                    <Setter Property="BorderBrush"
                                            Value="#E5E7EB" />
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,0" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center" />
                                    <Setter Property="Height"
                                            Value="44" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="0,0,1,1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <!-- ═══ استایل سلول ═══ -->
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background"
                                            Value="Transparent" />
                                    <Setter Property="Foreground"
                                            Value="#374151" />
                                    <Setter Property="FontSize"
                                            Value="13" />
                                    <Setter Property="BorderThickness"
                                            Value="0" />
                                    <Setter Property="Padding"
                                            Value="8,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Transparent" />
                                            <Setter Property="Foreground"
                                                    Value="#1F2937" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <!-- ═══ استایل ردیف ═══ -->
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background"
                                            Value="White" />
                                    <Setter Property="Cursor"
                                            Value="Hand" />
                                    <Setter Property="Height"
                                            Value="36" />
                                    <Setter Property="Focusable"
                                            Value="False" />
                                    <Setter Property="SnapsToDevicePixels"
                                            Value="True" />
                                    <Setter Property="UseLayoutRounding"
                                            Value="True" />

                                    <EventSetter Event="PreviewMouseLeftButtonDown"
                                                 Handler="DataGridRow_PreviewMouseLeftButtonDown" />
                                    <EventSetter Event="MouseLeftButtonDown"
                                                 Handler="DataGridRow_MouseLeftButtonDown" />

                                    <Style.Triggers>
                                        <Trigger Property="AlternationIndex"
                                                 Value="1">
                                            <Setter Property="Background"
                                                    Value="#F8F8F8" />
                                        </Trigger>

                                        <!-- هاور: از همون رنگی که برای انتخاب استفاده می‌کردیم -->
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#EFF6FF" />
                                        </Trigger>

                                        <!-- ردیف‌های خالی همیشه سفید بمونن -->
                                        <DataTrigger Binding="{Binding IsEmpty}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="White" />
                                            <Setter Property="Cursor"
                                                    Value="Arrow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- 1️⃣ چک‌باکس -->
                                <DataGridTemplateColumn Header=""
                                                        Width="55">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CheckBoxBorder"
                                                    Width="20"
                                                    Height="20"
                                                    CornerRadius="5"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonUp="CheckBoxBorder_MouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="#FFFFFF" />
                                                        <Setter Property="BorderBrush"
                                                                Value="#CBD5E1" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#2667FF" />
                                                                <Setter Property="BorderBrush"
                                                                        Value="#2667FF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEmpty}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver"
                                                                     Value="True">
                                                                <Setter Property="BorderBrush"
                                                                        Value="#2667FF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <svg:SvgViewbox x:Name="CheckMark"
                                                                Width="18"
                                                                Height="18"
                                                                Source="/Assets/Icons/Check.svg"
                                                                FlowDirection="LeftToRight"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                    <svg:SvgViewbox.Style>
                                                        <Style TargetType="svg:SvgViewbox">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </svg:SvgViewbox.Style>
                                                </svg:SvgViewbox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 2️⃣ ردیف (#) -->
                                <DataGridTextColumn Header="#"
                                                    Width="50"
                                                    Binding="{Binding RowNumberDisplay}"
                                                    ElementStyle="{StaticResource RowNumberColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                <!-- 3️⃣ کد یکتا -->
                                <DataGridTextColumn Header="کد یکتا"
                                                    Width="100"
                                                    Binding="{Binding Code}"
                                                    ElementStyle="{StaticResource BaseTextColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                <!-- 4️⃣ نام کامل / شرکت -->
                                <DataGridTextColumn Header="نام کامل / شرکت"
                                                    Width="180"
                                                    Binding="{Binding FullName}"
                                                    ElementStyle="{StaticResource FullNameColumnStyle}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="BorderThickness"
                                                    Value="0,0,1,2" />
                                            <Setter Property="BorderBrush"
                                                    Value="#E0E7FF" />
                                        </Style>
