<UserControl x:Class="Taadol.Views.CompanyListView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              xmlns:controls="clr-namespace:Taadol.Controls"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:local="clr-namespace:Taadol.Views"
              mc:Ignorable="d"
              FlowDirection="RightToLeft"
              Loaded="UserControl_Loaded"
              Padding="0"
              FontFamily="{StaticResource IRANSans}"
              Background="Transparent">

    <Border Margin="0"
            Background="White"
            CornerRadius="4"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="0,12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#E5E7EB"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Cursor="Hand"
                                Background="Transparent"
                                Margin="20,0,10,0"
                                MouseLeftButtonDown="HeaderClose_Click">
                            <svg:SvgViewbox FlowDirection="LeftToRight"
                                            Width="14"
                                            Height="14"
                                            Source="/Assets/Icons/closeTHIN.svg" />
                        </Border>

                        <TextBlock Text="لیست شرکت‌ها"
                                   FontSize="20"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">

                        <controls:ActionButton Text="حذف"
                                               TextColor="#DC2626"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/trash.svg"
                                               Margin="10,0,0,0"
                                               Click="BtnDelete_Click" />

                        <controls:ActionButton Text="چاپ"
                                               TextColor="#2563EB"
                                               BorderColor="#E9F0FF"
                                               IconPath="/Assets/Icons/printer.svg"
                                               Margin="6,0,0,0"
                                               Click="BtnPrint_Click" />

                        <controls:ActionButton Text="Excel"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="PDF"
                                               TextColor="#374151"
                                               BorderColor="#E5E7EB"
                                               Margin="6,0,0,0" />

                        <controls:ActionButton Text="بروزرسانی"
                                               TextColor="#2563EB"
                                               IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                               Margin="6,0,0,0"

                                               Click="BtnRefresh_Click" />

                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="6"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">

                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,0"
                    Background="#ffffff"
                    Padding="15,6,10,6"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"
                                          MinWidth="120" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                        <ColumnDefinition Width="*"
                                          MinWidth="70" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBoxControl x:Name="CompanySearchBox"
                                               Grid.Column="0"
                                               Margin="0,0,4,0"
                                               Placeholder="جستجو در عنوان ، نام حقوقی" />

                    <ToggleButton x:Name="tabAll"
                                  Grid.Column="1"
                                  Style="{StaticResource FilterTabStyle2}"
                                  controls:FilterTabBehavior.ShowClose="False"
                                  Content="همه شرکت‌ها"
                                  Tag="()"
                                  IsChecked="True"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabActive"
                                  Grid.Column="2"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="فعال"
                                  Tag="()"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />

                    <ToggleButton x:Name="tabInactive"
                                  Grid.Column="3"
                                  Style="{StaticResource FilterTabStyle2}"
                                  Content="غیرفعال"
                                  Tag="()"
                                  HorizontalAlignment="Stretch"
                                  Click="FilterTab_Click"
                                  Margin="4,0,0,0" />
                </Grid>
            </Border>

                        <Border Grid.Row="2"
                    Background="Transparent"
                    ClipToBounds="False"
                    Padding="15,0,0,0">
                <controls:UnifiedListView x:Name="CompaniesGrid"
                                           Padding="0,0,10,0">
                    <controls:UnifiedListView.Columns>

                        <DataGridTextColumn Header="عنوان شرکت" Width="1.5*" MinWidth="170"
                                            Binding="{Binding Title}"
                                            ElementStyle="{StaticResource FullNameColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="عنوان شرکت"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="TitleFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="نام حقوقی" Width="1*" MinWidth="180"
                                            Binding="{Binding LegalName}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource UnifiedGridCellStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="وضعیت" Width="90" MinWidth="80">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="وضعیت"
                                                   FontFamily="{StaticResource IRANSans}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />
                                        <Button Click="StatusFilter_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Padding="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <svg:SvgViewbox Width="12" Height="12"
                                                                        Source="/Assets/Icons/Filter.svg"
                                                                        VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                        <Setter Property="Background" Value="#E0FBEC" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                        <Setter Property="Background" Value="#E5E7EC" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   FontFamily="{StaticResource IRANSans}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="فعال">
                                                            <Setter Property="Foreground" Value="#02A844" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="غیرفعال">
                                                            <Setter Property="Foreground" Value="#66718E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="تاریخ ثبت" Width="120" MinWidth="110"
                                            Binding="{Binding RegisterDate}"
                                            ElementStyle="{StaticResource BaseTextColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </controls:UnifiedListView.Columns>
                </controls:UnifiedListView>
            </Border>

            <controls:ListSummaryBar x:Name="CompanySummaryBar"
                                     Grid.Row="3"
                                     Margin="0,0" />
        </Grid>
    </Border>
</UserControl>