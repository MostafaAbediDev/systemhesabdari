<UserControl x:Class="Taadol.Views.EditCompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <Border x:Name="RootBorder"
            CornerRadius="4"
            ClipToBounds="True"
            Background="#ffffff"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Margin="0">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Cursor="Hand"
                            Background="Transparent"
                            Margin="10,0,10,0"
                            MouseLeftButtonDown="CloseButton_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="14"
                                        Height="14"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="ویرایش شرکت"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="#0D2159"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    Margin="7,0,7,2"
                    VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,10,1"
                                 ViewportUnits="Absolute"
                                 Viewbox="0,0,10,1"
                                 ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10"
                                  Height="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="5" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="#D4E0FF" />
                                <Rectangle Grid.Column="1"
                                           Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,24,0">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="نام شرکت / کسب و کار" /><Run Text=" *" Foreground="#DC2626" />
                                </TextBlock>
                                <controls:ModernPersianTextBox Width="350"
                                                               Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="ایران خودرو" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="40,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="وضعیت"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ActiveToggleControl x:Name="CompanyActiveToggle"
                                                              Label="شرکت فعال است"
                                                              IsChecked="{Binding IsActive, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="نام رسمی ثبتی" /><Run Text=" *" Foreground="#DC2626" />
                                </TextBlock>
                                <controls:ModernPersianTextBox Width="350"
                                                               Text="{Binding OfficialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="ایران خودرو" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="40,0,0,0">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="تاریخ تاسیس" /><Run Text=" *" Foreground="#DC2626" />
                                </TextBlock>
                                <controls:PersianDatePickerControl x:Name="FoundingDatePicker"
                                                                   DateChanged="DatePicker_DateChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                        <controls:ImagePickerControl x:Name="CompanyImagePicker"
                                                     Margin="0,0,10,0"
                                                     FlowDirection="LeftToRight"
                                                     PlaceholderIconSource="/Assets/Icons/Scale.svg"
                                                     AddLabel="انتخاب تصویر"
                                                     RemoveLabel="حذف"
                                                     ImageSelected="OnImageSelected"
                                                     ImageRemoved="OnImageRemoved" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,0,0,2">
                <Border Height="3"
                        Margin="12,0,12,2">
                    <Border.Background>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,10,1"
                                     ViewportUnits="Absolute"
                                     Viewbox="0,0,10,1"
                                     ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10"
                                      Height="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0"
                                               Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1"
                                               Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#66000000"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#66000000"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <Grid Grid.Row="3" />

            <Border Grid.Row="4"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:CustomOutlinedButton Grid.Column="0"
                                                   x:Name="SaveButton"
                                                   Text="ویرایش"
                                                   Width="150"
                                                   Margin="0,0,5,0"
                                                   Height="44"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding SaveCommand}">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/editblue.svg"
                                            Width="18"
                                            Margin="0,0,5,0"
                                            FlowDirection="LeftToRight"
                                            Height="18" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Background="Transparent"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                MouseLeftButtonUp="Cancel_Click">
                        <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                        Width="14"
                                        Height="14"
                                        FlowDirection="LeftToRight"
                                        Margin="6,0,15,0" />
                        <TextBlock Text="انصراف"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   Foreground="#2667FF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
