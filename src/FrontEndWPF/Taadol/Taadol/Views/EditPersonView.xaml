<UserControl x:Class="Taadol.Views.EditPersonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:local="clr-namespace:Taadol.Views"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             VerticalAlignment="Center"
             HorizontalAlignment="Center"
             Background="Transparent">

    <UserControl.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <DataTemplate x:Key="BankAccountTemplate">
            <Border BorderBrush="#E0E0E0"
                    BorderThickness="0,1,0,0"
                    Padding="0,15,0,15"
                    Margin="0,5,0,5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="نام بانک"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           Text="{Binding BankName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="ملت" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="شعبه"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      Style="{StaticResource SearchableComboBox}"
                                      Tag="جستجو..."
                                      ItemsSource="{Binding DataContext.BankBranches, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="BranchName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding BankBranchId, Mode=TwoWay}"
                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">
                            <ToggleButton Content="حساب پیش فرض"
                                          FlowDirection="LeftToRight"
                                          Style="{StaticResource StatusToggleButton}"
                                          IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                          Margin="0,0,10,0" />
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="5,0,0,0"
                                    ToolTip="حذف"
                                    Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </ControlTemplate>
                                </Button.Template>
                                <svg:SvgViewbox Width="16"
                                                Height="16"
                                                Source="/Assets/Icons/trash.svg" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="شماره کارت"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           FlowDirection="LeftToRight"
                                                           InputType="Number"
                                                           MaxLength="16"
                                                           Text="{Binding CardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="**** **** **** ****" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="شماره شبا"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           FlowDirection="LeftToRight"
                                                           InputType="Number"
                                                           MaxLength="24"
                                                           Text="{Binding Shaba, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="IR" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="شماره حساب"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           FlowDirection="LeftToRight"
                                                           InputType="Number"
                                                           Text="{Binding AccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="456" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════
         ساختار اصلی: Grid با 4 ردیف (بدون تب بار)
         ردیف 0: هدر (ثابت)
         ردیف 1: CardPanel اصلی (ثابت)
         ردیف 2: جداکننده دکمه‌ای (ثابت)
         ردیف 3: محتوای کامل (اسکرول‌پذیر، زیر هم)
    ════════════════════════════════════════════════════ -->
    <Border x:Name="RootBorder"
            CornerRadius="12"
            ClipToBounds="True"
            Background="#ffffff"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Margin="0"
            SizeChanged="RootBorder_SizeChanged">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ ردیف 0: هدر ═══ -->
            <Grid Grid.Row="0"
                  Margin="10,15,10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <svg:SvgViewbox FlowDirection="LeftToRight"
                                    Width="14"
                                    Height="14"
                                    Source="/Assets/Icons/arrow-right.svg"
                                    Margin="10,0,10,0" />
                    <TextBlock Text="مشخصات شخص"
                               FontSize="18"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <controls:CustomOutlinedButton Text="ویرایش"
                                                   Width="111"
                                                   Margin="0,0,5,0"
                                                   Height="44"
                                                   Command="{Binding SaveCommand}">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/editblue.svg"
                                            Width="18"
                                            Margin="0,0,5,0"
                                            FlowDirection="LeftToRight"
                                            Height="18" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    Margin="7,0,7,2"
                    VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,10,1"
                                 ViewportUnits="Absolute"
                                 Viewbox="0,0,10,1"
                                 ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10"
                                  Height="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="5" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="#D4E0FF" />
                                <Rectangle Grid.Column="1"
                                           Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <!-- ═══ ردیف 1: CardPanel اصلی ═══ -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,24,0">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="شناسه یکتا"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ToggleSwitch2Control x:Name="CodeModeToggle"
                                                           Grid.Row="0" Grid.Column="0"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,0,5"
                                                           FirstLabel="خودکار"
                                                           SecondLabel="دستی"
                                                           IsFirstSelected="False"
                                                           SelectionChanged="CodeModeToggle_SelectionChanged" />

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Text="انتخاب شعبه"
                                       Style="{StaticResource FormLabel}" />

                            <controls:ModernPersianTextBox Grid.Row="1" Grid.Column="0"
                                                           x:Name="ManualCodeTextBox"
                                                           InputType="Alphanumeric"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding ManualCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           IsEnabled="False"
                                                           Placeholder="1234" />

                            <Grid Grid.Row="1" Grid.Column="1"
                                  Margin="12,0,0,0">
                                <ComboBox x:Name="BranchCombo"
                                          Style="{StaticResource SearchableComboBox}"
                                          Tag="جستجو..."
                                          ItemsSource="{Binding Branches}"
                                          DisplayMemberPath="Title"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedBranchId, Mode=TwoWay}"
                                          ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="625" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,5,0,10">
                                <TextBlock Text="نوع شخص"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ToggleSwitch2Control x:Name="LegalTypeToggle"
                                                              FirstLabel="حقیقی"
                                                              SecondLabel="حقوقی"
                                                              IsFirstSelected="True"
                                                              Grid.Column="1"
                                                              Margin="9,0,0,0"
                                                              SelectionChanged="LegalTypeToggle_SelectionChanged" />
                                <Border Width="0.6"
                                        Height="27"
                                        Margin="20,0,9,0"
                                        Background="#BED1FF"
                                        VerticalAlignment="Center" />
                                <controls:ActiveToggleControl x:Name="PersonActiveToggle"
                                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                              Margin="9,0,0,0"
                                                              Label="فعال شدن شخص"
                                                              />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,5,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        x:Name="FirstNamePanel">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <controls:ModernPersianTextBox x:Name="FirstNameInput"
                                                                 InputType="Letters"
                                                                 Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Placeholder="علی" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        x:Name="LastNamePanel">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام خانوادگی"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <controls:ModernPersianTextBox x:Name="LastNameInput"
                                                                 InputType="Letters"
                                                                 Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Placeholder="علوی" />
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        x:Name="NationalCodePanel">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="کد ملی"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <controls:ModernPersianTextBox x:Name="NationalCodeInput"
                                                                 InputType="Number"
                                                                 MaxLength="10"
                                                                 FlowDirection="LeftToRight"
                                                                 Text="{Binding NationalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Placeholder="2470545256" />
                            </StackPanel>

                            <StackPanel Grid.Column="0"
                                        x:Name="CompanyNamePanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="نام شرکت"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ModernPersianTextBox Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="شرکت نمونه" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        x:Name="EconomicCodePanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="کد اقتصادی"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ModernPersianTextBox FlowDirection="LeftToRight"
                                                               Text="{Binding EconomicCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="123456789" />
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        x:Name="RegistrationNumberPanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="شماره ثبت"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ModernPersianTextBox FlowDirection="LeftToRight"
                                                               Text="{Binding RegistrationNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="12345" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ContactPersonPanel"
                              Margin="0,5,0,4"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نام فرد رابط"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ModernPersianTextBox Text="{Binding ContactFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="علی" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="نام خانوادگی فرد رابط"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ModernPersianTextBox Text="{Binding ContactLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="رضایی" />
                            </StackPanel>
                        </Grid>

                        <Grid HorizontalAlignment="Left"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Margin="0"
                                       Text="نوع دسته بندی"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Margin="0"
                                       Text="دسته بندی اشخاص"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Bottom" />

                            <Border Grid.Row="1" Grid.Column="0"
                                    CornerRadius="4"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Padding="10,7"
                                    VerticalAlignment="Bottom"
                                    Background="White">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="PersonTypeCustomer"
                                                  Content="مشتری"
                                                  Tag="1"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="True"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0,0,8,0" />
                                    <ToggleButton x:Name="PersonTypeSupplier"
                                                  Content="تامین کننده"
                                                  Tag="3"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="False"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0,0,8,0" />
                                    <ToggleButton x:Name="PersonTypeBoth"
                                                  Content="هردو"
                                                  Tag="1"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="False"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0,0,8,0" />
                                    <ToggleButton x:Name="PersonTypePersonnel"
                                                  Content="پرسنل"
                                                  Tag="2"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="False"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0" />
                                </StackPanel>
                            </Border>

                            <controls:CategorySearchControl Grid.Row="1" Grid.Column="2"
                                                            x:Name="CategorySearch"
                                                            HeaderText=""
                                                            Width="350"
                                                            VerticalAlignment="Bottom"
                                                            MainIconSource="/Assets/Icons/custom_icon.svg" />
                        </Grid>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Top">
                        <controls:ImagePickerControl x:Name="PersonImagePicker"
                                                     Margin="0,0,10,0"
                                                     ImageSelected="OnImageSelected"
                                                     FlowDirection="LeftToRight"
                                                     ImageRemoved="OnImageRemoved"
                                                     Loaded="ImagePickerControl_Loaded" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ ردیف 2: جداکننده دکمه‌ای ═══ -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,2">
                <Border Height="3"
                        Margin="12,0,12,2">
                    <Border.Background>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,10,1"
                                     ViewportUnits="Absolute"
                                     Viewbox="0,0,10,1"
                                     ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10"
                                      Height="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0"
                                               Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1"
                                               Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#66000000"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#66000000"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <!-- ═══ ردیف 3: محتوای کامل (زیر هم، با اسکرول) ═══ -->
            <ScrollViewer Grid.Row="3"
                          Style="{StaticResource MinimalScrollViewer}"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,0">
                <Border Background="Transparent"
                        Padding="0,0,0,16">
                    <StackPanel>

                        <!-- ═══ بخش تماس و آدرس ═══ -->
                        <Border Style="{StaticResource CardPanel}"
                                Margin="4,0,8,12">
                            <StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <!-- ردیف اول: تلفن - موبایل - ایمیل - کد پستی -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FormLabel}">
                                                    <Run Text="شماره تلفن" /><Run Text=" *" Foreground="#DC2626" />
                                                </TextBlock>
                                                <controls:ModernPersianTextBox Width="200"
                                                                               InputType="Number"
                                                                               MaxLength="11"
                                                                               FlowDirection="RightToLeft"
                                                                               Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               Placeholder="071" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FormLabel}">
                                                    <Run Text="موبایل" /><Run Text=" *" Foreground="#DC2626" />
                                                </TextBlock>
                                                <controls:ModernPersianTextBox Width="200"
                                                                               InputType="Number"
                                                                               MaxLength="11"
                                                                               FlowDirection="RightToLeft"
                                                                               Text="{Binding Mobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               Placeholder="0912" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="ایمیل"
                                                           Style="{StaticResource FormLabel}" />
                                                <controls:ModernPersianTextBox Width="280"
                                                                               InputType="Email"
                                                                               FlowDirection="LeftToRight"
                                                                               Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               Placeholder="@gmail.com" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6"
                                                        HorizontalAlignment="Left">
                                                <TextBlock Text="کد پستی"
                                                           Style="{StaticResource FormLabel}" />
                                                <controls:ModernPersianTextBox Width="200"
                                                                               HorizontalAlignment="Left"
                                                                               InputType="Number"
                                                                               FlowDirection="LeftToRight"
                                                                               Text="{Binding PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               Placeholder="1234567890" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- ردیف دوم: استان - شهرستان - آدرس -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FormLabel}">
                                                    <Run Text="استان" /><Run Text=" *" Foreground="#DC2626" />
                                                </TextBlock>
                                                <ComboBox x:Name="ProvinceCombo"
                                                          Style="{StaticResource SearchableComboBox}"
                                                          Tag="جستجو"
                                                          Width="200"
                                                          HorizontalAlignment="Left"
                                                          ItemsSource="{Binding Provinces}"
                                                          DisplayMemberPath="Title"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding SelectedProvinceId, Mode=TwoWay}"
                                                          ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FormLabel}">
                                                    <Run Text="شهرستان" /><Run Text=" *" Foreground="#DC2626" />
                                                </TextBlock>
                                                <ComboBox x:Name="CityCombo"
                                                          Style="{StaticResource SearchableComboBox}"
                                                          Tag="جستجو..."
                                                          Width="200"
                                                          HorizontalAlignment="Left"
                                                          ItemsSource="{Binding Cities}"
                                                          DisplayMemberPath="Title"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding SelectedCityId, Mode=TwoWay}"
                                                          ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4"
                                                        HorizontalAlignment="Stretch">
                                                <TextBlock Text="آدرس"
                                                           Style="{StaticResource FormLabel}"
                                                           HorizontalAlignment="Left" />
                                                <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                                               Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                               Placeholder="" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ بخش حساب‌های بانکی ═══ -->
                        <Border Style="{StaticResource CardPanel}"
                                Margin="12,0,12,12"
                                Padding="15,0,15,0"
                                BorderBrush="#E0E7FF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>

                                <!-- فرم ورود اطلاعات حساب -->
                                <Grid Margin="0,8,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ردیف اول: نام بانک + نام شعبه + شماره کارت + حساب پیش‌فرض -->
                                    <StackPanel Grid.Row="0"
                                                Margin="0,0,0,10"
                                                Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام بانک" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                        <controls:ModernPersianTextBox x:Name="BankNameInput"
                                                                       HorizontalAlignment="Stretch"
                                                                       Placeholder="ملت" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2">
                                        <TextBlock Text="نام شعبه"
                                                   Style="{StaticResource FormLabel}" />
                                        <ComboBox x:Name="BankBranchCombo"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  Tag="جستجو..."
                                                  ItemsSource="{Binding BankBranches}"
                                                  DisplayMemberPath="BranchName"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedBankBranchId, Mode=TwoWay}"
                                                  ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="4">
                                        <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره کارت" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                        <controls:ModernPersianTextBox x:Name="CardNumberInput"
                                                                       HorizontalAlignment="Stretch"
                                                                       InputType="Number"
                                                                       FlowDirection="LeftToRight"
                                                                       Placeholder="**** **** **** ****" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="6"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,20">
                                        <ToggleButton x:Name="DefaultAccountToggle"
                                                      Content="حساب پیش فرض"
                                                      FlowDirection="LeftToRight"
                                                      Style="{StaticResource StatusToggleButton}"
                                                      IsChecked="True" />
                                    </StackPanel>

                                    <!-- ردیف دوم: شماره حساب + شماره شبا + دکمه افزودن -->
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره حساب" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                        <controls:ModernPersianTextBox x:Name="AccountNumberInput"
                                                                       HorizontalAlignment="Stretch"
                                                                       InputType="Number"
                                                                       FlowDirection="LeftToRight"
                                                                       Placeholder="456" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره شبا" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                        <controls:ModernPersianTextBox x:Name="ShabaInput"
                                                                       HorizontalAlignment="Stretch"
                                                                       InputType="Number"
                                                                       MaxLength="24"
                                                                       FlowDirection="LeftToRight"
                                                                       Placeholder="IR" />
                                    </StackPanel>

                                    <!-- دکمه افزودن -->
                                    <Border Grid.Row="1"
                                            Margin="0,0,0,5"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="7"
                                            CornerRadius="4"
                                            BorderBrush="#2667FF"
                                            BorderThickness="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Cursor="Hand"
                                            Background="Transparent">
                                        <Button x:Name="AddBankToTableButton"
                                                Click="AddBankToTableButton_Click"
                                                Padding="16,8"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <svg:SvgViewbox Width="9"
                                                                Height="9"
                                                                Margin="0,0,12,0"
                                                                Source="Assets/Icons/Plus_thin.svg"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                <TextBlock Text="افزودن به حساب های بانکی"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="#2667FF"
                                                           FontFamily="{StaticResource IRANSans}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>

                                <!-- جدول حساب‌های بانکی -->
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        x:Name="TableContainerBorder"
                                        SizeChanged="TableContainerBorder_SizeChanged"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding BankAccounts.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CountToVisibilityConverter}}">
                                    <Grid FlowDirection="RightToLeft">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- ============ هدر جدول ============ -->
                                        <Grid Grid.Row="0"
                                              Background="Transparent"
                                              Height="44">
                                            <Grid.ColumnDefinitions>
                                                <!-- # -->
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="1" />
                                                <!-- نام بانک -->
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1" />
                                                <!-- نام شعبه -->
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1" />
                                                <!-- شماره کارت -->
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="1" />
                                                <!-- شماره شبا -->
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="1" />
                                                <!-- شماره حساب -->
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="1" />
                                                <!-- پیش فرض -->
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="1" />
                                                <!-- عملیات -->
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>

                                            <!-- عناوین -->
                                            <TextBlock Grid.Column="0"
                                                       Text="#"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="نام بانک"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4"
                                                       Text="نام شعبه"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6"
                                                       Text="شماره کارت"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="8"
                                                       Text="شماره شبا"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="10"
                                                       Text="شماره حساب"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="12"
                                                       Text="پیش فرض"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="14"
                                                       Text="عملیات"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                            <!-- خطوط عمودی جداکننده -->
                                            <Border Grid.Column="1" Background="#E5E7EB" />
                                            <Border Grid.Column="3" Background="#E5E7EB" />
                                            <Border Grid.Column="5" Background="#E5E7EB" />
                                            <Border Grid.Column="7" Background="#E5E7EB" />
                                            <Border Grid.Column="9" Background="#E5E7EB" />
                                            <Border Grid.Column="11" Background="#E5E7EB" />
                                            <Border Grid.Column="13" Background="#E5E7EB" />

                                            <!-- خط افقی زیر هدر -->
                                            <Border Grid.ColumnSpan="15"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="0,0,0,1"
                                                    VerticalAlignment="Bottom" />
                                        </Grid>

                                        <!-- ============ ردیف‌های داده ============ -->
                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding BankAccounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB"
                                                            BorderThickness="0,0,0,1">
                                                    <Grid Background="White"
                                                          Height="36">
                                                        <Grid.ColumnDefinitions>
                                                            <!-- # -->
                                                            <ColumnDefinition Width="35" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- نام بانک -->
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- نام شعبه -->
                                                            <ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- شماره کارت -->
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- شماره شبا -->
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- شماره حساب -->
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- پیش فرض -->
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="1" />
                                                            <!-- عملیات -->
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- # -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Index}"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#9CA3AF"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="1" Background="#E5E7EB" />

                                                        <!-- نام بانک -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding BankName}"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   FontSize="13"
                                                                   Foreground="#374151"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="3" Background="#E5E7EB" />

                                                        <!-- نام شعبه -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding BranchName}"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   FontSize="13"
                                                                   Foreground="#374151"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="5" Background="#E5E7EB" />

                                                        <!-- شماره کارت -->
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding CardNumber}"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   FontSize="13"
                                                                   Foreground="#374151"
                                                                   FlowDirection="LeftToRight"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="7" Background="#E5E7EB" />

                                                        <!-- شماره شبا -->
                                                        <TextBlock Grid.Column="8"
                                                                   Text="{Binding Shaba}"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   FontSize="13"
                                                                   Foreground="#374151"
                                                                   FlowDirection="LeftToRight"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="9" Background="#E5E7EB" />

                                                        <!-- شماره حساب -->
                                                        <TextBlock Grid.Column="10"
                                                                   Text="{Binding AccountNumber}"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   FontSize="13"
                                                                   Foreground="#374151"
                                                                   FlowDirection="LeftToRight"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <Border Grid.Column="11" Background="#E5E7EB" />

                                                        <!-- پیش فرض (فقط خواندنی) -->
                                                        <Border Grid.Column="12"
                                                                Width="20"
                                                                Height="20"
                                                                CornerRadius="4"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Setter Property="Background" Value="#2667FF" />
                                                                            <Setter Property="BorderBrush" Value="#2667FF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <svg:SvgViewbox Width="8"
                                                                            Height="8"
                                                                            Source="/Assets/Icons/CHECK_w.svg"
                                                                            FlowDirection="LeftToRight"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                <svg:SvgViewbox.Style>
                                                                    <Style TargetType="svg:SvgViewbox">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </svg:SvgViewbox.Style>
                                                            </svg:SvgViewbox>
                                                        </Border>

                                                        <Border Grid.Column="13" Background="#E5E7EB" />

                                                        <!-- عملیات -->
                                                        <StackPanel Grid.Column="14"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">

                                                                <Button Tag="{Binding}"
                                                                        Click="RemoveBankAccountFromTable_Click"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        ToolTip="حذف"
                                                                        Padding="4">
                                                                    <svg:SvgViewbox Width="14"
                                                                                    Height="14"
                                                                                    Source="/Assets/Icons/trash.svg" />
                                                                </Button>
                                                                <Button Tag="{Binding}"
                                                                    Click="EditBankAccount_Click"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    ToolTip="ویرایش"
                                                                    Padding="4">
                                                                <svg:SvgViewbox Width="14" Height="14"
                                                                                FlowDirection="LeftToRight"
                                                                                    Source="/Assets/Icons/editblue.svg" />
                                                            </Button>

                                                        </StackPanel>
                                                    </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>

                        <!-- ═══ بخش مشخصات پرسونل — فقط وقتی PersonTypePersonnel فعال باشه نمایش داده می‌شه ═══ -->
                        <Border x:Name="PersonnelSection"
                                Style="{StaticResource CardPanel}"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="مشخصات پرسونل"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           FontFamily="{StaticResource IRANSans}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10"
                                      HorizontalAlignment="Left"
                                      MaxWidth="700">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <controls:CategorySearchControl x:Name="CategorySearch2"
                                                                        Width="300"
                                                                        HeaderText="دپارتمان"
                                                                        MainIconSource="/Assets/Icons/custom_icon.svg" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <controls:CategorySearchControl x:Name="CategorySearch3"
                                                                        Width="300"
                                                                        HeaderText="عنوان شغل"
                                                                        MainIconSource="/Assets/Icons/custom_icon.svg" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Margin="0,0,0,5"
                                                           Text="نوع قرارداد"
                                                           Style="{StaticResource FormLabel}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal"
                                                            Grid.Row="2">
                                                    <ToggleButton Content="رسمی"
                                                                  FlowDirection="LeftToRight"
                                                                  Style="{StaticResource StatusToggleButton}"
                                                                  IsChecked="False"
                                                                  Margin="0,0,8,0" />
                                                    <ToggleButton Content="قراردادی"
                                                                  FlowDirection="LeftToRight"
                                                                  Style="{StaticResource StatusToggleButton}"
                                                                  IsChecked="False"
                                                                  Margin="0,0,8,0" />
                                                    <ToggleButton Content="پروژه ای"
                                                                  FlowDirection="LeftToRight"
                                                                  Style="{StaticResource StatusToggleButton}"
                                                                  IsChecked="False"
                                                                  Margin="0,0,8,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="کد پرسنلی"
                                                   Style="{StaticResource FormLabel}" />
                                        <controls:ModernPersianTextBox Width="230"
                                                                       FlowDirection="LeftToRight"
                                                                       Placeholder="1234" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="شماره بیمه"
                                                   Style="{StaticResource FormLabel}" />
                                        <controls:ModernPersianTextBox Width="230"
                                                                       FlowDirection="LeftToRight"
                                                                       Placeholder="12345" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="حقوق پایه"
                                                   Style="{StaticResource FormLabel}" />
                                        <controls:ModernPersianTextBox Width="300"
                                                                       FlowDirection="LeftToRight"
                                                                       Placeholder="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="تاریخ استخدام"
                                                   Style="{StaticResource FormLabel}" />
                                        <controls:PersianDatePickerControl x:Name="MyDatePicker3"
                                                                           DateChanged="MyDatePicker_DateChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="تاریخ قطع همکاری"
                                                   Style="{StaticResource FormLabel}" />
                                        <controls:PersianDatePickerControl x:Name="MyDatePicker2"
                                                                           DateChanged="MyDatePicker_DateChanged" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="توضیحات"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="730"
                                                                   Placeholder=""
                                                                   HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ═══ ردیف 5: فوتر (دکمه‌ها) ═══ -->
            <Border Grid.Row="4"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- سمت راست: ویرایش شخص -->
                    <controls:CustomOutlinedButton Grid.Column="0"
                                                   Text="ویرایش"
                                                   Margin="0,0,5,0"
                                                   Height="44"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding SaveCommand}">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/editblue.svg"
                                            Width="18"
                                            Margin="0,0,5,0"
                                            FlowDirection="LeftToRight"
                                            Height="18" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>

                    <!-- سمت چپ: انصراف -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                        Width="14"
                                        Height="14"
                                        FlowDirection="LeftToRight"
                                        Margin="6,0,15,0" />
                        <TextBlock Text="انصراف"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   Foreground="#2667FF"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
