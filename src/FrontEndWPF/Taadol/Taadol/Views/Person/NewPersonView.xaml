<UserControl x:Class="Taadol.Views.NewPersonView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:controls="clr-namespace:Taadol.Controls"
              xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
              xmlns:local="clr-namespace:Taadol.Views"
              PreviewKeyDown="NewPersonView_PreviewKeyDown"
              FlowDirection="RightToLeft"
              Background="Transparent">

    <UserControl.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />

        <Style x:Key="FormLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource FormLabel}">
            <Setter Property="FontSize"
                    Value="16" />
        </Style>

        <DataTemplate x:Key="BankAccountTemplate">
            <Border BorderBrush="#E0E0E0"
                    BorderThickness="1,1,1,1"
                    CornerRadius="12"
                    Padding="10,15,10,15"
                    Margin="0,5,0,5">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="نام بانک"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           Text="{Binding BankName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="ملت" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="شعبه"
                                       Style="{StaticResource FormLabel}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      Style="{StaticResource SearchableComboBox}"
                                      Tag="جستجو..."
                                      ItemsSource="{Binding DataContext.BankBranches, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="BranchName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding BankBranchId, Mode=TwoWay}"
                                      ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                        </StackPanel>

                        <Grid Grid.Column="4"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0"
                                          Content="حساب پیش فرض"
                                          FlowDirection="LeftToRight"
                                          Style="{StaticResource StatusToggleButton}"
                                          IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                          Checked="RowDefaultToggle_Checked"
                                          HorizontalAlignment="Left" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <Button Click="AddBankAccountFromRow_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="افزودن ردیف جدید"
                                        Opacity="1"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter Content="{TemplateBinding Content}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <svg:SvgViewbox Width="18"
                                                    Height="18"
                                                    Source="/Assets/Icons/addAc.svg" />
                                </Button>
                                <Button x:Name="RemoveButton"
                                        Click="RemoveBankAccount_Click"
                                        Tag="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="10,0,0,0"
                                        ToolTip="حذف"
                                        Opacity="1"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter Content="{TemplateBinding Content}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <svg:SvgViewbox Width="16"
                                                    Height="16"
                                                    Source="/Assets/Icons/trash.svg" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="شماره کارت"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding CardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="**** **** **** ****" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="شماره شبا"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding Shaba, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="IR" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="شماره حساب"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding AccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="456" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="4"
            ClipToBounds="True"
            Background="#ffffff"
            VerticalAlignment="Stretch">

        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="10,15,10,10">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Cursor="Hand"
                            Background="Transparent"
                            Margin="10,0,10,0"
                            MouseLeftButtonDown="CloseButton_Click">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="14"
                                        Height="14"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>
                    <TextBlock Text="شخص جدید"
                               FontSize="20"
                               FontWeight="Bold"
                               FontFamily="{StaticResource IRANSans}"
                               Foreground="#0D2159"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    Margin="7,0,7,2"
                    VerticalAlignment="Bottom">
                <Border.Background>
                    <VisualBrush TileMode="Tile"
                                 Viewport="0,0,10,1"
                                 ViewportUnits="Absolute"
                                 Viewbox="0,0,10,1"
                                 ViewboxUnits="Absolute">
                        <VisualBrush.Visual>
                            <Grid Width="10"
                                  Height="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="5" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="#D4E0FF" />
                                <Rectangle Grid.Column="1"
                                           Fill="#D4E0FF" />
                            </Grid>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,24,0">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="شناسه یکتا"
                                       Style="{StaticResource FormLabel}" />
                            <controls:ToggleSwitch2Control x:Name="CodeModeToggle"
                                                           Grid.Row="0" Grid.Column="0"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,0,5"
                                                           FirstLabel="خودکار"
                                                           SecondLabel="دستی"
                                                           IsFirstSelected="True"
                                                           SelectionChanged="CodeModeToggle_SelectionChanged" />

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Text="انتخاب شعبه"
                                       Style="{StaticResource FormLabel}" />

                            <controls:ModernPersianTextBox Grid.Row="1" Grid.Column="0"
                                                           x:Name="ManualCodeTextBox"
                                                           InputType="Alphanumeric"
                                                           FlowDirection="LeftToRight"
                                                           Text="{Binding ManualCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           IsEnabled="False"
                                                           Placeholder="1234"
                                                           TextChanged="ValidationField_TextChanged" />

                            <Grid Grid.Row="1" Grid.Column="1"
                                  Margin="12,0,0,0">
                                <ComboBox x:Name="BranchCombo"
                                          Style="{StaticResource SearchableComboBox}"
                                          Tag="جستجو..."
                                          ItemsSource="{Binding Branches}"
                                          DisplayMemberPath="Title"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedBranchId, Mode=TwoWay}"
                                          ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                <Border x:Name="BranchComboLoading"
                                        Width="42" Height="42"
                                        Background="White"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        CornerRadius="8">
                                    <Grid Width="22" Height="22"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="BranchComboSpinnerRotate" Angle="0" />
                                        </Grid.RenderTransform>
                                        <Ellipse Width="20" Height="20" Stroke="#D4E0FF" StrokeThickness="3" />
                                        <Path Stroke="#2667FF" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 11,1 A 10,10 0 0 1 21,11" />
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Grid.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="BranchComboSpinnerRotate"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:0.8" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="625" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,5,0,10">
                                <TextBlock Text="نوع شخص"
                                           Style="{StaticResource FormLabel}" />
                                <controls:ToggleSwitch2Control x:Name="LegalTypeToggle"
                                                              FirstLabel="حقیقی"
                                                              SecondLabel="حقوقی"
                                                              IsFirstSelected="True"
                                                              Grid.Column="1"
                                                              Margin="9,0,0,0"
                                                              SelectionChanged="LegalTypeToggle_SelectionChanged" />
                                <Border Width="0.6"
                                        Height="27"
                                        Margin="20,0,9,0"
                                        Background="#BED1FF"
                                        VerticalAlignment="Center" />
                                <controls:ActiveToggleControl x:Name="PersonActiveToggle"
                                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                              Margin="9,0,0,0"
                                                              Label="فعال شدن شخص"
                                                              />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,2,0,10">
      <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="275" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="200" />
      </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        x:Name="FirstNamePanel">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <controls:ModernPersianTextBox x:Name="FirstNameInput"
                                                                 InputType="Letters"
                                                                 Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Placeholder="علی"
                                                                 TextChanged="ValidationField_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        x:Name="LastNamePanel">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام خانوادگی"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <controls:ModernPersianTextBox x:Name="LastNameInput"
                                                                 InputType="Letters"
                                                                 Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Placeholder="علوی"
                                                                 TextChanged="ValidationField_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        x:Name="NationalCodePanel">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="کد ملی"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                <controls:ModernPersianTextBox x:Name="NationalCodeInput"
                                                                  InputType="Number"
                                                                  MaxLength="10"
                                                                  FlowDirection="LeftToRight"
                                                                  Text="{Binding NationalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Placeholder="2470545256"
                                                                  TextChanged="ValidationField_TextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="0"
                                        x:Name="CompanyNamePanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام شرکت" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                <controls:ModernPersianTextBox Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="شرکت نمونه" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        x:Name="EconomicCodePanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="کد اقتصادی" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                <controls:ModernPersianTextBox FlowDirection="LeftToRight"
                                                               Text="{Binding EconomicCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="123456789" />
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        x:Name="RegistrationNumberPanel"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره ثبت" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                <controls:ModernPersianTextBox FlowDirection="LeftToRight"
                                                               Text="{Binding RegistrationNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="12345" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ContactPersonPanel"
                              Margin="0,2,0,2"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="355" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="355" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام فرد رابط" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                <controls:ModernPersianTextBox Text="{Binding ContactFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="علی" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام خانوادگی فرد رابط" /><Run Text=" *" Foreground="#DC2626" /></TextBlock>
                                <controls:ModernPersianTextBox Text="{Binding ContactLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Placeholder="رضایی" />
                            </StackPanel>
                        </Grid>

                        <Grid HorizontalAlignment="Left"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Margin="0"
                                       Text="نوع دسته بندی"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Margin="0"
                                       Text="دسته بندی اشخاص"
                                       Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Bottom" />

                            <Border Grid.Row="1" Grid.Column="0"
                                    CornerRadius="4"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Padding="10,7"
                                    VerticalAlignment="Bottom"
                                    Background="White">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="PersonTypeCustomer"
                                                  Content="مشتری"
                                                  Tag="1"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="True"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0,0,8,0" />
                                    <ToggleButton x:Name="PersonTypeSupplier"
                                                  Content="تامین کننده"
                                                  Tag="3"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="False"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0,0,8,0" />
                                    <ToggleButton x:Name="PersonTypeBoth"
                                                  Content="هردو"
                                                  Tag="4"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="False"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0,0,8,0" />
                                    <ToggleButton x:Name="PersonTypePersonnel"
                                                  Content="پرسنل"
                                                  Tag="2"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource PersonTypeCheckBox}"
                                                  IsChecked="False"
                                                  Checked="PersonTypeToggle_Checked"
                                                  Unchecked="PersonTypeToggle_Unchecked"
                                                  Margin="0" />
                                </StackPanel>
                            </Border>

                            <controls:CategorySearchControl Grid.Row="1" Grid.Column="2"
                                                            x:Name="CategorySearch"
                                                            HeaderText=""
                                                            Width="350"
                                                            VerticalAlignment="Bottom"
                                                            MainIconSource="/Assets/Icons/custom_icon.svg" />
                        </Grid>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                        <controls:ImagePickerControl x:Name="PersonImagePicker"
                                                     FlowDirection="LeftToRight"
                                                     ImageSelected="OnImageSelected"
                                                     ImageRemoved="OnImageRemoved" />
                        <TextBlock Text="برای بارگذاری کلیک کنید"
                                   FontSize="11"
                                   Foreground="#AFAFAF"
                                   FontFamily="{StaticResource IRANSans}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,0,0,2">
                <Border Height="3"
                        Margin="12,0,12,2">
                    <Border.Background>
                        <VisualBrush TileMode="Tile"
                                     Viewport="0,0,10,1"
                                     ViewportUnits="Absolute"
                                     Viewbox="0,0,10,1"
                                     ViewboxUnits="Absolute">
                            <VisualBrush.Visual>
                                <Grid Width="10"
                                      Height="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="5" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0"
                                               Fill="#BED1FF" />
                                    <Rectangle Grid.Column="1"
                                               Fill="Transparent" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>

                <Ellipse x:Name="DividerEllipseLeft"
                         Width="17"
                         Margin="-9,0,0,0"
                         Height="25"
                         Fill="#66000000"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
                <Ellipse x:Name="DividerEllipseRight"
                         Width="17"
                         Height="25"
                         Margin="0,0,-9,0"
                         Fill="#66000000"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Panel.ZIndex="2" />
            </Grid>

            <StackPanel Grid.Row="3"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Left">
                <Border CornerRadius="0"
                        BorderThickness="0,0,0,2"
                        BorderBrush="#E5E7EB"
                        Background="#ffffff"
                        Padding="0"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="تماس و آدرس"
                                     Style="{StaticResource ModernTabButton}"
                                     Margin="10,0,6,0"
                                     IsChecked="True"
                                     GroupName="PersonTabs"
                                     x:Name="TabPricing"
                                     Checked="TabPricing_Checked" />

                        <RadioButton Content="حساب های بانکی"
                                     Style="{StaticResource ModernTabButton}"
                                     Margin="10,0,6,0"
                                     GroupName="PersonTabs"
                                     x:Name="TabInventory"
                                     Checked="TabInventory_Checked" />

                        <RadioButton Content="مشخصات پرسونل"
                                     Visibility="Collapsed"
                                     Style="{StaticResource ModernTabButton}"
                                     Margin="10,0,6,0"
                                     GroupName="PersonTabs"
                                     x:Name="TabTax"
                                     Checked="TabTax_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="4"
                          Style="{StaticResource MinimalScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardPanel}">
                    <Grid Margin="12,0,12,0">

                        <StackPanel x:Name="PricingContent"
                                    Visibility="Visible">

                            <Grid Margin="0,0,0,16">
<Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource FormLabel}">
                <Run Text="شماره تلفن" /><Run Text=" *"
                                              Foreground="#DC2626" />
                                    </TextBlock>
                                    <controls:ModernPersianTextBox x:Name="PhoneInput"
                                                                   Width="200"
                                                                   HorizontalAlignment="Left"
                                                                   InputType="Number"
                                                                   MaxLength="11"
                                                                   FlowDirection="LeftToRight"
                                                                   Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="071" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource FormLabel}">
                <Run Text="موبایل" /><Run Text=" *"
                                          Foreground="#DC2626" />
                                    </TextBlock>
                                    <controls:ModernPersianTextBox x:Name="MobileInput"
                                                                   Width="200"
                                                                   HorizontalAlignment="Left"
                                                                   InputType="Number"
                                                                   MaxLength="11"
                                                                   FlowDirection="LeftToRight"
                                                                   Text="{Binding Mobile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="091" />
                                </StackPanel>

                                <StackPanel Grid.Column="4"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="ایمیل"
                                               Style="{StaticResource FormLabel}" />
<controls:ModernPersianTextBox x:Name="EmailInput"
                                                                    HorizontalAlignment="Left"
                                                                    InputType="Email"
                                                                    FlowDirection="LeftToRight"
                                                                    Width="280"
                                                                      Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Placeholder="@gmail.com" />
                                </StackPanel>

                                <StackPanel Grid.Column="6"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="کد پستی"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox Width="200"
                                                                   HorizontalAlignment="Left"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Text="{Binding PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="1234567890" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="4"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="آدرس"
                                               Style="{StaticResource FormLabel}"
                                               HorizontalAlignment="Left" />
                                    <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                                   Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   Placeholder="" />
                                </StackPanel>

                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource FormLabel}">
                <Run Text="استان" /><Run Text=" *"
                                         Foreground="#DC2626" />
                                    </TextBlock>
                                    <ComboBox x:Name="ProvinceCombo"
                                              Style="{StaticResource SearchableComboBox}"
                                              Tag="جستجو"
                                              Width="200"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding Provinces}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedProvinceId, Mode=TwoWay}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource FormLabel}">
                <Run Text="شهرستان" /><Run Text=" *"
                                           Foreground="#DC2626" />
                                    </TextBlock>
                                    <Grid>
                                        <ComboBox x:Name="CityCombo"
                                                  Style="{StaticResource SearchableComboBox}"
                                                  Tag="جستجو..."
                                                  Width="200"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding Cities}"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedCityId, Mode=TwoWay}"
                                                  ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                        <Border x:Name="CityBlockOverlay"
                                                Background="Transparent"
                                                Cursor="No"
                                                Visibility="Collapsed"
                                                MouseLeftButtonDown="CityBlockOverlay_MouseLeftButtonDown" />
                                    </Grid>
                                    <TextBlock x:Name="CityErrorText"
                                               Text="ابتدا استان را انتخاب کنید"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="12"
                                               Foreground="#DC2626"
                                               Margin="4,4,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="InventoryContent"
                                    Visibility="Collapsed">

                            <Grid Margin="0,8,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0"
                                            Margin="0,0,0,10"
                                            Grid.Column="0">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="نام بانک" /><Run Text=" *"
                                                                                                              Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="BankNameInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   Placeholder="ملت" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="2">
                                    <TextBlock Text="نام شعبه"
                                               Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="BankBranchCombo"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource SearchableComboBox}"
                                              Tag="جستجو..."
                                              ItemsSource="{Binding BankBranches}"
                                              DisplayMemberPath="BranchName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedBankBranchId, Mode=TwoWay}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره کارت" /><Run Text=" *"
                                                                                                                Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="CardNumberInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Margin="0,0,0,0"
                                                                   Placeholder="**** **** **** ****" />
                                </StackPanel>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="6"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,20">
                                    <ToggleButton x:Name="DefaultAccountToggle"
                                                  Content="حساب پیش فرض"
                                                  FlowDirection="LeftToRight"
                                                  Style="{StaticResource StatusToggleButton}"
                                                  IsChecked="True" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,0,0,0"
                                            Grid.Column="0">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره حساب" /><Run Text=" *"
                                                                                                                Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="AccountNumberInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="456" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره شبا" /><Run Text=" *"
                                                                                                               Foreground="#DC2626" /></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="ShabaInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   MaxLength="24"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="IR" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Margin="0,0,0,5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="7"
                                        CornerRadius="4"
                                        BorderBrush="#2667FF"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Cursor="Hand"
                                        Background="Transparent">
                                    <Button x:Name="AddBankToTableButton"
                                            Click="AddBankToTableButton_Click"
                                            Padding="16,8"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgViewbox Width="9"
                                                            Height="9"
                                                            Margin="0,0,12,0"
                                                            Source="Assets/Icons/Plus_thin.svg"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                            <TextBlock Text="افزودن به حساب های بانکی"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#2667FF"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>

                            <controls:BankAccountsTableControl x:Name="BankAccountsTable"
                                                               ItemsSource="{Binding BankAccounts}" />
                        </StackPanel>

                        <StackPanel x:Name="TaxContent"
                                    Visibility="Collapsed">
                            <Grid Margin="0,0,0,10"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">      <controls:CategorySearchControl x:Name="CategorySearch2"
                                      HorizontalAlignment="Stretch"
                                      HeaderText="دپارتمان"
                                      IsRequired="True"
                                      SearchOnDemand="True"
                                      MainIconSource="/Assets/Icons/custom_icon.svg" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">      <controls:CategorySearchControl x:Name="CategorySearch3"
                                      HorizontalAlignment="Stretch"
                                      HeaderText="عنوان شغلی"
                                      IsRequired="True"
                                      SearchOnDemand="True"
                                      MainIconSource="/Assets/Icons/custom_icon.svg" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="نوع همکاری"
                                               Style="{StaticResource FormLabel}" />
                                    <Border BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,7"
                                            Background="White">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <ToggleButton x:Name="ContractPermanent"
                                                          Content="رسمی"
                                                          Checked="ContractToggle_Checked"
                                                          FlowDirection="LeftToRight"
                                                          Style="{StaticResource StatusToggleButton}"
                                                          IsChecked="False"
                                                          Margin="0,0,8,0" />
                                            <ToggleButton x:Name="ContractContractual"
                                                          Content="قراردادی"
                                                          Checked="ContractToggle_Checked"
                                                          FlowDirection="LeftToRight"
                                                          Style="{StaticResource StatusToggleButton}"
                                                          IsChecked="False"
                                                          Margin="0,0,8,0" />
                                            <ToggleButton x:Name="ContractProject"
                                                          Content="پروژه ای"
                                                          Checked="ContractToggle_Checked"
                                                          FlowDirection="LeftToRight"
                                                          Style="{StaticResource StatusToggleButton}"
                                                          IsChecked="False" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="کد پرسنلی"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="PersonnelCodeInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="**** **** **** ****" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabel}"><Run Text="شماره بیمه"/><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                    <controls:ModernPersianTextBox x:Name="InsuranceNumberInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   Placeholder="12345" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="حقوق پایه"
                                               Style="{StaticResource FormLabel}"><Run Text=" *" Foreground="#DC2626"/></TextBlock>
                                    <controls:ModernPersianTextBox HorizontalAlignment="Stretch"
                                                                   InputType="Number"
                                                                   FlowDirection="LeftToRight"
                                                                   x:Name="BaseSalaryInput"
                                                                   Placeholder="ریال" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تاریخ استخدام"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:PersianDatePickerControl x:Name="MyDatePicker3"
                                                                       HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاریخ قطع همکاری"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:PersianDatePickerControl x:Name="MyDatePicker2"
                                                                       HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="توضیحات"
                                               Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox x:Name="DescriptionInput"
                                                                   HorizontalAlignment="Stretch"
                                                                   Placeholder="" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="5"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,4,4"
                    Background="White">
                <Grid Margin="16,10"
                      FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".40*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".30*" />
                    </Grid.ColumnDefinitions>

                    <controls:IconButton Grid.Column="0"
                                         x:Name="SaveButton"
                                         ButtonText="ذخیره شخص"
                                         IconSource="/Assets/Icons/save.svg"
                                         ButtonCommand="{Binding SavePersonCommand}"
                                         ButtonBackground="#2667FF"
                                         CornerRadius="4" />

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                            Width="14"
                                            Height="14"
                                            FlowDirection="LeftToRight"
                                            Margin="6,0,15,0" />
                            <TextBlock Text="انصراف"
                                       FontFamily="{StaticResource IRANSans}"
                                       FontSize="14"
                                       Foreground="#2667FF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <controls:CustomOutlinedButton Grid.Column="2"
                                                   Text="ذخیره موقت"
                                                   HorizontalAlignment="Stretch"
                                                   BorderBrush="#2667FF"
                                                   Foreground="#2667FF">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/Black.svg"
                                            Width="16"
                                            Height="16" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>
                </Grid>
            </Border>

        </Grid>
    </Border>

</UserControl>