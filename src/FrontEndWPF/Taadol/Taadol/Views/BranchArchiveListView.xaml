<UserControl x:Class="Taadol.Views.BranchArchiveListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1500"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Loaded="BranchArchiveListView_Loaded"
             FontFamily="{StaticResource IRANSans}"
             Background="#FFFFFF">

    <UserControl.Resources>
        <Style x:Key="EllipseLeft" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-31,0,0,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>
        <Style x:Key="EllipseRight" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-31,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="#FFFFFF"
            CornerRadius="4"
            BorderBrush="#E5E7EB"
            BorderThickness="0"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ هدر ═══ -->
            <Border Grid.Row="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="0,12"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <svg:SvgViewbox FlowDirection="LeftToRight"
                                        Width="16"
                                        Height="16"
                                        Source="/Assets/Icons/closeTHIN.svg"
                                        Margin="20,0,10,0" />
                        <TextBlock Text="آرشیو شعبه"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0D2159"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ محتویات اصلی ═══ -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ نوار فیلتر + آپلود ═══ -->
                <Border Grid.Row="0"
                        Background="#ffffff"
                        CornerRadius="8"
                        Padding="0"
                        Margin="12,0,0,0"
                        BorderBrush="#ffffff"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- فیلترها -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ردیف اول: نام شرکت + نام شعبه -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Text="نام شرکت" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="CompanyComboBox"
                                              Style="{StaticResource SearchableComboBox}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              Width="250"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedCompany}"
                                              SelectionChanged="CompanyComboBox_SelectionChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                    <TextBlock Text="نام شعبه" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="BranchComboBox"
                                              Style="{StaticResource SearchableComboBox}"
                                              ItemContainerStyle="{StaticResource SearchableComboBoxItem}"
                                              Width="300"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedBranch}"
                                              SelectionChanged="BranchComboBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>

                            <!-- ردیف دوم: عنوان فایل + توضیحات -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Text="عنوان فایل" Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox x:Name="SearchBox"
                                                                   Width="250"
                                                                   Placeholder="جستجو کنید" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                    <TextBlock Text="توضیحات" Style="{StaticResource FormLabel}" />
                                    <controls:ModernPersianTextBox x:Name="DescriptionSearchBox"
                                                                   Width="550"
                                                                   Placeholder="جستجو کنید" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- آپلود فایل سمت راست -->
                        <controls:FilePickerControl Grid.Column="2"
                                                    Margin="0,0,12,0"
                                                    FlowDirection="LeftToRight"
                                                     x:Name="FilePicker"
                                                     VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- ═══ خط جداکننده ═══ -->
                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Border Height="3">
                        <Border.Background>
                            <VisualBrush TileMode="Tile"
                                         Viewport="0,0,10,1"
                                         ViewportUnits="Absolute"
                                         Viewbox="0,0,10,1"
                                         ViewboxUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Grid Width="10" Height="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="5" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#BED1FF" />
                                        <Rectangle Grid.Column="1" Fill="Transparent" />
                                    </Grid>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse Width="17" Margin="-9,0,0,0" Height="25" Fill="#FFF8ED"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="2" />
                    <Ellipse Width="17" Height="25" Margin="0,0,-9,0" Fill="#FFF8ED"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="2" />
                </Grid>

                <!-- ═══ نوار ابزار: سرچ + دکمه‌ها ═══ -->
                <Border Grid.Row="2"
                        Background="#ffffff"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Padding="12,6,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- سرچ -->
                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,4,0"
                                Height="40"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Width="280">
                            <Grid FlowDirection="RightToLeft">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Height="30">
                                    <TextBlock Text="جستجو در عنوان ، شرکت ، شعبه"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               FontFamily="{StaticResource IRANSans}"
                                               FlowDirection="RightToLeft"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"
                                               Panel.ZIndex="1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=HeaderSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="HeaderSearchBox"
                                             Height="30"
                                             FontSize="12"
                                             Foreground="#1F2937"
                                             CaretBrush="#3B82F6"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0,2"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FlowDirection="RightToLeft"
                                             FontFamily="{StaticResource IRANSans}"
                                             TextAlignment="Left">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4">
                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                              Focusable="False"
                                                                              HorizontalScrollBarVisibility="Hidden"
                                                                              VerticalScrollBarVisibility="Hidden" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="1"
                                            Height="14"
                                            Background="#BED1FF"
                                            VerticalAlignment="Center" />
                                    <svg:SvgViewbox Width="14"
                                                    Height="14"
                                                    FlowDirection="LeftToRight"
                                                    Source="/Assets/Icons/search.svg"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- دکمه‌ها -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">
                            <controls:ActionButton Text="حذف"
                                                   TextColor="#DC2626"
                                                   BorderColor="#E9F0FF"
                                                   IconPath="/Assets/Icons/trash.svg"
                                                   Margin="10,0,0,0"
                                                   Click="BtnDelete_Click" />
                            <controls:ActionButton Text="بروزرسانی"
                                                   TextColor="#2563EB"
                                                   IconPath="/Assets/Icons/arrow-reload-horizontal-2.svg"
                                                   Margin="6,0,0,0"
                                                   Click="BtnRefresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ DataGrid ═══ -->
                <Border x:Name="DataGridBorder"
                        Grid.Row="3"
                        Background="#FFFFFF"
                        Margin="12,6,0,5"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1,1,1,1.2"
                        CornerRadius="4"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <DataGrid x:Name="ArchivesDataGrid"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              CanUserSortColumns="False"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              VerticalGridLinesBrush="#E5E7EB"
                              HorizontalGridLinesBrush="Transparent"
                              RowHeight="36"
                              Background="White"
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Extended"
                              AlternationCount="2"
                              IsReadOnly="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              FontFamily="{StaticResource IRANSans}"
                              SelectionChanged="ArchivesDataGrid_SelectionChanged"
                              MouseDoubleClick="ArchivesDataGrid_MouseDoubleClick">

                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBar}">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Height" Value="8" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="BaseTextColumnStyle" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource IRANSans}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="#374151" />
                            </Style>
                            <Style x:Key="RowNumberColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextColumnStyle}">
                                <Setter Property="Foreground" Value="#9CA3AF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style x:Key="TitleColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextColumnStyle}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Foreground" Value="#1F2937" />
                            </Style>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#1F2937" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontFamily" Value="{StaticResource IRANSans}" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="#E5E7EB" />
                                <Setter Property="BorderThickness" Value="0,0,1,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Height" Value="44" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#374151" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#1F2937" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="UseLayoutRounding" Value="True" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown" />
                                <EventSetter Event="MouseLeftButtonDown" Handler="DataGridRow_MouseLeftButtonDown" />
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F8F8F8" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- چک‌باکس -->
                            <DataGridTemplateColumn Header="" Width="55" MinWidth="50">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SelectAllBorder"
                                                Width="20" Height="20"
                                                CornerRadius="4" Cursor="Hand"
                                                BorderThickness="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#FFFFFF"
                                                BorderBrush="#CBD5E1"
                                                PreviewMouseLeftButtonDown="SelectAllBorder_PreviewMouseLeftButtonDown">
                                            <svg:SvgViewbox x:Name="SelectAllCheckMark"
                                                            Width="8" Height="8"
                                                            Source="/Assets/Icons/CHECK_w.svg"
                                                            FlowDirection="LeftToRight"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="1,0,0,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CheckBoxBorder"
                                                Width="20" Height="20"
                                                CornerRadius="4" Cursor="Hand"
                                                BorderThickness="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                PreviewMouseLeftButtonUp="CheckBoxBorder_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#2667FF" />
                                                            <Setter Property="BorderBrush" Value="#2667FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <svg:SvgViewbox x:Name="CheckMark"
                                                            Width="8" Height="8"
                                                            Source="/Assets/Icons/CHECK_w.svg"
                                                            FlowDirection="LeftToRight"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                <svg:SvgViewbox.Style>
                                                    <Style TargetType="svg:SvgViewbox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </svg:SvgViewbox.Style>
                                            </svg:SvgViewbox>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ردیف # -->
                            <DataGridTextColumn Header="#" Width="55" MinWidth="45"
                                                Binding="{Binding RowNumberDisplay}"
                                                ElementStyle="{StaticResource RowNumberColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="1,0,1,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- تاریخ بارگذاری -->
                            <DataGridTextColumn Header="تاریخ بارگذاری" Width="200" MinWidth="160"
                                                Binding="{Binding CreationDate}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- شرکت -->
                            <DataGridTextColumn Header="شرکت" Width="180" MinWidth="140"
                                                Binding="{Binding CompanyName}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- شعبه -->
                            <DataGridTextColumn Header="شعبه" Width="180" MinWidth="140"
                                                Binding="{Binding BranchTitle}"
                                                ElementStyle="{StaticResource TitleColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- عنوان فایل -->
                            <DataGridTextColumn Header="عنوان فایل" Width="200" MinWidth="160"
                                                Binding="{Binding Title}"
                                                ElementStyle="{StaticResource TitleColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- ایکون فایل -->
                            <DataGridTemplateColumn Header="فایل" Width="80" MinWidth="60">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                                        <Setter Property="BorderBrush" Value="#E0E7FF" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <svg:SvgViewbox Width="20" Height="20"
                                                        Source="{Binding FileIconSource}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- توضیحات -->
                            <DataGridTextColumn Header="توضیحات" Width="2.5*" MinWidth="200"
                                                Binding="{Binding Description}"
                                                ElementStyle="{StaticResource BaseTextColumnStyle}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,2" />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ═══ نوار خلاصه زیر گرید ═══ -->
                <Border Grid.Row="4"
                        Background="#ffffff"
                        BorderBrush="#E5E7EB"
                        x:Name="SummaryBorder"
                        BorderThickness="1"
                        Height="53"
                        CornerRadius="4"
                        Margin="0,2,0,2"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- تعداد انتخاب شده -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedSummaryText"
                                       Text="آرشیو انتخاب شده (0)"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                            <Border Width="1" Height="14" Background="#E5E7EB" Margin="8,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- تعداد کل -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="تعداد کل"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TotalCountText"
                                       Text="۰ مورد"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="#2563EB"
                                       Margin="8,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ صفحه‌بندی ═══ -->
                <Border Grid.Row="5"
                        Padding="0,5"
                        Background="White"
                        BorderBrush="#E9F0FF"
                        x:Name="PaginationBorder"
                        BorderThickness="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight">

                            <!-- دکمه‌ی قبلی (فلش) -->
                            <Button Width="26"
                                    Height="26"
                                    Margin="0,0,2,0"
                                    Cursor="Hand"
                                    Click="BtnPrevPage_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Width="26"
                                                Height="26"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1.5"
                                                CornerRadius="4">
                                            <svg:SvgViewbox x:Name="ToggleArrowIcon"
                                                            Width="7"
                                                            Height="11"
                                                            Source="/Assets/Icons/ArrowLeft.svg"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                <svg:SvgViewbox.RenderTransform>
                                                    <RotateTransform x:Name="ArrowRotation"
                                                                     Angle="0" />
                                                </svg:SvgViewbox.RenderTransform>
                                            </svg:SvgViewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Background"
                                                        Value="#F5F7FA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- دکمه‌های شماره صفحه -->
                            <ItemsControl x:Name="PageButtonsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26"
                                                Height="26"
                                                Margin="0,0,2,0"
                                                Cursor="Hand"
                                                Click="BtnPage_Click"
                                                Tag="{Binding PageNumber}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Width="26"
                                                            Height="26"
                                                            Background="White"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1.5"
                                                            CornerRadius="4">
                                                        <TextBlock Text="{Binding PageNumberDisplay}"
                                                                   FontSize="12"
                                                                   FontFamily="{StaticResource IRANSans}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="#94A3B8" />
                                                                    <Setter Property="FontWeight"
                                                                            Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground"
                                                                                    Value="#2563EB" />
                                                                            <Setter Property="FontWeight"
                                                                                    Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding PageNumberDisplay}"
                                                                     Value="...">
                                                            <Setter TargetName="bd"
                                                                    Property="BorderBrush"
                                                                    Value="Transparent" />
                                                            <Setter TargetName="bd"
                                                                    Property="Background"
                                                                    Value="Transparent" />
                                                        </DataTrigger>

                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="bd"
                                                                    Property="Background"
                                                                    Value="#F5F7FA" />
                                                        </Trigger>

                                                        <DataTrigger Binding="{Binding IsCurrent}"
                                                                     Value="True">
                                                            <Setter TargetName="bd"
                                                                    Property="BorderBrush"
                                                                    Value="#2563EB" />
                                                            <Setter TargetName="bd"
                                                                    Property="Background"
                                                                    Value="White" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- دکمه‌ی بعدی (فلش) -->
                            <Button Width="26"
                                    Height="26"
                                    Margin="0,0,0,0"
                                    Cursor="Hand"
                                    Click="BtnNextPage_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Width="26"
                                                Height="26"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1.5"
                                                CornerRadius="4">
                                            <svg:SvgViewbox x:Name="ToggleArrowIcon"
                                                            Width="7"
                                                            Height="11"
                                                            Source="/Assets/Icons/ArrowLeft.svg"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                <svg:SvgViewbox.RenderTransform>
                                                    <RotateTransform x:Name="ArrowRotation"
                                                                     Angle="180" />
                                                </svg:SvgViewbox.RenderTransform>
                                            </svg:SvgViewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Background"
                                                        Value="#F5F7FA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- ═══ نمایش X از Y مورد + انتخاب تعداد ردیف ═══ -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">

                            <controls:PageSizeSelector x:Name="PageSizeSelector"
                                                        SelectionChanged="PageSizeSelector_SelectionChanged" />

                            <TextBlock x:Name="PageInfoText"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="24,0,8,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ فوتر (دکمه‌ها) ═══ -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Background="White">
                <Grid Margin="16,10" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width=".25*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width=".15*" />
                    </Grid.ColumnDefinitions>

                    <!-- سمت راست: ذخیره -->
                    <controls:IconButton Grid.Column="0"
                                         x:Name="SaveButton"
                                         ButtonText="ذخیره"
                                         IconSource="/Assets/Icons/save.svg"
                                         ButtonCommand="{Binding SaveCommand}"
                                         ButtonBackground="#2667FF"
                                         CornerRadius="4" />

                    <!-- وسط: انصراف -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                MouseLeftButtonUp="CancelButton_Click">
                        <svg:SvgViewbox Source="/Assets/Icons/redo.svg"
                                        Width="14" Height="14"
                                        FlowDirection="LeftToRight"
                                        Margin="6,0,15,0" />
                        <TextBlock Text="انصراف"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   Foreground="#2667FF"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- سمت چپ: ذخیره موقت -->
                    <controls:CustomOutlinedButton Grid.Column="2"
                                                   Text="ذخیره موقت"
                                                   HorizontalAlignment="Stretch"
                                                   BorderBrush="#2667FF"
                                                   Foreground="#2667FF">
                        <controls:CustomOutlinedButton.Icon>
                            <svg:SvgViewbox Source="/Assets/Icons/Black.svg"
                                            Width="16" Height="16" />
                        </controls:CustomOutlinedButton.Icon>
                    </controls:CustomOutlinedButton>
                </Grid>
            </Border>

            <!-- ═══ Loading Overlay ═══ -->
            <Border x:Name="LoadingOverlay"
                    Grid.Row="0" Grid.RowSpan="3"
                    Background="#B8F8FAFC"
                    Visibility="Collapsed"
                    Panel.ZIndex="30">

                <Border Width="330"
                        Height="170"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft"
                        Opacity="0.98"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LoaderCardScale"
                                        ScaleX="0.96"
                                        ScaleY="0.96" />
                    </Border.RenderTransform>

                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB"
                                          BlurRadius="32"
                                          ShadowDepth="0"
                                          Opacity="0.14" />
                    </Border.Effect>

                    <Grid Margin="28,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Icon / Modern Loading Mark -->
                        <Grid Grid.Row="0"
                              Width="58"
                              Height="42"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,14">

                            <Border Background="#F1F5FF"
                                    CornerRadius="14" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FlowDirection="LeftToRight">

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#2563EB"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarOneScale"
                                                        ScaleY="0.45"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#3B82F6"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarTwoScale"
                                                        ScaleY="0.75"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#60A5FA"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarThreeScale"
                                                        ScaleY="0.45"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                            </StackPanel>
                        </Grid>

                        <!-- Main Text -->
                        <TextBlock Grid.Row="1"
                                   Text="در حال بارگذاری اطلاعات"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="لطفاً چند لحظه صبر کنید..."
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   Margin="0,7,0,16"
                                   HorizontalAlignment="Center" />

                        <!-- Minimal Moving Progress -->
                        <Border Grid.Row="3"
                                Height="3"
                                Width="200"
                                CornerRadius="2"
                                Background="#E2E8F0"
                                ClipToBounds="True"
                                HorizontalAlignment="Left">

                            <Border Width="60"
                                    Height="3"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">
                                        <GradientStop Color="#93C5FD"
                                                      Offset="0" />
                                        <GradientStop Color="#2563EB"
                                                      Offset="0.5" />
                                        <GradientStop Color="#93C5FD"
                                                      Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProgressMove"
                                                        X="-80" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">

                                        <!-- Card soft breathing -->
                                        <DoubleAnimation Storyboard.TargetName="LoaderCardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.55"
                                                         AutoReverse="True" />

                                        <DoubleAnimation Storyboard.TargetName="LoaderCardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.55"
                                                         AutoReverse="True" />

                                        <!-- Equalizer animation -->
                                        <DoubleAnimation Storyboard.TargetName="BarOneScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.45"
                                                         To="1"
                                                         Duration="0:0:0.45"
                                                         AutoReverse="True" />

                                        <DoubleAnimation Storyboard.TargetName="BarTwoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.75"
                                                         To="0.35"
                                                         Duration="0:0:0.45"
                                                         BeginTime="0:0:0.12"
                                                         AutoReverse="True" />

                                        <DoubleAnimation Storyboard.TargetName="BarThreeScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.45"
                                                         To="1"
                                                         Duration="0:0:0.45"
                                                         BeginTime="0:0:0.24"
                                                         AutoReverse="True" />

                                        <!-- Progress bar movement -->
                                        <DoubleAnimation Storyboard.TargetName="ProgressMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-80"
                                                         To="200"
                                                         Duration="0:0:1.2" />

                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══ Decorative Ellipses ═══ -->
            <Ellipse Style="{StaticResource EllipseLeft}" Grid.Row="1" Grid.ColumnSpan="3" Margin="-18,0,0,0" />
            <Ellipse Style="{StaticResource EllipseRight}" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,-18,0" />
        </Grid>
    </Border>
</UserControl>
