<UserControl x:Class="Taadol.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="400"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="White">

    <Border Padding="0,0,0,0"
            Margin="0"
            Background="White"
            BorderBrush="#E9F0FF"
            BorderThickness="0,0,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        FlowDirection="LeftToRight">

                <Button Width="26"
                        Height="26"
                        Margin="0,0,2,0"
                        Cursor="Hand"
                        Click="BtnPrevPage_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Width="26"
                                    Height="26"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1.5"
                                    CornerRadius="4">
                                <svg:SvgViewbox x:Name="ToggleArrowIcon"
                                                Width="10"
                                                Height="10"
                                                Source="/Assets/Icons/ArrowLeft.svg"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                    <svg:SvgViewbox.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </svg:SvgViewbox.RenderTransform>
                                </svg:SvgViewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#F5F7FA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center">
                    <ItemsControl x:Name="PageButtonsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26"
                                    Height="26"
                                    Margin="0,0,2,0"
                                    Cursor="Hand"
                                    Click="BtnPage_Click"
                                    Tag="{Binding PageNumber}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Width="26"
                                                Height="26"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1.5"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding PageNumberDisplay}"
                                                       FontSize="12"
                                                       FontFamily="{StaticResource IRANSans}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="#94A3B8" />
                                                        <Setter Property="FontWeight"
                                                                Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#2563EB" />
                                                                <Setter Property="FontWeight"
                                                                        Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding PageNumberDisplay}"
                                                         Value="...">
                                                <Setter TargetName="bd"
                                                        Property="BorderBrush"
                                                        Value="Transparent" />
                                                <Setter TargetName="bd"
                                                        Property="Background"
                                                        Value="Transparent" />

                                                <Setter Property="Cursor"
                                                        Value="Arrow" />
                                                <Setter Property="IsHitTestVisible"
                                                        Value="False" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Background"
                                                        Value="#F5F7FA" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}"
                                                         Value="True">
                                                <Setter TargetName="bd"
                                                        Property="BorderBrush"
                                                        Value="#2563EB" />
                                                <Setter TargetName="bd"
                                                        Property="Background"
                                                        Value="White" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Width="26"
                        Height="26"
                        Margin="0,0,8 ,0"
                        Cursor="Hand"
                        Click="BtnNextPage_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Width="26"
                                    Height="26"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1.5"
                                    CornerRadius="4">
                                <svg:SvgViewbox x:Name="ToggleArrowIcon"
                                                Width="10"
                                                Height="10"
                                                Source="/Assets/Icons/ArrowLeft.svg"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                    <svg:SvgViewbox.RenderTransform>
                                        <RotateTransform Angle="180" />
                                    </svg:SvgViewbox.RenderTransform>
                                </svg:SvgViewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#F5F7FA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">

                <controls:PageSizeSelector x:Name="PageSizeSelector"
                                           SelectionChanged="PageSizeSelector_SelectionChanged" />

                <TextBlock x:Name="PageInfoText"
                           FontSize="11"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Margin="24,0,8,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
