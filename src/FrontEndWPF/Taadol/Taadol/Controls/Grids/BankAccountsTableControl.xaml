<UserControl x:Class="Taadol.Controls.BankAccountsTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <UserControl.Resources>
        <!-- دکمه‌های آیکونی ستون عملیات: هاور با یک سطح خیلی ملایم به رنگ خود آیکون -->
        <Style x:Key="BankRowIconButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Width"
                    Value="26" />
            <Setter Property="Height"
                    Value="26" />
            <Setter Property="Padding"
                    Value="4" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverSurface"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <!-- رنگ پایه با DataTrigger روی Tag تعیین می‌شود؛
                                     فقط یک سایه ملایم زیر آیکون -->
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="#EFF3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- جدول حساب‌های بانکی مشترک بین NewPersonView و EditPersonView -->
    <Border x:Name="TableContainerBorder"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,0,0,8"
            SizeChanged="TableContainerBorder_SizeChanged">
        <!-- اسکرول افقی: وقتی عرض پنجره کم است، جدول به‌جای Clip شدن اسکرول می‌شود -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <!-- اسکرول‌بار مینیمال مثل گرید UnifiedListView -->
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar"
                       BasedOn="{StaticResource MinimalScrollBar}">
                    <Style.Triggers>
                        <Trigger Property="Orientation"
                                 Value="Horizontal">
                            <!-- اسکرول‌بار افقی باید دیده شود تا کاربر بفهمد
                                 در پنجره کوچک می‌تواند به ستون‌های آخر برسد -->
                            <Setter Property="Height"
                                    Value="10" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Resources>
            <Grid x:Name="TableGrid"
                  FlowDirection="RightToLeft"
                  MinWidth="992"
                  Width="{Binding ActualWidth, ElementName=Scroller, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ هدر جدول ============ -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      Height="44">
                    <Grid.ColumnDefinitions>
                        <!-- # -->
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="1" />
                        <!-- نام بانک -->
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="1" />
                        <!-- نام شعبه -->
                        <ColumnDefinition Width="1.5*" MinWidth="190" />
                        <ColumnDefinition Width="1" />
                        <!-- شماره کارت -->
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="1" />
                        <!-- شماره شبا -->
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="1" />
                        <!-- شماره حساب -->
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="1" />
                        <!-- پیش فرض -->
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="1" />
                        <!-- عملیات -->
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <!-- عناوین -->
                    <TextBlock Grid.Column="0"
                               Text="#"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="نام بانک"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="نام شعبه"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6"
                               Text="شماره کارت"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8"
                               Text="شماره شبا"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="10"
                               Text="شماره حساب"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="12"
                               Text="پیش فرض"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="14"
                               Text="عملیات"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- خطوط عمودی جداکننده -->
                    <Border Grid.Column="1" Background="#E5E7EB" />
                    <Border Grid.Column="3" Background="#E5E7EB" />
                    <Border Grid.Column="5" Background="#E5E7EB" />
                    <Border Grid.Column="7" Background="#E5E7EB" />
                    <Border Grid.Column="9" Background="#E5E7EB" />
                    <Border Grid.Column="11" Background="#E5E7EB" />
                    <Border Grid.Column="13" Background="#E5E7EB" />

                    <!-- خط افقی زیر هدر -->
                    <Border Grid.ColumnSpan="15"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            VerticalAlignment="Bottom" />
                </Grid>

                <!-- ============ ردیف‌های داده ============ -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1">
                                <Grid Height="36">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background"
                                                    Value="White" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="#EFF6FF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <!-- # -->
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="1" />
                                        <!-- نام بانک -->
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <!-- نام شعبه -->
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1" />
                                        <!-- شماره کارت -->
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="1" />
                                        <!-- شماره شبا -->
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="1" />
                                        <!-- شماره حساب -->
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="1" />
                                        <!-- پیش فرض -->
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="1" />
                                        <!-- عملیات -->
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <!-- # -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Index}"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Background="#E5E7EB" />

                                    <!-- نام بانک -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding BankName}"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="13"
                                               Foreground="#374151"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="3" Background="#E5E7EB" />

                                    <!-- نام شعبه -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding BranchName}"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="13"
                                               Foreground="#374151"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="5" Background="#E5E7EB" />

                                    <!-- شماره کارت -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding CardNumber}"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="13"
                                               Foreground="#374151"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="7" Background="#E5E7EB" />

                                    <!-- شماره شبا -->
                                    <TextBlock Grid.Column="8"
                                               Text="{Binding Shaba}"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="13"
                                               Foreground="#374151"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="9" Background="#E5E7EB" />

                                    <!-- شماره حساب -->
                                    <TextBlock Grid.Column="10"
                                               Text="{Binding AccountNumber}"
                                               FontFamily="{StaticResource IRANSans}"
                                               FontSize="13"
                                               Foreground="#374151"
                                               FlowDirection="LeftToRight"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="11" Background="#E5E7EB" />

                                    <!-- پیش فرض (فقط خواندنی) -->
                                    <Border Grid.Column="12"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="4"
                                            BorderThickness="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Background" Value="#2667FF" />
                                                        <Setter Property="BorderBrush" Value="#2667FF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <svg:SvgViewbox Width="8"
                                                        Height="8"
                                                        Source="/Assets/Icons/CHECK_w.svg"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                            <svg:SvgViewbox.Style>
                                                <Style TargetType="svg:SvgViewbox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </svg:SvgViewbox.Style>
                                        </svg:SvgViewbox>
                                    </Border>

                                    <Border Grid.Column="13" Background="#E5E7EB" />

                                    <!-- عملیات -->
                                    <StackPanel Grid.Column="14"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Tag="{Binding}"
                                                Click="RemoveBankAccountFromTable_Click"
                                                Style="{StaticResource BankRowIconButtonStyle}"
                                                ToolTip="حذف">
                                            <svg:SvgViewbox Width="14"
                                                            Height="14"
                                                            Source="/Assets/Icons/trash.svg" />
                                        </Button>
                                        <Button Tag="{Binding}"
                                                Click="EditBankAccount_Click"
                                                Style="{StaticResource BankRowIconButtonStyle}"
                                                ToolTip="ویرایش">
                                            <svg:SvgViewbox Width="14"
                                                            Height="14"
                                                            FlowDirection="LeftToRight"
                                                            Source="/Assets/Icons/editblue.svg" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
