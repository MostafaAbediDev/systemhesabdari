<UserControl x:Class="Taadol.Controls.UnifiedListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="#FFFFFF"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="EllipseLeft" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-31,0,0,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

        <Style x:Key="EllipseRight" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-31,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

        <!-- ═══ تمپلیت مشترک چک‌باکس: هم برای ردیف‌ها هم برای سرستون ═══
             تا ظاهر هر دو یکسان باشد (بردر خاکستری → آبی + تیک سفید + هاور). -->
        <ControlTemplate x:Key="GridCheckBoxTemplate" TargetType="ToggleButton">
            <Border x:Name="CheckBoxBorder"
                    Width="20"
                    Height="20"
                    BorderThickness="1.5"
                    BorderBrush="#CBD5E1"
                    CornerRadius="4"
                    Background="#FFFFFF"
                    VerticalAlignment="Center">
                <svg:SvgViewbox x:Name="CheckMark"
                                Width="8"
                                Height="8"
                                Source="/Assets/Icons/wh_check.svg"
                                FlowDirection="LeftToRight"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2667FF" />
                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="#2667FF" />
                    <Setter TargetName="CheckBoxBorder" Property="BorderThickness" Value="0" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#CBD5E1" />
                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="#FFFFFF" />
                    <Setter TargetName="CheckBoxBorder" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2667FF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- چیدمان: [ناحیه‌ی گرید با اسکرول بیرونی] + [Footer = نوار جمع‌بندی] + [PaginationBar در پایین].
         اسکرول‌بار خارج از قاب گرید است؛ قاب همیشه دقیقاً به‌اندازه‌ی محتوا (هدر + ردیف‌ها) جمع می‌شود
         و هیچ فاصله‌ای بین آخرین ردیف و بردر پایین قاب نیست. چرخ ماوس روی گرید به اسکرول بیرونی منتقل می‌شود. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="OuterScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      VerticalContentAlignment="Top">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar"
                       BasedOn="{StaticResource MinimalScrollBar}" />
            </ScrollViewer.Resources>
            <!-- GridArea: VerticalAlignment=Top تا دقیقاً به‌اندازه‌ی محتوا جمع شود؛
                 MinHeight فقط در حالت خالی/لودینگ ۲۰۰ می‌شود تا پیام/لودر جا داشته باشد -->
            <Grid x:Name="GridArea"
                  VerticalAlignment="Top"
                  ClipToBounds="True">
            <!-- MinHeight در کد-behind مدیریت می‌شود: فقط در حالت خالی/لودینگ ۲۰۰ می‌شود
                 تا پیام/لودر جا داشته باشد؛ با داده‌ی واقعی صفر است تا گرید دقیقاً به‌اندازه‌ی محتوا جمع شود -->
            <Border x:Name="DataGridBorder"
                        Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1,1,1,1"
                        CornerRadius="4"
                        Padding="0"
                        Margin="0"
                        ClipToBounds="False"
                        SnapsToDevicePixels="True"
                        HorizontalAlignment="Stretch">
                <DataGrid x:Name="DataGridView"
                          HorizontalAlignment="Stretch"
                          CanUserSortColumns="False"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          HorizontalGridLinesBrush="Transparent"
                          RowHeight="36"
                          Background="White"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          VerticalContentAlignment="Top"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Extended"
                          AlternationCount="2"
                          IsReadOnly="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ColumnHeaderStyle="{StaticResource UnifiedGridColumnHeaderStyle}"
                          CellStyle="{StaticResource UnifiedGridCellStyle}"
                          RowStyle="{StaticResource UnifiedGridRowStyle}"
                          SelectionChanged="DataGridView_SelectionChanged"
                          MouseDoubleClick="DataGridView_MouseDoubleClick"
                          LoadingRow="DataGridView_LoadingRow">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBar}">
                            <Setter Property="Margin" Value="-14,0,0,0" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 1️⃣ چک‌باکس -->
                        <DataGridTemplateColumn Header=""
                                                Width="44"
                                                MinWidth="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <ToggleButton x:Name="SelectAllBorder"
                                                  Width="20"
                                                  Height="20"
                                                  Cursor="Hand"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Template="{StaticResource GridCheckBoxTemplate}"
                                                  PreviewMouseLeftButtonDown="SelectAllBorder_PreviewMouseLeftButtonDown" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1" />
                                    <Setter Property="BorderBrush"
                                            Value="#E5E7EB" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell"
                                       BasedOn="{StaticResource UnifiedGridCellStyle}">
                                    <!-- سلول چک‌باکس هیچ خطی نمی‌کشد؛ لبه‌ی راست گرید فقط بردر قاب را دارد
                                         و جداکننده‌ی بین چک‌باکس و # از سلول ستون # می‌آید -->
                                    <Setter Property="BorderThickness"
                                            Value="0" />
                                    <Setter Property="Padding"
                                            Value="0" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- ردیف‌های خالی (پرکننده صفحه) چک‌باکس ندارند -->
                                    <ToggleButton x:Name="RowToggle"
                                                  Cursor="Hand"
                                                  Padding="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Template="{StaticResource GridCheckBoxTemplate}"
                                                  Checked="RowToggle_Checked"
                                                  Unchecked="RowToggle_Unchecked">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmpty}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2️⃣ ردیف (#) -->
                        <DataGridTextColumn Header="#"
                                            Width="50"
                                            MinWidth="45"
                                            Binding="{Binding RowNumberDisplay}"
                                            ElementStyle="{StaticResource RowNumberColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <!-- خط راست = جداکننده با چک‌باکس؛ خط چپ حذف شد تا با خط راست هدر «کد یکتا» دوتایی نشود -->
                                    <Setter Property="BorderThickness"
                                            Value="0,0,1,1" />
                                    <Setter Property="BorderBrush"
                                            Value="#E5E7EB" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>                        </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="LoadingOverlay"
                    Background="#B8F8FAFC"
                    Visibility="Collapsed"
                    Panel.ZIndex="30">

                <Border Width="330"
                        Height="170"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft"
                        Opacity="0.98"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LoaderCardScale"
                                        ScaleX="0.96"
                                        ScaleY="0.96" />
                    </Border.RenderTransform>

                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB"
                                          BlurRadius="32"
                                          ShadowDepth="0"
                                          Opacity="0.14" />
                    </Border.Effect>

                    <Grid Margin="28,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Width="58"
                              Height="42"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,14">

                            <Border Background="#F1F5FF"
                                    CornerRadius="14" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FlowDirection="LeftToRight">

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#2563EB"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarOneScale"
                                                        ScaleY="0.45"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#3B82F6"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarTwoScale"
                                                        ScaleY="0.75"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#60A5FA"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarThreeScale"
                                                        ScaleY="0.45"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock                        Grid.Row="1"
                                   Text="در حال بارگذاری اطلاعات"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   HorizontalAlignment="Center" />

                        <TextBlock                                Grid.Row="2"
                                   Text="لطفاً چند لحظه صبر کنید..."
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   Margin="0,7,0,16"
                                   HorizontalAlignment="Center" />

                        <Border Grid.Row="3"
                                Width="210"
                                Height="6"
                                CornerRadius="6"
                                Background="#EEF4FF"
                                ClipToBounds="True"
                                HorizontalAlignment="Center">

                            <Border Width="74"
                                    Height="6"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">
                                        <GradientStop Color="#93C5FD"
                                                      Offset="0" />
                                        <GradientStop Color="#2563EB"
                                                      Offset="0.5" />
                                        <GradientStop Color="#93C5FD"
                                                      Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProgressMove"
                                                        X="-80" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoaderCardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.55"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="LoaderCardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.55"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="BarOneScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.45"
                                                         To="1"
                                                         Duration="0:0:0.45"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="BarTwoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.75"
                                                         To="0.35"
                                                         Duration="0:0:0.45"
                                                         BeginTime="0:0:0.12"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="BarThreeScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.45"
                                                         To="1"
                                                         Duration="0:0:0.45"
                                                         BeginTime="0:0:0.24"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="ProgressMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-80"
                                                         To="220"
                                                         Duration="0:0:1.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══ Error State — خطا در بارگذاری؛ تا زمانی که خطا وجود دارد Empty نشان داده نمی‌شود ═══ -->
            <Border x:Name="LoadErrorOverlay"
                    Background="#FDFDFE"
                    Visibility="Collapsed"
                    Panel.ZIndex="25">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                    <Border Width="76"
                            Height="76"
                            CornerRadius="38"
                            Background="#FFF4E5"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <svg:SvgViewbox Width="30"
                                        Height="30"
                                        Source="/Assets/Icons/danger.svg"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="LoadErrorTextBlock"
                               Text="خطا در بارگذاری اطلاعات"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#B45309"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="برای تلاش مجدد، دکمه «بروزرسانی» را بزنید"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="12.5"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══ Empty State — وقتی هیچ رکورد واقعی‌ای (غیر از ردیف‌های خالی پرکننده) وجود ندارد ═══ -->
            <Border x:Name="EmptyStateOverlay"
                    Background="#FDFDFE"
                    Visibility="Collapsed"
                    Panel.ZIndex="20">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                    <Border Width="76"
                            Height="76"
                            CornerRadius="38"
                            Background="#F1F5FF"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <svg:SvgViewbox x:Name="EmptyStateIcon"
                                        Width="30"
                                        Height="30"
                                        Source="/Assets/Icons/search.svg"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyStateTextBlock"
                               Text="{Binding EmptyStateText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateHintBlock"
                               Text="{Binding EmptyStateHintText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{StaticResource IRANSans}"
                               FontSize="12.5"
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ═══ شکاف نوار جمع‌بندی: هر فرم نوار خودش (ListSummaryBar یا نوار سفارشی) را اینجا می‌گذارد؛
             همیشه زیر گرید و خارج از ناحیه‌ی اسکرول است ═══ -->
        <ContentControl x:Name="FooterSlot"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Focusable="False" />

        <!-- ═══ صفحه‌بندی (زیر نوار جمع‌بندی، خارج از ناحیه‌ی اسکرول) ═══
             مارجین پایین: با لیست بلند که گرید تا سقف پر می‌شود، نوار هرگز زیر فوتر/لبه بریده نشود -->
        <controls:PaginationBar x:Name="PaginationBar"
                                Grid.Row="2"
                                Margin="0,0,0,8" />

        <!-- ═══ منوی راست‌کلیک ردیف (ویرایش / حذف) — کنترل مستقل ═══ -->
        <controls:RowContextMenuControl x:Name="RowContextMenu" />
    </Grid>
</UserControl>
