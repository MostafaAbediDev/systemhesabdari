<UserControl x:Class="Taadol.Controls.PageSizeSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="60"
             x:Name="Root">

    <Grid>
        <Border x:Name="RootBorder"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5"
            Cursor="Hand"
            MinWidth="70"
            HorizontalAlignment="Center"
            PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedText"
                           Grid.Column="0"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#2563EB"
                           FontFamily="{StaticResource IRANSans}"
                           VerticalAlignment="Center"
                           Text="15" />

                <svg:SvgViewbox x:Name="ArrowIcon"
                                Grid.Column="1"
                                Width="8"
                                Height="5"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/arrowDowN.svg"
                                RenderTransformOrigin="0.5,0.5">
                    <svg:SvgViewbox.RenderTransform>
                        <RotateTransform x:Name="ArrowRotate" Angle="0" />
                    </svg:SvgViewbox.RenderTransform>
                </svg:SvgViewbox>
            </Grid>
        </Border>

        <Popup x:Name="DropdownPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=RootBorder}"
               StaysOpen="True"  
            Opened="DropdownPopup_Opened"
       Closed="DropdownPopup_Closed">
            <Border x:Name="DropdownBorder"
                    Width="{Binding ActualWidth, ElementName=RootBorder}"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000" />
                </Border.Effect>
                <StackPanel x:Name="DropdownItems" />
            </Border>
        </Popup>
    </Grid>

</UserControl>
