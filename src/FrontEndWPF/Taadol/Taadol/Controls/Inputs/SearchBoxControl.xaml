<UserControl x:Class="Taadol.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             d:DesignWidth="320"
             d:DesignHeight="40">

    <Border Background="#FFFFFF"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="4"
            Height="40"
            Padding="5,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch">
        <Grid FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ClearButton"
                    Grid.Column="0"
                    Click="ClearButton_Click"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="2"
                    Margin="0,0,6,0"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    ToolTip="پاک کردن جستجو">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearBorder"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ClearBorder"
                                        Property="Background"
                                        Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <svg:SvgViewbox Width="8"
                                Height="8"
                                Source="/Assets/Icons/closeTHIN.svg"
                                FlowDirection="LeftToRight"
                                VerticalAlignment="Center" />
            </Button>

            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Height="30">
                <TextBlock x:Name="PlaceholderText"
                           Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="12"
                           Foreground="#94A3B8"
                           FlowDirection="RightToLeft"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Panel.ZIndex="1">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="SearchInput"
                         Height="30"
                         FontSize="12"
                         Foreground="#1F2937"
                         CaretBrush="#3B82F6"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,2"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         FlowDirection="RightToLeft"
                         TextAlignment="Left"
                         Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchInput_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="1"
                        Height="14"
                        Background="#BED1FF"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0" />
                <svg:SvgViewbox Width="14"
                                Height="14"
                                FlowDirection="LeftToRight"
                                Source="/Assets/Icons/search.svg"
                                VerticalAlignment="Center"
                                Margin="8,0,4,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
