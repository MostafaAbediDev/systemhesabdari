<UserControl x:Class="Taadol.Controls.PersianDatePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             FlowDirection="LeftToRight"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="400"
             HorizontalAlignment="Stretch" VerticalAlignment="Top">

    <UserControl.Resources>
        <!-- استایل تکست‌باکس‌ها -->
        <Style x:Key="DatePickerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazir}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="0">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#B0B0B0"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           IsHitTestVisible="False"
                                           FontFamily="{StaticResource IRANSans}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- دکمه‌های ناوبری ماه -->
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6EEFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D7E4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- دکمه‌های روزهای ماه -->
        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IRANSans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- روزهای هفته -->
        <Style x:Key="CalendarWeekdayStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IRANSans}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- دکمه امروز -->
        <Style x:Key="CalendarTodayButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IRANSans}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2667FF"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2667FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6EEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- باکس‌های تاریخ -->
            <RowDefinition Height="Auto"/>
            <!-- پیغام خطا -->
        </Grid.RowDefinitions>

        <!-- باکس‌های تاریخ -->
        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="110"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="70"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="70"/>
            </Grid.ColumnDefinitions>

            <!-- سال همراه با آیکون تقویم -->
            <Border Grid.Column="0"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            x:Name="CalendarIconBorder"
                            Width="28" Height="28"
                            CornerRadius="4"
                            BorderBrush="#2667FF"
                            BorderThickness="1"
                            Background="White"
                            Cursor="Hand"
                            Margin="6,0,5,0"
                            MouseLeftButtonUp="CalendarIcon_Click">
                        <Grid>
                            <svg:SvgViewbox Width="15"
                                            Height="15"
                                            Source="/Assets/Icons/calendar2.svg"
                                            VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBox Grid.Column="1"
                             x:Name="YearTextBox"
                             Tag="سال"
                             FontFamily="{StaticResource VazirFD}"
                             Style="{StaticResource DatePickerTextBoxStyle}"
                             MaxLength="4"
                             FlowDirection="LeftToRight"
                             Padding="6,0,10,0"
                             TextChanged="YearTextBox_TextChanged"
                             GotFocus="DateTextBox_GotFocus"
                             PreviewTextInput="NumberValidationTextBox"/>
                </Grid>
            </Border>

            <!-- ماه -->
            <Border Grid.Column="2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <TextBox x:Name="MonthTextBox"
                         Tag="ماه"
                         FontFamily="{StaticResource VazirFD}"
                         Style="{StaticResource DatePickerTextBoxStyle}"
                         MaxLength="2"
                         FlowDirection="LeftToRight"
                         Padding="10,0,8,0"
                         TextChanged="MonthTextBox_TextChanged"
                         GotFocus="DateTextBox_GotFocus"
                         PreviewTextInput="NumberValidationTextBox"/>
            </Border>

            <!-- روز -->
            <Border Grid.Column="4"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="White"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <TextBox x:Name="DayTextBox"
                         Tag="روز"
                         FontFamily="{StaticResource VazirFD}"
                         Style="{StaticResource DatePickerTextBoxStyle}"
                         MaxLength="2"
                         FlowDirection="LeftToRight"
                         Padding="10,0,8,0"
                         TextChanged="DayTextBox_TextChanged"
                         GotFocus="DateTextBox_GotFocus"
                         PreviewTextInput="NumberValidationTextBox"/>
            </Border>
        </Grid>

        <!-- پیغام خطا -->
        <TextBlock Grid.Row="1" 
                   x:Name="ErrorMessage"
                   Foreground="#DC3545"
                   FontSize="11"
                   FontFamily="{StaticResource IRANSans}"
                   HorizontalAlignment="Right"
                   Visibility="Collapsed"
                   Margin="0,4,0,0"
                   FlowDirection="RightToLeft"/>

        <!-- پاپ‌آپ تقویم شمسی -->
        <Popup x:Name="CalendarPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="White"
                    CornerRadius="8"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,4,0,0"
                    Width="250"
                    FlowDirection="RightToLeft">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.18"
                                      Color="#0D2159"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource CalendarNavButtonStyle}"
                                ToolTip="قبلی"
                                Click="CalendarPrevButton_Click">
                            <svg:SvgViewbox Source="/Assets/Icons/ArrowLeft.svg"
                                            Width="14" Height="14"
                                            RenderTransformOrigin="0.5,0.5">
                                <svg:SvgViewbox.RenderTransform>
                                    <ScaleTransform ScaleX="-1"/>
                                </svg:SvgViewbox.RenderTransform>
                            </svg:SvgViewbox>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   x:Name="CalendarMonthLabel"
                                   Text="مهر ۱۴۰۳"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   Background="Transparent"
                                   Cursor="Hand"
                                   ToolTip="انتخاب ماه/سال"
                                   MouseLeftButtonUp="CalendarLabel_Click"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Padding="8,4"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource CalendarNavButtonStyle}"
                                ToolTip="بعدی"
                                Click="CalendarNextButton_Click">
                            <svg:SvgViewbox Source="/Assets/Icons/ArrowLeft.svg"
                                            Width="14" Height="14"/>
                        </Button>
                    </Grid>

                    <Grid x:Name="CalendarWeekdayRow" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ش" Style="{StaticResource CalendarWeekdayStyle}"/>
                        <TextBlock Grid.Column="1" Text="ی" Style="{StaticResource CalendarWeekdayStyle}"/>
                        <TextBlock Grid.Column="2" Text="د" Style="{StaticResource CalendarWeekdayStyle}"/>
                        <TextBlock Grid.Column="3" Text="س" Style="{StaticResource CalendarWeekdayStyle}"/>
                        <TextBlock Grid.Column="4" Text="چ" Style="{StaticResource CalendarWeekdayStyle}"/>
                        <TextBlock Grid.Column="5" Text="پ" Style="{StaticResource CalendarWeekdayStyle}"/>
                        <TextBlock Grid.Column="6" Text="ج" Style="{StaticResource CalendarWeekdayStyle}"/>
                    </Grid>

                    <primitives:UniformGrid x:Name="CalendarDaysGrid" Columns="7" Margin="0,0,0,8"/>
                    <primitives:UniformGrid x:Name="CalendarMonthsGrid" Columns="3" MinHeight="192" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <primitives:UniformGrid x:Name="CalendarYearsGrid" Columns="3" MinHeight="192" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <Button x:Name="CalendarTodayButton"
                            Style="{StaticResource CalendarTodayButtonStyle}"
                            Content="امروز"
                            Click="TodayButton_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>