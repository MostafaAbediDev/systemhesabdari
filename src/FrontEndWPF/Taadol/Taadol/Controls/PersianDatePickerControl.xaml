<UserControl x:Class="Taadol.Controls.PersianDatePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Taadol.Controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             FlowDirection="LeftToRight"
             mc:Ignorable="d"
         
             d:DesignHeight="90" d:DesignWidth="400"
             HorizontalAlignment="Stretch" VerticalAlignment="Top">
    <UserControl.Resources>
        <Style x:Key="DatePickerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="IRANSans"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                             
                                Padding="0">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#B0B0B0"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           
                                           IsHitTestVisible="False"
                                           FontFamily="{StaticResource IRANSans}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1A3A6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10,0,10,0" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
          
        </Grid.RowDefinitions>

     

        <!-- Date Boxes -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- Year Box with Calendar Icon -->
            <Border Grid.Column="0"
                    BorderBrush="#CCD0D9" 
                    BorderThickness="1.3"
                    CornerRadius="4"
                    Background="White"
                    Margin="0,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Calendar Icon -->
                    <Border Grid.Column="0" 
                            Width="30" Height="30"
                            CornerRadius="4"
                            BorderBrush="#2667FF"
                            BorderThickness="1"
                            Margin="8,0,5,0">
                        <Grid>
                            <svg:SvgViewbox Width="15"
                                            Height="15"
                                            Source="/Assets/Icons/calendar2.svg"
                                            VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    
                    <!-- Year TextBox -->
                    <TextBox Grid.Column="1"
                             x:Name="YearTextBox"
                             Tag="سال"
                             Style="{StaticResource DatePickerTextBoxStyle}"
                             MaxLength="4"
                             HorizontalContentAlignment="Left"
                             FlowDirection="LeftToRight"
                             Padding="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- Month Box -->
            <Border Grid.Column="2"
                    BorderBrush="#CCD0D9" 
                    BorderThickness="1.3"
                    CornerRadius="4"
                    Background="White"
                    Margin="5,0,5,0">
                <TextBox x:Name="MonthTextBox"
                         Tag="ماه"
                         Style="{StaticResource DatePickerTextBoxStyle}"
                         MaxLength="2"
                         HorizontalContentAlignment="Left"
                         FlowDirection="LeftToRight"/>
            </Border>

            <!-- Day Box -->
            <Border Grid.Column="4"
                    BorderBrush="#CCD0D9" 
                    BorderThickness="1.3"
                    CornerRadius="4"
                    Background="White"
                    Margin="5,0,0,0">
                <TextBox x:Name="DayTextBox"
                         Tag="روز"
                         Style="{StaticResource DatePickerTextBoxStyle}"
                         MaxLength="2"
                         HorizontalContentAlignment="Left"
                         FlowDirection="LeftToRight"/>
            </Border>
        </Grid>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" 
                   x:Name="ErrorMessage"
                   Foreground="#DC3545"
                   FontSize="11"
                   FontFamily="IRANSans"
                   HorizontalAlignment="Right"
                   Visibility="Collapsed"
                   Margin="0,4,0,0"
                   FlowDirection="RightToLeft"/>
    </Grid>
</UserControl>