<UserControl x:Class="Taadol.Controls.FilePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="160"
             d:DesignWidth="160">

    <Border x:Name="FileBorder"
            Width="141"
            Height="136"
            CornerRadius="4"
            BorderThickness="0"
            Background="White"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
        <Grid>
            <Rectangle x:Name="DashedBorder"
                       RadiusX="4" RadiusY="4"
                       Stroke="#BED1FF"
                       StrokeThickness="1.5"
                       StrokeDashArray="6,3"
                       Fill="Transparent"
                       IsHitTestVisible="False" />

            <StackPanel x:Name="PlaceholderPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <svg:SvgViewbox x:Name="PlaceholderIcon"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                Source="/Assets/Icons/add_doc.svg" />
                <TextBlock x:Name="PlaceholderLabel"
                           Text="انتخاب فایل"
                           FontFamily="{StaticResource IRANSans}"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="FileCountText"
                           Text=""
                           FontFamily="{StaticResource IRANSans}"
                           FontSize="10"
                           Foreground="#2667FF"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border x:Name="ActionButton"
                    Height="28"
                    Width="28"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#2667FF"
                    Background="#FFFFFF"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,8,8"
                    Cursor="Hand"
                    MouseLeftButtonUp="ActionButton_Click"
                    MouseEnter="ActionButton_MouseEnter"
                    MouseLeave="ActionButton_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.08" />
                </Border.Effect>
                <svg:SvgViewbox x:Name="ButtonIcon"
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/add-square.svg" />
            </Border>

            <Border x:Name="ClearButton"
                    Height="28"
                    Width="28"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#FF4D4F"
                    Background="#FFFFFF"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="8,0,0,8"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    MouseLeftButtonUp="ClearButton_Click"
                    MouseEnter="ClearButton_MouseEnter"
                    MouseLeave="ClearButton_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.08" />
                </Border.Effect>
                <svg:SvgViewbox Width="12"
                                Height="12"
                                Source="/Assets/Icons/trash.svg"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
