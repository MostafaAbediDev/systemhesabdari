<UserControl x:Class="Taadol.Controls.ListSummaryBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="53"
             d:DesignWidth="800"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="White">

    <Border Background="#ffffff"
            BorderBrush="#E5E7EB"
            x:Name="RootBorder"
            BorderThickness="1"
            Height="53"
            CornerRadius="4"
            Margin="0,2,0,10"
            Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- سمت چپ: موارد انتخاب شده -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SelectedSummaryTextBlock"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#1F2937"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="14" Background="#E5E7EB"
                        Margin="8,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- سمت راست: تعداد کل -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="تعداد کل"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#1F2937"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TotalCountTextBlock"
                           FontSize="14" FontWeight="Medium"
                           Foreground="#2563EB"
                           Margin="8,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>