<UserControl x:Class="Taadol.Controls.PersonDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource IRANSans}"
             d:DesignWidth="320">

    <Border x:Name="RootBorder"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,0,8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Border Grid.Row="0"
                    Background="#FAFCFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    CornerRadius="5,5,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Close (X) -->
                    <Border Grid.Column="0"
                            Cursor="Hand"
                            Background="Transparent"
                            Padding="3"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="CloseIcon_Click">
                        <svg:SvgViewbox Width="11"
                                         Height="11"
                                         Source="/Assets/Icons/close.svg" />
                    </Border>

                    <!-- Divider 1 -->
                    <Border Grid.Column="1"
                            Width="1"
                            Height="16"
                            Background="#E5E7EB"
                            Margin="8,0"
                            VerticalAlignment="Center" />

                    <!-- Name + Active Badge -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PersonNameText"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Border x:Name="PersonTypeBadge"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="PersonTypeText"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Border x:Name="ActiveStatusBadge"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveStatusText"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Delete + Edit + Divider + Collapse -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">

                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="3"
                                MouseLeftButtonDown="DeleteIcon_Click">
                            <svg:SvgViewbox Width="12"
                                             Height="12"
                                             Source="/Assets/Icons/trash.svg" />
                        </Border>

                        <Border Cursor="Hand"
                                Background="Transparent"
                                Padding="3"
                                MouseLeftButtonDown="EditIcon_Click">
                            <svg:SvgViewbox Width="12"
                                             Height="12"
                                             Source="/Assets/Icons/editblue.svg" />
                        </Border>

                        <!-- Divider 2 -->
                        <Border Width="1"
                                Height="16"
                                Background="#E5E7EB"
                                Margin="6,0"
                                VerticalAlignment="Center" />

                        <!-- Collapse Toggle -->
                        <Border x:Name="CollapseBorder"
                                Cursor="Hand"
                                Background="Transparent"
                                Padding="3"
                                VerticalAlignment="Center"
                                MouseLeftButtonDown="CollapseBorder_MouseLeftButtonDown">
                            <svg:SvgViewbox x:Name="CollapseIcon"
                                             Width="10"
                                             Height="10"
                                             Source="/Assets/Icons/ArrowUP.svg" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Animated Content Wrapper ═══ -->
            <Border x:Name="AnimatedContentBorder"
                    Grid.Row="1"
                    ClipToBounds="True">
                <StackPanel>
                    <!-- ═══ Tabs ═══ -->
                    <Border x:Name="TabsBorder"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="TabBasicInfo"
                                    Cursor="Hand"
                                    Padding="12,6"
                                    CornerRadius="6"
                                    Background="#2563EB"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1"
                                    Margin="0,0,4,0"
                                    MouseLeftButtonDown="TabBasicInfo_Click">
                                <TextBlock x:Name="TabBasicInfoText"
                                           Text="اطلاعات پایه"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="White" />
                            </Border>

                            <Border x:Name="TabBankAccounts"
                                    Cursor="Hand"
                                    Padding="12,6"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Margin="0,0,4,0"
                                    MouseLeftButtonDown="TabBankAccounts_Click">
                                <TextBlock x:Name="TabBankAccountsText"
                                           Text="حساب‌های بانکی"
                                           FontSize="11"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Border x:Name="TabHistory"
                                    Cursor="Hand"
                                    Padding="12,6"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    MouseLeftButtonDown="TabHistory_Click">
                                <TextBlock x:Name="TabHistoryText"
                                           Text="تاریخچه"
                                           FontSize="11"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Content ═══ -->
                    <ScrollViewer x:Name="ContentScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,10">
                        <StackPanel x:Name="ContentPanel">
                            <StackPanel x:Name="BasicInfoPanel"
                                        Visibility="Visible">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="دسته‌بندی" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CategoryText" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="شناسه / کد ملی" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NationalIdText" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="تلفن / موبایل" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PhoneText" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ایمیل" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EmailText" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#1F2937" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="استان / شهر" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CityText" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="آدرس / کدپستی" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AddressText" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#1F2937" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Border Background="#F9FAFB" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="مانده حساب" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BalanceText" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" />
                                        <Border x:Name="BalanceStatusBadge" Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="BalanceStatusText" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="BankAccountsPanel" Visibility="Collapsed">
                                <TextBlock Text="حساب‌های بانکی" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,20,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                                <TextBlock Text="تاریخچه" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,20,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
