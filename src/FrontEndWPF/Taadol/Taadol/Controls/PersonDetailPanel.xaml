<UserControl x:Class="Taadol.Controls.PersonDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource IRANSans}"
             d:DesignWidth="320">

    <UserControl.Resources>
        <!-- استایل اسکرول از Styles.xaml استفاده می‌شود -->
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,0,5,8"
            Padding="0,8,0,8"
            PreviewMouseWheel="RootBorder_PreviewMouseWheel">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Border Grid.Row="0"
                    Background="#FAFCFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    CornerRadius="5,5,0,0"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Close (X) -->
                    <Border Grid.Column="0"
                            Cursor="Hand"
                            Background="Transparent"
                            Padding="3"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="CloseIcon_Click">
                        <svg:SvgViewbox Width="11" Height="11"
                                        Source="/Assets/Icons/closeTHIN.svg" />
                    </Border>

                    <!-- Divider -->
                    <Border Grid.Column="1" Width="1" Height="16"
                            Background="#E5E7EB" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Name + Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PersonNameText"
                                   FontSize="13" FontWeight="Bold" Foreground="#0D2159"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="ActiveStatusBadge"
                                CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveStatusText" FontSize="10"
                                       FontWeight="Medium" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Edit + Delete + Divider + Collapse -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Cursor="Hand" Background="Transparent" Padding="3"
                                Margin="2,0,0,0" MouseLeftButtonDown="DeleteIcon_Click">
                            <svg:SvgViewbox Width="13" Height="13"
                                             Source="/Assets/Icons/trash.svg" />
                        </Border>
                        <Border Cursor="Hand" Background="Transparent" Padding="3"
                                MouseLeftButtonDown="EditIcon_Click">
                            <svg:SvgViewbox Width="13" Height="13"
                                            FlowDirection="LeftToRight"
                                             Source="/Assets/Icons/editblue.svg" />
                        </Border>
                        <Border Width="1" Height="16" Background="#E5E7EB"
                                Margin="6,0" VerticalAlignment="Center" />
                        <Border x:Name="CollapseBorder"
                                Cursor="Hand"
                                Background="Transparent"
                                Padding="3"
                                VerticalAlignment="Center"
                                MouseLeftButtonDown="CollapseBorder_MouseLeftButtonDown">
                            <svg:SvgViewbox x:Name="CollapseIcon"
                                            Width="10"
                                            Height="10"
                                            Source="/Assets/Icons/ArrowUP.svg"
                                            RenderTransformOrigin="0.5,0.5">
                                <svg:SvgViewbox.RenderTransform>
                                    <RotateTransform x:Name="CollapseIconRotate"
                                                     Angle="0" />
                                </svg:SvgViewbox.RenderTransform>
                            </svg:SvgViewbox>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Animated Content ═══ -->
            <Border x:Name="AnimatedContentBorder" Grid.Row="1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ═══ Tabs (Underline Style) ═══ -->
                    <Border x:Name="TabsBorder"
                            Grid.Row="0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0"
                                         Content="اطلاعات پایه"
                                         Style="{StaticResource ModernTabButton}"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Height="32" Width="Auto"
                                         Padding="0,4"
                                         FontSize="10"
                                         Margin="0"
                                         IsChecked="True"
                                         GroupName="PersonTabs"
                                         x:Name="TabBasicInfo"
                                         Checked="TabBasicInfo_Checked" />

                            <RadioButton Grid.Column="1"
                                         Content="حساب های بانکی"
                                         Style="{StaticResource ModernTabButton}"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Height="32" Width="Auto"
                                         Padding="0,4"
                                         FontSize="10"
                                         Margin="0"
                                         GroupName="PersonTabs"
                                         x:Name="TabBankAccounts"
                                         Checked="TabBankAccounts_Checked" />

                            <RadioButton Grid.Column="2"
                                         Content="تاریخچه"
                                         Style="{StaticResource ModernTabButton}"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Height="32" Width="Auto"
                                         Padding="0,4"
                                         FontSize="10"
                                         Margin="0"
                                         GroupName="PersonTabs"
                                         x:Name="TabHistory"
                                         Checked="TabHistory_Checked" />
                        </Grid>
                    </Border>

                    <!-- ═══ Content ═══ -->
                    <ScrollViewer x:Name="ContentScroll" Grid.Row="1"
                                  Style="{StaticResource MinimalScrollViewer}"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0">
                        <StackPanel x:Name="ContentPanel" Margin="14,12,14,12">
                            <StackPanel x:Name="BasicInfoPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: دسته‌بندی -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="دسته‌بندی"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <Border Grid.Row="0" Grid.Column="1" Width="2" Height="16"
                                            Background="#BED1FF" Margin="0,0,10,12"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="CategoryText" Grid.Row="0" Grid.Column="2"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#0D2159" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />

                                    <!-- Row 1: شناسه / کد ملی -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="شناسه / کد ملی"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <Border Grid.Row="1" Grid.Column="1" Width="2" Height="16"
                                            Background="#BED1FF" Margin="0,0,10,12"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="NationalIdText" Grid.Row="1" Grid.Column="2"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#0D2159" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />

                                    <!-- Row 2: تلفن / موبایل -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="تلفن / موبایل"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <Border Grid.Row="2" Grid.Column="1" Width="2" Height="16"
                                            Background="#BED1FF" Margin="0,0,10,12"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="PhoneText" Grid.Row="2" Grid.Column="2"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#0D2159" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />

                                    <!-- Row 3: ایمیل -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="ایمیل"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <Border Grid.Row="3" Grid.Column="1" Width="2" Height="16"
                                            Background="#BED1FF" Margin="0,0,10,12"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="EmailText" Grid.Row="3" Grid.Column="2"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#0D2159" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <!-- Row 4: استان / شهر -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="استان / شهر"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />
                                    <Border Grid.Row="4" Grid.Column="1" Width="2" Height="16"
                                            Background="#BED1FF" Margin="0,0,10,12"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="CityText" Grid.Row="4" Grid.Column="2"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#0D2159" VerticalAlignment="Center"
                                               Margin="0,0,0,12" />

                                    <!-- Row 5: آدرس / کدپستی -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="آدرس / کدپستی"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1F2937" VerticalAlignment="Center"
                                               Margin="0,0,0,0" />
                                    <Border Grid.Row="5" Grid.Column="1" Width="2" Height="16"
                                            Background="#BED1FF" Margin="0,0,10,0"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="AddressText" Grid.Row="5" Grid.Column="2"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="#0D2159" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="BankAccountsPanel" Visibility="Collapsed">
                                <TextBlock Text="حساب‌های بانکی" FontSize="13"
                                           Foreground="#6B7280" HorizontalAlignment="Center"
                                           Margin="0,20,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                                <TextBlock Text="تاریخچه" FontSize="13"
                                           Foreground="#6B7280" HorizontalAlignment="Center"
                                           Margin="0,20,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- ═══ مانده حساب (always visible) ═══ -->
            <Border x:Name="BalanceSectionBorder" Grid.Row="2"
                    BorderBrush="#E5E7EB" BorderThickness="0,1,0,1"
                    Padding="0,14,0,14" Margin="0,12,0,0">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="مانده حساب"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#1F2937" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="2" Height="16"
                            Background="#BED1FF" Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="BalanceStatusText" Grid.Column="2"
                               FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Grid.Column="3" Width="2" Height="16"
                            Background="#BED1FF" Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="BalanceText" Grid.Column="4"
                               FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
