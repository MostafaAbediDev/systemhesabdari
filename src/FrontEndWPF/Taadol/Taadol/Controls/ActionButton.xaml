<UserControl x:Class="Taadol.Controls.ActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="84"
             x:Name="Root"
             Cursor="Hand">

    <Border x:Name="BtnBorder"
            Background="White"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,0"
            Height="40"
            VerticalAlignment="Center"
            MouseLeftButtonDown="BtnBorder_MouseLeftButtonDown"
            MouseEnter="BtnBorder_MouseEnter"
            MouseLeave="BtnBorder_MouseLeave">

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock x:Name="BtnText"
                       FontSize="12"
                       FontFamily="{StaticResource IRANSans}"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <svg:SvgViewbox x:Name="BtnIcon"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
