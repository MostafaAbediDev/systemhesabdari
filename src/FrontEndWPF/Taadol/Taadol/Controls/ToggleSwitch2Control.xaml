<UserControl x:Class="Taadol.Controls.ToggleSwitch2Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             FontFamily="{StaticResource IRANSans}"
             mc:Ignorable="d"
             d:DesignWidth="140"
             d:DesignHeight="30">

    <Border x:Name="RootBorder"
            Background="White"
            CornerRadius="6"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            HorizontalAlignment="Left">

        <Grid x:Name="ToggleRoot"
              Width="140"
              Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SliderBg"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    CornerRadius="0"
                    Margin="-4,0,-4,0"
                    Panel.ZIndex="0"
                    Background="#2667FF"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SliderTransform"
                                        X="0" />
                </Border.RenderTransform>
            </Border>

            <ToggleButton x:Name="BtnSecond"
                          Grid.Column="0"
                          Panel.ZIndex="1"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Checked="BtnSecond_Checked"
                          Unchecked="BtnSecond_Unchecked"
                          Cursor="Hand">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"
                                            CornerRadius="4">
                                        <TextBlock x:Name="SecondText"
                                                   Text="دستی"
                                                   FontSize="11"
                                                   FontWeight="DemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#374151" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <ToggleButton x:Name="BtnFirst"
                          Grid.Column="1"
                          IsChecked="True"
                          Panel.ZIndex="1"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Checked="BtnFirst_Checked"
                          Unchecked="BtnFirst_Unchecked"
                          Cursor="Hand">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"
                                            CornerRadius="4">
                                        <TextBlock x:Name="FirstText"
                                                   Text="خودکار"
                                                   FontSize="11"
                                                   FontWeight="DemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
