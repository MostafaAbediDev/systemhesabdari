<UserControl x:Class="Taadol.Controls.UnifiedListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:Taadol.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource IRANSans}"
             Background="#FFFFFF">

    <UserControl.Resources>
        <Style x:Key="EllipseLeft" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-31,0,0,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>

        <Style x:Key="EllipseRight" TargetType="Ellipse">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Fill" Value="#FFF8ED" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-31,0" />
            <Setter Property="Panel.ZIndex" Value="-1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ DataGrid + Loading ═══ -->
        <Grid Grid.Row="0"
              ClipToBounds="True">
            <Border x:Name="DataGridBorder"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1,1,1,1.5"
                    CornerRadius="4"
                    Padding="0"
                    Margin="0"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <DataGrid x:Name="DataGridView"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          CanUserSortColumns="False"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          VerticalGridLinesBrush="#E5E7EB"
                          HorizontalGridLinesBrush="Transparent"
                          RowHeight="36"
                          Background="White"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Extended"
                          AlternationCount="2"
                          IsReadOnly="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ColumnHeaderStyle="{StaticResource UnifiedGridColumnHeaderStyle}"
                          CellStyle="{StaticResource UnifiedGridCellStyle}"
                          RowStyle="{StaticResource UnifiedGridRowStyle}"
                          SelectionChanged="DataGridView_SelectionChanged"
                          MouseDoubleClick="DataGridView_MouseDoubleClick">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource MinimalScrollBar}">
                            <Style.Triggers>
                                <Trigger Property="Orientation"
                                         Value="Horizontal">
                                    <Setter Property="Height"
                                            Value="8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 1️⃣ چک‌باکس -->
                        <DataGridTemplateColumn Header=""
                                                Width="55"
                                                MinWidth="50">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Border x:Name="SelectAllBorder"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            BorderThickness="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            PreviewMouseLeftButtonDown="SelectAllBorder_PreviewMouseLeftButtonDown">
                                        <svg:SvgViewbox x:Name="SelectAllCheckMark"
                                                        Width="8"
                                                        Height="8"
                                                        Source="/Assets/Icons/CHECK_w.svg"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,2" />
                                    <Setter Property="BorderBrush"
                                            Value="#E0E7FF" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="CheckBoxBorder"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="4"
                                            Cursor="Hand"
                                            BorderThickness="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            PreviewMouseLeftButtonUp="CheckBoxBorder_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2667FF" />
                                                        <Setter Property="BorderBrush" Value="#2667FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <svg:SvgViewbox x:Name="CheckMark"
                                                        Width="8"
                                                        Height="8"
                                                        Source="/Assets/Icons/CHECK_w.svg"
                                                        FlowDirection="LeftToRight"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                            <svg:SvgViewbox.Style>
                                                <Style TargetType="svg:SvgViewbox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </svg:SvgViewbox.Style>
                                        </svg:SvgViewbox>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2️⃣ ردیف (#) -->
                        <DataGridTextColumn Header="#"
                                            Width="50"
                                            MinWidth="45"
                                            Binding="{Binding RowNumberDisplay}"
                                            ElementStyle="{StaticResource RowNumberColumnStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource UnifiedGridColumnHeaderStyle}">
                                    <Setter Property="BorderThickness"
                                            Value="1,0,1,2" />
                                    <Setter Property="BorderBrush"
                                            Value="#E0E7FF" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="LoadingOverlay"
                    Background="#B8F8FAFC"
                    Visibility="Collapsed"
                    Panel.ZIndex="30">

                <Border Width="330"
                        Height="170"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft"
                        Opacity="0.98"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LoaderCardScale"
                                        ScaleX="0.96"
                                        ScaleY="0.96" />
                    </Border.RenderTransform>

                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB"
                                          BlurRadius="32"
                                          ShadowDepth="0"
                                          Opacity="0.14" />
                    </Border.Effect>

                    <Grid Margin="28,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Width="58"
                              Height="42"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,14">

                            <Border Background="#F1F5FF"
                                    CornerRadius="14" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FlowDirection="LeftToRight">

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#2563EB"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarOneScale"
                                                        ScaleY="0.45"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#3B82F6"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarTwoScale"
                                                        ScaleY="0.75"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border Width="7"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#60A5FA"
                                        Margin="3,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BarThreeScale"
                                                        ScaleY="0.45"
                                                        CenterY="10" />
                                    </Border.RenderTransform>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Text="در حال بارگذاری اطلاعات"
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#001242"
                                   HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="لطفاً چند لحظه صبر کنید..."
                                   FontFamily="{StaticResource IRANSans}"
                                   FontSize="12.5"
                                   Foreground="#64748B"
                                   Margin="0,7,0,16"
                                   HorizontalAlignment="Center" />

                        <Border Grid.Row="3"
                                Width="210"
                                Height="6"
                                CornerRadius="6"
                                Background="#EEF4FF"
                                ClipToBounds="True"
                                HorizontalAlignment="Center">

                            <Border Width="74"
                                    Height="6"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">
                                        <GradientStop Color="#93C5FD"
                                                      Offset="0" />
                                        <GradientStop Color="#2563EB"
                                                      Offset="0.5" />
                                        <GradientStop Color="#93C5FD"
                                                      Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProgressMove"
                                                        X="-80" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoaderCardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.55"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="LoaderCardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.96"
                                                         To="1"
                                                         Duration="0:0:0.55"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="BarOneScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.45"
                                                         To="1"
                                                         Duration="0:0:0.45"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="BarTwoScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.75"
                                                         To="0.35"
                                                         Duration="0:0:0.45"
                                                         BeginTime="0:0:0.12"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="BarThreeScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="0.45"
                                                         To="1"
                                                         Duration="0:0:0.45"
                                                         BeginTime="0:0:0.24"
                                                         AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="ProgressMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-80"
                                                         To="220"
                                                         Duration="0:0:1.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ═══ صفحه‌بندی ═══ -->
        <controls:PaginationBar x:Name="PaginationBar"
                                Grid.Row="1" />
    </Grid>
</UserControl>
