<UserControl x:Class="Taadol.Controls.ImagePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="210">

    <Border x:Name="ImageBorder"
            Width="141"
            Height="136"
            CornerRadius="4"
            BorderThickness="0"
            Background="White"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

        <Grid>
            <Rectangle x:Name="DashedBorder"
                       RadiusX="4" RadiusY="4"
                       Stroke="#BED1FF"
                       StrokeThickness="1.5"
                       StrokeDashArray="6,3"
                       Fill="Transparent"
                       IsHitTestVisible="False" />

            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   HorizontalAlignment="Stretch"
                   ClipToBounds="True"
                   VerticalAlignment="Stretch" />

            <StackPanel x:Name="PlaceholderPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <svg:SvgViewbox x:Name="PlaceholderIcon"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center" />
              
            </StackPanel>

            <Border x:Name="ActionButton"
                    Height="28"
                    Width="28"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#2667FF"
                    Background="#FFFFFF"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,8,8"
                    Cursor="Hand"
                    MouseLeftButtonUp="ActionButton_Click"
                    MouseEnter="ActionButton_MouseEnter"
                    MouseLeave="ActionButton_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.08" />
                </Border.Effect>
                <svg:SvgViewbox x:Name="ButtonIcon"
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>

</UserControl>
